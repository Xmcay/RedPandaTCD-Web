@using RedPandaTCD_Web.Game

<div class="card-viewer-overlay"
     @onclick="Close">

    <div class="card-viewer-panel"
         @onclick:stopPropagation="true">

        <h3>
            @Title
        </h3>

        <div class="card-viewer-cards">
            @for (int i = 0; i < Cards.Count; i++)
            {
                <HandCard
                    Slot="@CreateDisplaySlot(Cards[i], i + 1)"
                    IsClickable="false"
                    IsDisplayOnly="true" />
            }
        </div>

        <button @onclick="Close">
            Close
        </button>

    </div>

</div>

<style>
    .card-viewer-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;

        display: flex;
        align-items: center;
        justify-content: center;

        background: rgba(0, 0, 0, 0.55);
    }

    .card-viewer-panel {
        width: min(760px, calc(100vw - 40px));
        padding: 24px;

        display: flex;
        flex-direction: column;
        gap: 16px;

        border: 2px solid #9b9383;
        border-radius: 10px;

        background: #18212b;
        color: #f5f5f5;

        text-align: center;
    }

    .card-viewer-panel h3 {
        margin: 0;
        color: #f4efe3;
    }

    .card-viewer-cards {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 14px;

        max-height: 520px;
        overflow-y: auto;

        padding: 4px;
    }

    .card-viewer-panel button {
        padding: 10px 14px;

        border: 1px solid #9b9383;
        border-radius: 6px;

        background: #f4efe3;
        color: #222;

        cursor: pointer;
        font-weight: bold;
    }
</style>

@code {
    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public List<Card> Cards { get; set; } = new();

    [Parameter]
    public EventCallback OnClose { get; set; }


    private HandSlot CreateDisplaySlot(
        Card card,
        int slotNumber)
    {
        HandSlot slot = new HandSlot(slotNumber);

        slot.CardInSlot = card;

        return slot;
    }


    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}