@using RedPandaTCD_Web.Game

<div class="character-wrap">
    @if (Character != null && RuntimeBadges.Count > 0)
    {
        <div class="character-badge-rail" aria-label="Active character effects">
            @foreach (BattleStatus status in RuntimeBadges)
            {
                <span class="character-badge @BattleStatusManager.GetToneCssClass(status)"
                      title="@status.Detail">
                    @GetBadgeLabel(status)
                </span>
            }
        </div>
    }

    @if (Character == null)
    {
        <div class="character-shell placeholder @(IsClickable ? "clickable" : "") @PlacementHighlightClass"
             @onclick="HandleClick">
            <div class="empty-character-body">
                <span class="placeholder-title">CHARACTER</span>
                <span class="placeholder-subtitle">Empty Slot</span>
            </div>
        </div>
    }
    else
    {
        <div class="character-shell occupied @(IsClickable ? "clickable" : "") @(HighlightAttackAction ? "attack-action-ready" : "") @PlacementHighlightClass"
             @onclick="HandleClick">
            <article class="character-card">
                <div class="ability-rail" aria-hidden="true">
                    <span class="ability-rail-entry"></span>
                    <span class="ability-rail-passive"></span>
                    <span class="ability-rail-active"
                          style="@GetActiveRailStyle(Character)"></span>
                </div>

                <header class="character-header">
                    <strong class="character-name">@Character.Name</strong>
                    <span class="character-type @GetArchetypeClass(Character)">
                        @Character.Archetype
                    </span>
                </header>

                <div class="character-art" aria-label="Character artwork area">
                    <span class="character-art-mark" aria-hidden="true">
                        @GetCharacterMark(Character)
                    </span>
                </div>

                <footer class="character-resources">
                    <div class="resource-orb hp-orb" title="Current HP">
                        <span class="resource-orb-icon" aria-hidden="true">♥</span>
                        <strong>@Owner.CurrentCharacterHp</strong>
                    </div>

                    <div class="resource-orb shield-orb" title="Current Shield">
                        <span class="resource-orb-icon shield-icon" aria-hidden="true">⬢</span>
                        <strong>@Owner.Shield</strong>
                    </div>
                </footer>
            </article>

            <aside class="character-hover-panel"
                   aria-label="Character ability information">
                <div class="hover-panel-heading">
                    <strong>@Character.Name</strong>
                    <span>@Character.Archetype Character</span>
                </div>

                <section class="hover-ability entry-info">
                    <strong>ENTRY · @GetEntryName(Character)</strong>
                    <span>@GetEntryDescription(Character)</span>
                </section>

                <div class="hover-divider"></div>

                <section class="hover-ability passive-info">
                    <strong>PASSIVE · @GetPassiveName(Character)</strong>
                    <span>@GetPassiveDescription(Character)</span>
                </section>

                <div class="hover-divider"></div>

                <section class="hover-ability active-info @(IsActiveUnavailable() ? "active-info-disabled" : "")">
                    <strong>ACTIVE · @GetActiveName(Character)</strong>
                    <span>@GetActiveDescription(Character)</span>

                    <div class="active-details">
                        <span>Cost: @GetActiveCost(Character) Energy</span>
                        <span>Cooldown: @Character.AbilityCooldown</span>
                        <span class="active-status">Status: @GetCooldownStateText(Character)</span>
                    </div>
                </section>
            </aside>
        </div>
    }
</div>

<style>
    .character-wrap {
        position: relative;
        width: clamp(190px, 12.2vw, 216px);
        min-height: clamp(238px, 15.3vw, 266px);

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;
        overflow: visible;
        transform: translateY(12px);
    }

    /* ---------- LIVE BADGES ---------- */

    .character-badge-rail {
        position: absolute;
        left: 50%;
        bottom: calc(100% - 4px);
        z-index: 45;

        width: max-content;
        max-width: 210px;

        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 5px;

        transform: translateX(-50%);
        pointer-events: none;
    }

    .character-badge {
        min-height: 21px;
        padding: 5px 8px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border: 1px solid currentColor;
        border-radius: 999px;

        background: #17151d;
        color: #ded9e7;

        box-shadow: 0 5px 12px rgba(0, 0, 0, 0.42);

        font-size: 7px;
        font-weight: 900;
        line-height: 1;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .character-badge.status-positive {
        color: #99dda7;
        background: #15241a;
    }

    .character-badge.status-attack {
        color: #8bddfb;
        background: #102431;
    }

    .character-badge.status-utility {
        color: #9fc6ff;
        background: #152238;
    }

    .character-badge.status-warning {
        color: #ffb279;
        background: #2b1b12;
    }

    .character-badge.status-danger {
        color: #ff9292;
        background: #2d1619;
    }

    .character-badge.status-neutral {
        color: #cbc5d2;
        background: #201d24;
    }

    .character-badge.status-interactable {
        color: #ffe39a;
        background: #292311;
    }

    /* ---------- CARD ---------- */

    .character-shell {
        position: relative;
        width: clamp(176px, 11.3vw, 202px);
        height: clamp(220px, 14.1vw, 248px);

        flex-shrink: 0;
        overflow: visible;

        border: 3px solid #6d6354;
        border-radius: 12px;

        background: #f5efdf;
        color: #24211d;

        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.31);

        transition:
            border-color 0.14s ease,
            box-shadow 0.14s ease,
            filter 0.14s ease;
    }

    .character-shell.occupied.clickable {
        cursor: pointer;
    }

    .character-shell.occupied.clickable:hover {
        filter: brightness(1.02);
    }

    .character-card {
        position: absolute;
        inset: 0;
        z-index: 2;

        padding: 7px 12px 9px 10px;

        display: flex;
        flex-direction: column;
        gap: 7px;

        overflow: hidden;
        border-radius: 9px;

        background:
            linear-gradient(
                155deg,
                #fffaf0 0%,
                #eee4cf 100%
            );
    }

    /* ---------- CHARACTER-ONLY ABILITY RAIL ---------- */

    .ability-rail {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        z-index: 3;

        width: 7px;

        display: grid;
        grid-template-rows: 1fr 1fr 1fr;

        overflow: hidden;
        border-radius: 0 8px 8px 0;
    }

    .ability-rail-entry {
        background: #e4a82f;
    }

    .ability-rail-passive {
        background: #8c58c7;
    }

    .ability-rail-active {
        background: #35c759;
    }

    /* ---------- HEADER ---------- */

    .character-header {
        min-width: 0;

        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;

        text-align: center;
    }

    .character-name {
        width: 100%;

        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;

        font-size: clamp(14px, 0.95vw, 17px);
        line-height: 1.2;
        text-align: center;
    }

    .character-type {
        padding: 4px 9px;

        border-radius: 999px;

        color: #ffffff;

        font-size: 7px;
        font-weight: 900;
        line-height: 1;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .character-type.magic {
        background: #3475d2;
    }

    .character-type.physical {
        background: #b94747;
    }

    .character-type.neutral {
        background: #6c747c;
    }

    /* ---------- ARTWORK ---------- */

    .character-art {
        min-height: 0;
        flex: 1;
        margin-bottom: 3px;

        display: grid;
        place-items: center;

        overflow: hidden;
        border: 1px solid rgba(81, 70, 52, 0.18);
        border-radius: 8px 8px 3px 3px;

        background:
            radial-gradient(
                circle at 50% 48%,
                rgba(214, 182, 93, 0.22),
                transparent 58%
            ),
            repeating-linear-gradient(
                135deg,
                rgba(70, 58, 42, 0.045) 0,
                rgba(70, 58, 42, 0.045) 1px,
                transparent 1px,
                transparent 7px
            ),
            rgba(82, 67, 45, 0.055);
    }

    .character-art-mark {
        color: rgba(136, 103, 38, 0.48);

        font-size: 42px;
        font-weight: 900;
        line-height: 1;
    }

    /* ---------- LARGE BOTTOM VALUES ---------- */

    .character-resources {
        position: relative;
        z-index: 5;

        height: 0;
        margin: 0;

        pointer-events: none;
    }

    .resource-orb {
        position: absolute;
        bottom: -7px;

        width: 49px;
        height: 49px;

        display: grid;
        place-items: center;

        overflow: hidden;
        border: 3px solid #5e5549;
        border-radius: 50% 50% 10px 10px;

        box-shadow:
            inset 0 2px 0 rgba(255, 255, 255, 0.75),
            0 4px 8px rgba(0, 0, 0, 0.32);
    }

    .hp-orb {
        left: -3px;

        background:
            linear-gradient(
                180deg,
                #f7dade 0%,
                #c93d4b 100%
            );
    }

    .shield-orb {
        right: -3px;

        background:
            linear-gradient(
                180deg,
                #dbeafa 0%,
                #3d7db4 100%
            );
    }

    .resource-orb-icon {
        position: absolute;
        top: 4px;
        left: 50%;

        color: rgba(255, 255, 255, 0.88);

        font-size: 10px;
        line-height: 1;

        transform: translateX(-50%);
    }

    .resource-orb strong {
        position: relative;
        z-index: 2;

        margin-top: 8px;

        color: #ffffff;

        font-size: 23px;
        font-weight: 950;
        line-height: 1;

        text-shadow:
            0 1px 0 rgba(0, 0, 0, 0.48),
            0 2px 4px rgba(0, 0, 0, 0.32);
    }

    /* ---------- CHARACTER INFORMATION WINDOW ---------- */

    .character-hover-panel {
        position: absolute !important;
        top: 50% !important;
        left: calc(100% + 12px) !important;
        z-index: 100 !important;

        width: 310px !important;
        height: auto !important;
        max-height: 280px;
        padding: 12px 14px !important;

        display: flex !important;
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 7px !important;

        overflow-x: hidden !important;
        overflow-y: auto !important;

        border: 2px solid #766b5b !important;
        border-radius: 10px !important;

        background:
            linear-gradient(
                155deg,
                #fffaf0 0%,
                #eee4cf 100%
            ) !important;

        color: #25211d !important;

        box-shadow:
            0 15px 34px rgba(0, 0, 0, 0.48) !important;

        opacity: 0;
        visibility: hidden;

        transform:
            translateY(-50%)
            translateX(-5px);

        pointer-events: none;

        transition:
            opacity 0.14s ease,
            transform 0.14s ease,
            visibility 0.14s ease;
    }

    .character-shell.occupied:hover > .character-hover-panel,
    .character-shell.occupied:focus-within > .character-hover-panel {
        opacity: 1;
        visibility: visible;

        transform:
            translateY(-50%)
            translateX(0);
    }

    .character-hover-panel .hover-panel-heading {
        width: 100%;

        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        gap: 1px !important;

        text-align: center;
    }

    .character-hover-panel .hover-panel-heading strong {
        display: block;

        color: #25211d !important;

        font-size: 16px;
        font-weight: 900;
        line-height: 1.1;
    }

    .character-hover-panel .hover-panel-heading span {
        display: block;

        color: #746c62 !important;

        font-size: 9px;
        font-weight: 850;
        line-height: 1.1;
        letter-spacing: 0.45px;
        text-transform: uppercase;
    }

    .character-hover-panel .hover-ability {
        width: 100%;

        display: flex !important;
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 4px !important;

        text-align: left;
    }

    .character-hover-panel .hover-ability strong {
        display: block;
        width: 100%;

        font-size: 13px;
        font-weight: 900;
        line-height: 1.1;
        letter-spacing: 0.3px;
    }

    .character-hover-panel .hover-ability > span {
        display: block;
        width: 100%;

        color: #5f5951 !important;

        font-size: 12px;
        font-weight: 650;
        line-height: 1.32;
        white-space: normal !important;
    }

    .character-hover-panel .entry-info strong {
        color: #a96f0a !important;
    }

    .character-hover-panel .passive-info strong {
        color: #7440a7 !important;
    }

    .character-hover-panel .active-info strong {
        color: #187b43 !important;
    }

    .character-hover-panel .hover-divider {
        display: block;

        width: 100%;
        min-height: 1px;
        height: 1px;
        margin: 1px 0;

        background: rgba(72, 63, 50, 0.18) !important;
    }

    .character-hover-panel .active-details {
        width: 100%;
        margin-top: 1px;

        display: flex !important;
        flex-direction: row !important;
        flex-wrap: wrap !important;
        align-items: center !important;
        gap: 4px !important;
    }

    .character-hover-panel .active-details span {
        width: auto !important;
        padding: 3px 5px;

        border-radius: 5px;

        background: rgba(75, 63, 47, 0.09) !important;
        color: #514b44 !important;

        font-size: 9px;
        font-weight: 850;
        line-height: 1.1;
        white-space: nowrap !important;
    }

    .character-hover-panel .active-details .active-status {
        color: #71329a !important;
    }

    .character-hover-panel .active-info-disabled {
        opacity: 0.63;
    }

    /* ---------- EMPTY SLOT ---------- */

    .character-shell.placeholder {
        display: grid;
        place-items: center;

        border-style: dashed;
        border-color: rgba(255, 255, 255, 0.28);

        background: rgba(255, 255, 255, 0.035);
        color: rgba(255, 255, 255, 0.48);

        box-shadow: none;
    }

    .character-shell.placeholder.clickable {
        cursor: pointer;
    }

    .empty-character-body {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;

        text-align: center;
    }

    .placeholder-title {
        font-size: 13px;
        font-weight: 900;
    }

    .placeholder-subtitle {
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 0.65px;
        text-transform: uppercase;
    }

    @@media (max-height: 820px) and (min-width: 901px) {
        .character-wrap {
            min-height: 226px;
            transform: translateY(9px);
        }

        .character-shell {
            height: 210px;
        }

        .character-card {
            gap: 5px;
            padding: 6px 11px 8px 9px;
        }

        .character-art-mark {
            font-size: 36px;
        }

        .resource-orb {
            width: 44px;
            height: 44px;
        }

        .resource-orb strong {
            font-size: 20px;
        }
    }
</style>

@code {
    [Parameter]
    public Player Owner { get; set; } = default!;

    [Parameter]
    public bool IsClickable { get; set; }

    [Parameter]
    public bool HighlightAttackAction { get; set; }

    [Parameter]
    public string PlacementHighlightClass { get; set; } = "";

    [Parameter]
    public EventCallback OnCardClicked { get; set; }

    private Card? Character =>
        Owner.ActiveCharacter;

    private IReadOnlyList<BattleStatus> RuntimeBadges =>
        BattleStatusManager
            .GetCharacterStatuses(Owner)
            .Where(status =>
                status.Key is not
                    "ability-ready" and not
                    "free-character-replacement")
            .ToList();

    private async Task HandleClick()
    {
        if (!IsClickable)
        {
            return;
        }

        await OnCardClicked.InvokeAsync();
    }

    private static string GetArchetypeClass(
        Card character)
    {
        return character.Archetype switch
        {
            Archetype.Magic => "magic",
            Archetype.Physical => "physical",
            _ => "neutral"
        };
    }

    private static string GetEntryName(Card character) =>
        CharacterInfo.GetEntryName(character);

    private static string GetEntryDescription(Card character) =>
        CharacterInfo.GetEntryDescription(character);

    private static string GetPassiveName(Card character) =>
        CharacterInfo.GetPassiveName(character);

    private static string GetPassiveDescription(Card character) =>
        CharacterInfo.GetPassiveDescription(character);

    private static string GetActiveName(Card character) =>
        CharacterInfo.GetActiveName(character);

    private static string GetActiveDescription(Card character) =>
        CharacterInfo.GetActiveDescription(character);

    private static int GetActiveCost(Card character) =>
        CharacterInfo.GetActiveCost(character);

    private static int GetCooldownSegments(
        Card character)
    {
        return Math.Max(
            1,
            character.AbilityCooldown);
    }

    private int GetDisplayedCooldownRemaining(
        Card character)
    {
        if (Owner.CharacterNewlyDeployed)
        {
            return GetCooldownSegments(character);
        }

        return Math.Clamp(
            Owner.AbilityCooldownRemaining,
            0,
            character.AbilityCooldown);
    }

    private string GetCooldownStateText(
        Card character)
    {
        if (Owner.CharacterNewlyDeployed)
        {
            return "LOCKED";
        }

        if (Owner.AbilityUsedThisPhase)
        {
            return "USED";
        }

        int remaining =
            GetDisplayedCooldownRemaining(character);

        return remaining > 0
            ? $"CD {remaining}"
            : "READY";
    }

    private string GetActiveRailStyle(
        Card character)
    {
        if (Owner.CharacterNewlyDeployed)
        {
            return "background: #8b8f94;";
        }

        int total =
            GetCooldownSegments(character);

        int remaining =
            Math.Clamp(
                Owner.AbilityCooldownRemaining,
                0,
                total);

        int charged =
            total - remaining;

        if (remaining == 0)
        {
            return "background: #35c759;";
        }

        if (charged <= 0)
        {
            return "background: #8b8f94;";
        }

        double chargedPercent =
            (double)charged /
            total *
            100.0;

        string percent =
            chargedPercent.ToString(
                "0.###",
                System.Globalization.CultureInfo.InvariantCulture);

        return
            $"background: linear-gradient(" +
            $"to bottom, " +
            $"#35c759 0%, " +
            $"#35c759 {percent}%, " +
            $"#303030 {percent}%, " +
            $"#8b8f94 calc({percent}% + 1px), " +
            $"#8b8f94 100%);";
    }

    private bool IsActiveUnavailable()
    {
        return
            Owner.CharacterNewlyDeployed ||
            Owner.AbilityUsedThisPhase ||
            Owner.AbilityCooldownRemaining > 0;
    }

    private static string GetCharacterMark(
        Card character)
    {
        return character.Archetype switch
        {
            Archetype.Magic => "✦",
            Archetype.Physical => "▲",
            _ => "◆"
        };
    }

    private static string GetBadgeLabel(
        BattleStatus status)
    {
        return status.Key switch
        {
            "damage-floor" => "ENTRY",
            "magic-surge" => "ENTRY",
            "fortified" => "ENTRY",
            "physical-surge" => "ENTRY",
            "reduced-buildup" => "ENTRY",
            "wandering-path" => "ENTRY",
            "retaliation" => "PASSIVE",
            "arcane-focus" => "PASSIVE",
            "free-peek" => "PASSIVE",
            "end-turn-shield" => "PASSIVE",
            "ability-used" => "ACTIVE",
            _ => status.Label
        };
    }
}
