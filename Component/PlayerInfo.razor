@using RedPandaTCD_Web.Game

<div class="player-info">

    <strong class="info-title">
        @Title
    </strong>

    <span class="player-name">
        @Player.Name
    </span>


    <div class="energy-block">

        <div class="energy-label">

            <span>
                ENERGY
            </span>

            <span>
                @Player.Energy / @Player.MaxEnergy
            </span>

        </div>

        <div class="energy-track">

            <div class="energy-fill"
                 style="width: @(GetEnergyPercent())%;">
            </div>

        </div>

    </div>


    @if (ShowUtilityActions)
    {
        <div class="extra-info">

            <span>
                Utility Actions
            </span>

            <strong>
                @Player.UtilityActionsRemaining
            </strong>

        </div>
    }


    @if (ShowHandCount)
    {
        <div class="extra-info">

            <span>
                Hand
            </span>

            <strong>
                @HandManager.CountCards(Player)
            </strong>

        </div>
    }

</div>


<style>
    .player-info {
        width: 165px;

        display: flex;
        flex-direction: column;

        gap: 5px;

        color: #f5f5f5;
    }


    /* HEADER */

    .info-title {
        color: #d9e0e6;

        font-size: 10px;

        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .player-name {
        margin-bottom: 5px;

        color: #ffffff;

        font-size: 16px;
        font-weight: bold;
    }


    /* ENERGY */

    .energy-block {
        width: 100%;

        margin-top: 3px;
    }

    .energy-label {
        margin-bottom: 4px;

        display: flex;
        justify-content: space-between;
        align-items: center;

        font-size: 9px;
        font-weight: bold;

        letter-spacing: 0.4px;
    }

    .energy-track {
        width: 100%;
        height: 11px;

        overflow: hidden;

        border: 1px solid rgba(207, 144, 255, 0.3);
        border-radius: 6px;

        background: #20202a;

        box-shadow:
            inset 0 1px 3px rgba(0, 0, 0, 0.5);
    }

    .energy-fill {
        height: 100%;

        border-radius: 6px;

        background:
            linear-gradient(
                90deg,
                #802bc4,
                #bc4cff
            );

        box-shadow:
            0 0 7px rgba(188, 76, 255, 0.65);

        transition: width 0.2s ease;
    }


    /* EXTRA INFO */

    .extra-info {
        margin-top: 5px;

        padding: 5px 7px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        border-radius: 6px;

        background: rgba(255, 255, 255, 0.06);

        font-size: 10px;
    }

    .extra-info span {
        color: #bdc7d0;
    }

    .extra-info strong {
        color: #ffffff;
    }
</style>


@code {
    [Parameter]
    public Player Player { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = "Player";

    [Parameter]
    public bool ShowUtilityActions { get; set; }

    [Parameter]
    public bool ShowHandCount { get; set; }


    private double GetEnergyPercent()
    {
        if (Player.MaxEnergy <= 0)
        {
            return 0;
        }

        double percent =
            (double)Player.Energy /
            Player.MaxEnergy *
            100;

        return Math.Clamp(
            percent,
            0,
            100);
    }
}