@using RedPandaTCD_Web.Game

<div class="player-info">

    <strong class="info-title">
        @Title
    </strong>

    <span class="player-name">
        @Player.Name
    </span>


    <div class="energy-block"
     style="--energy-percent: @(GetEnergyPercent());">

    <div class="energy-track">

        <div class="energy-fill">
        </div>

        <div class="energy-label">

            <span class="energy-icon">
                ◆
            </span>

            <strong class="energy-current">
                @Player.Energy
            </strong>

            <span class="energy-maximum">
                / @Player.MaxEnergy
            </span>

            <span class="energy-text">
                Energy
            </span>

        </div>

    </div>

</div>


    @if (ShowUtilityActions)
    {
        <div class="extra-info">

            <span>
                Utility Actions
            </span>

            <strong>
                @Player.UtilityActionsRemaining
            </strong>

        </div>
    }


    @if (ShowHandCount)
    {
        <div class="extra-info">

            <span>
                Hand
            </span>

            <strong>
                @HandManager.CountCards(Player)
            </strong>

        </div>
    }

</div>


<style>
.player-info {
    width: 196px;

    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 7px;

    color: #f2f5f7;
}


/* ---------- HEADER ---------- */

.info-title {
    color: #8f9aa5;

    font-size: 9px;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: 1.2px;
}

.player-name {
    margin-bottom: 3px;

    color: #ffffff;

    font-size: 18px;
    font-weight: 900;

    line-height: 1.1;
}


/* ---------- ENERGY GAUGE ---------- */

.energy-block {
    width: 100%;

    display: flex;
    align-items: center;
    justify-content: center;
}

.energy-track {
    position: relative;

    width: 138px;
    height: 138px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background:
        conic-gradient(
            from -90deg,
            #b45cff 0%,
            #8735cf calc(var(--energy-percent) * 1%),
            rgba(155, 106, 194, 0.14)
                calc(var(--energy-percent) * 1%),
            rgba(155, 106, 194, 0.14) 100%
        );

    box-shadow:
        0 0 0 1px rgba(190, 134, 235, 0.26),
        0 10px 24px rgba(0, 0, 0, 0.34),
        0 0 20px rgba(155, 76, 217, 0.15);
}

.energy-track::before {
    content: "";

    position: absolute;
    inset: 10px;

    border: 1px solid rgba(204, 169, 234, 0.18);
    border-radius: 50%;

    background:
        radial-gradient(
            circle at 50% 38%,
            #24202c,
            #11151b 68%
        );

    box-shadow:
        inset 0 5px 16px rgba(0, 0, 0, 0.44);
}

.energy-fill {
    display: none;
}

.energy-label {
    position: relative;
    z-index: 2;

    display: grid;
    grid-template-columns: auto auto;
    grid-template-areas:
        "icon icon"
        "current maximum"
        "text text";

    align-items: baseline;
    justify-content: center;

    column-gap: 3px;
    row-gap: 1px;

    text-align: center;
}

.energy-icon {
    grid-area: icon;

    margin-bottom: 2px;

    color: #c584f2;

    font-size: 20px;
    line-height: 1;
}

.energy-current {
    grid-area: current;

    color: #ffffff;

    font-size: 30px;
    font-weight: 900;
    line-height: 1;
}

.energy-maximum {
    grid-area: maximum;

    color: #b9a4c8;

    font-size: 12px;
    font-weight: 800;
}

.energy-text {
    grid-area: text;

    margin-top: 4px;

    color: #ca9eed;

    font-size: 9px;
    font-weight: 900;

    text-transform: uppercase;
    letter-spacing: 1.35px;
}


/* ---------- UTILITY / HAND INFORMATION ---------- */

.extra-info {
    min-height: 34px;
    padding: 7px 9px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;

    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 5px;

    background: #171d23;

    color: #aeb7bf;

    font-size: 11px;
}

.extra-info strong {
    color: #ffffff;

    font-size: 14px;
    font-weight: 900;
}


/* ---------- COMPACT HEIGHT ---------- */

@@media (max-height: 820px) and (min-width: 901px) {
    .player-info {
        width: 176px;
    }

    .energy-track {
        width: 112px;
        height: 112px;
    }

    .energy-current {
        font-size: 25px;
    }

    .energy-icon {
        font-size: 16px;
    }

    .extra-info {
        min-height: 29px;
        padding-block: 5px;
    }
}
</style>


@code {
    [Parameter]
    public Player Player { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = "Player";

    [Parameter]
    public bool ShowUtilityActions { get; set; }

    [Parameter]
    public bool ShowHandCount { get; set; }


    private double GetEnergyPercent()
    {
        if (Player.MaxEnergy <= 0)
        {
            return 0;
        }

        double percent =
            (double)Player.Energy /
            Player.MaxEnergy *
            100;

        return Math.Clamp(
            percent,
            0,
            100);
    }
}