    private List<Card> GetNextTutorialCards()
    {
        int nextPosition =
            workingDeck.Cards.Count;

        if (nextPosition >=
            TutorialManager.LearnToPlayDeckOrder.Count)
        {
            return new List<Card>();
        }

        string requiredId =
            TutorialManager.LearnToPlayDeckOrder[
                nextPosition];

        Card? requiredCard =
            allCards.FirstOrDefault(card =>
                string.Equals(
                    card.Id,
                    requiredId,
                    StringComparison.OrdinalIgnoreCase));

        if (requiredCard == null)
        {
            return new List<Card>();
        }

        return new List<Card>
        {
            requiredCard
        };
    }

    private string GetTutorialBuilderInstruction()
    {
        if (!IsLearnToPlayDeckBuilder)
        {
            return "";
        }

        int nextPosition =
            workingDeck.Cards.Count;

        int requiredCount =
            TutorialManager.LearnToPlayDeckOrder.Count;

        if (nextPosition >= requiredCount)
        {
            return
                "Tutorial Queue complete. All 12 cards " +
                "are in the correct order. Save the deck " +
                "to continue.";
        }

        string requiredId =
            TutorialManager.LearnToPlayDeckOrder[
                nextPosition];

        Card? requiredCard =
            allCards.FirstOrDefault(card =>
                string.Equals(
                    card.Id,
                    requiredId,
                    StringComparison.OrdinalIgnoreCase));

        string cardName =
            requiredCard?.Name ??
            requiredId;

        return
            $"Add {cardName} next. " +
            $"The card will be placed at Queue position " +
            $"{nextPosition + 1} of {requiredCount}.";
    }

    private bool CanAddTutorialCard(
        Card card)
    {
        if (!IsLearnToPlayDeckBuilder)
        {
            return true;
        }

        int nextPosition =
            workingDeck.Cards.Count;

        if (nextPosition >=
            TutorialManager.LearnToPlayDeckOrder.Count)
        {
            return false;
        }

        string requiredId =
            TutorialManager.LearnToPlayDeckOrder[
                nextPosition];

        return string.Equals(
            card.Id,
            requiredId,
            StringComparison.OrdinalIgnoreCase);
    }

    private string GetTutorialCardClass(
        Card card)
    {
        if (!IsLearnToPlayDeckBuilder)
        {
            return "";
        }

        if (!TutorialManager.IsLearnToPlayDeckCard(
                card))
        {
            return "tutorial-unavailable";
        }

        bool alreadyAdded =
            workingDeck.Cards.Any(existing =>
                string.Equals(
                    existing.Id,
                    card.Id,
                    StringComparison.OrdinalIgnoreCase));

        if (alreadyAdded)
        {
            return "tutorial-added";
        }

        return CanAddTutorialCard(card)
            ? "tutorial-required"
            : "tutorial-unavailable";
    }

    private void StructureChanged()
    {
        DeckStructure newStructure =
            selectedStructure;

        workingDeck.Structure =
            newStructure;

        saveMessage =
            "";

        if (newStructure ==
            DeckStructure.PriorityQueue)
        {
            conversionPriorities.Clear();

            for (int i = 0;
                 i < workingDeck.Cards.Count;
                 i++)
            {
                Card card =
                    workingDeck.Cards[i];

                if (card.Type ==
                    CardType.Character)
                {
                    conversionPriorities[i] =
                        5;
                }
                else
                {
                    conversionPriorities[i] =
                        1;
                }
            }

            if (workingDeck.Cards.Count > 0)
            {
                showPriorityConversion =
                    true;

                return;
            }

            previousStructure =
                DeckStructure.PriorityQueue;

            return;
        }

        showPriorityConversion =
            false;

        conversionPriorities.Clear();

        foreach (Card card
            in workingDeck.Cards)
        {
            card.Priority =
                0;
        }

        previousStructure =
            newStructure;
    }

    private bool CanAddCard(
        Card card)
    {
        int maximumDeckSize =
            IsLearnToPlayDeckBuilder
                ? TutorialManager
                    .LearnToPlayDeckOrder
                    .Count
                : 15;

        if (workingDeck.Cards.Count >=
            maximumDeckSize)
        {
            return false;
        }

        int copies =
            workingDeck.Cards.Count(existing =>
                string.Equals(
                    existing.Id,
                    card.Id,
                    StringComparison.OrdinalIgnoreCase));

        switch (card.Type)
        {
            case CardType.Character:
                return
                    copies < 1 &&
                    CharacterCount < 2;

            case CardType.Attack:
                return
                    copies < 2;

            case CardType.Utility:
                if (UtilityCount >= 6)
                {
                    return false;
                }

                return copies < 1;

            default:
                return false;
        }
    }

    private void RequestAddCard(
        Card card)
    {
        if (!CanAddCard(card) ||
            !CanAddTutorialCard(card))
        {
            return;
        }

        saveMessage =
            "";

        saveSucceeded =
            false;

        workingDeck.Structure =
            selectedStructure;

        if (selectedStructure ==
            DeckStructure.PriorityQueue)
        {
            priorityCard =
                card;

            return;
        }

        bool success =
            RedPandaTCD_Web.Game.DeckBuilder.AddCard(
                workingDeck,
                card);

        if (!success)
        {
            saveMessage =
                "The selected card could not be added.";

            return;
        }

        if (IsLearnToPlayDeckBuilder &&
            workingDeck.Cards.Count >=
                TutorialManager
                    .LearnToPlayDeckOrder
                    .Count)
        {
            saveMessage =
                "Tutorial Queue complete. " +
                "Save the deck to continue.";

            saveSucceeded =
                true;
        }
    }

    private void AddPriorityCard(
        int priority)
    {
        if (priorityCard == null)
        {
            return;
        }

        workingDeck.Structure =
            selectedStructure;

        bool success =
            RedPandaTCD_Web.Game.DeckBuilder.AddCard(
                workingDeck,
                priorityCard,
                priority);

        if (!success)
        {
            saveSucceeded =
                false;

            saveMessage =
                "That priority is not valid for this card.";

            return;
        }

        priorityCard =
            null;

        saveMessage =
            "";
    }

    private void CancelPriority()
    {
        priorityCard =
            null;
    }

    private void SetConversionPriority(
        int cardIndex,
        int priority)
    {
        if (cardIndex < 0 ||
            cardIndex >=
                workingDeck.Cards.Count)
        {
            return;
        }

        Card card =
            workingDeck.Cards[cardIndex];

        if (card.Type ==
            CardType.Character)
        {
            conversionPriorities[cardIndex] =
                5;

            return;
        }

        if (priority < 1 ||
            priority > 4)
        {
            return;
        }

        conversionPriorities[cardIndex] =
            priority;
    }

    private string GetConversionPriorityClass(
        int cardIndex,
        int priority)
    {
        return
            conversionPriorities.TryGetValue(
                cardIndex,
                out int selected) &&
            selected == priority
                ? "selected"
                : "";
    }

    private void ConfirmPriorityConversion()
    {
        for (int i = 0;
             i < workingDeck.Cards.Count;
             i++)
        {
            Card card =
                workingDeck.Cards[i];

            if (card.Type ==
                CardType.Character)
            {
                card.Priority =
                    5;

                continue;
            }

            if (!conversionPriorities.TryGetValue(
                    i,
                    out int priority))
            {
                return;
            }

            if (priority < 1 ||
                priority > 4)
            {
                return;
            }

            card.Priority =
                priority;
        }

        selectedStructure =
            DeckStructure.PriorityQueue;

        workingDeck.Structure =
            DeckStructure.PriorityQueue;

        previousStructure =
            DeckStructure.PriorityQueue;

        showPriorityConversion =
            false;

        conversionPriorities.Clear();

        saveMessage =
            "";
    }

    private void CancelPriorityConversion()
    {
        showPriorityConversion =
            false;

        conversionPriorities.Clear();

        selectedStructure =
            previousStructure;

        workingDeck.Structure =
            previousStructure;

        if (previousStructure !=
            DeckStructure.PriorityQueue)
        {
            foreach (Card card
                in workingDeck.Cards)
            {
                card.Priority =
                    0;
            }
        }
    }

