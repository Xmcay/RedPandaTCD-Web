        "";

    private CardType? selectedType;

    private Archetype? selectedArchetype;

    private DeckStructure selectedStructure =
        DeckStructure.Queue;

    private DeckStructure previousStructure =
        DeckStructure.Queue;

    private Card? priorityCard;

    private bool showPriorityConversion;

    private Dictionary<int, int> conversionPriorities =
        new();

    private string saveMessage =
        "";

    private bool saveSucceeded;

    private bool showTutorialDeckComplete;

    private bool showTutorialBuilderIntro;

    private bool IsLearnToPlayDeckBuilder =>
        Session.Tutorial.IsActive &&
        Session.Tutorial.CurrentTutorial ==
            TutorialType.LearnToPlay &&
        Session.Tutorial.TutorialDeck == null;

    private bool IsTutorialDeckReady =>
        IsLearnToPlayDeckBuilder &&
        IsDeckValid &&
        selectedStructure ==
            DeckStructure.Queue &&
        TutorialManager.IsLearnToPlayDeckComplete(
            workingDeck) &&
        TutorialManager.IsLearnToPlayDeckOrderCorrect(
            workingDeck);

    private string TutorialValidationMessage
    {
        get
        {
            if (!IsLearnToPlayDeckBuilder)
            {
                return ValidationMessage;
            }

            if (selectedStructure !=
                DeckStructure.Queue)
            {
                return
                    "The Learn to Play deck must use " +
                    "the Queue structure.";
            }

            if (!TutorialManager.IsLearnToPlayDeckComplete(
                    workingDeck))
            {
                return
                    "Add all 12 required Tutorial cards. " +
                    TutorialManager.GetLearnToPlayDeckProgress(
                        workingDeck);
            }

            if (!TutorialManager.IsLearnToPlayDeckOrderCorrect(
                    workingDeck))
            {
                return
                    "The Queue order is incorrect. " +
                    TutorialManager.GetLearnToPlayDeckOrderHint(
                        workingDeck);
            }

            if (!IsDeckValid)
            {
                return ValidationMessage;
            }

            return
                "Tutorial deck complete. " +
                "The Queue order is correct.";
        }
    }

    private List<Card> FilteredCards
    {
        get
        {
            if (IsLearnToPlayDeckBuilder)
            {
                return GetNextTutorialCards();
            }

            IEnumerable<Card> cards =
                allCards;

            if (!string.IsNullOrWhiteSpace(
                    searchText))
            {
                cards =
                    CardLibraryManager.LinearSearch(
                        allCards,
                        searchText);
            }

            if (selectedType != null)
            {
                cards =
                    cards.Where(card =>
                        card.Type ==
                        selectedType.Value);
            }

            if (selectedArchetype != null)
            {
                cards =
                    cards.Where(card =>
                        card.Archetype ==
                        selectedArchetype.Value);
            }

            return cards.ToList();
        }
    }

