    private void SaveDeck()
    {
        workingDeck.Structure =
            selectedStructure;

        workingDeck.Name =
            deckName.Trim();

        if (IsLearnToPlayDeckBuilder)
        {
            SaveLearnToPlayDeck();
            return;
        }

        bool success =
            DeckManager.SaveDeck(
                workingDeck,
                deckName,
                out string error);

        saveSucceeded =
            success;

        if (!success)
        {
            saveMessage =
                error;

            return;
        }

        string savedName =
            deckName.Trim();

        ResetBuilder();

        saveSucceeded =
            true;

        saveMessage =
            $"{savedName} saved successfully.";
    }

    private void SaveLearnToPlayDeck()
    {
        workingDeck.Structure =
            DeckStructure.Queue;

        workingDeck.Name =
            "Tutorial Deck";

        if (!TutorialManager.IsLearnToPlayDeckComplete(
                workingDeck))
        {
            saveSucceeded =
                false;

            saveMessage =
                "Add all 12 required Tutorial cards first.";

            return;
        }

        if (!TutorialManager.IsLearnToPlayDeckOrderCorrect(
                workingDeck))
        {
            saveSucceeded =
                false;

            saveMessage =
                "The Queue order is incorrect. " +
                TutorialManager.GetLearnToPlayDeckOrderHint(
                    workingDeck);

            return;
        }

        if (!IsTutorialDeckReady)
        {
            saveSucceeded =
                false;

            saveMessage =
                "Complete the required Tutorial deck first.";

            return;
        }

        bool success =
            DeckManager.SaveDeck(
                workingDeck,
                deckName,
                out string error);

        if (!success)
        {
            saveSucceeded =
                false;

            saveMessage =
                error;

            return;
        }

        Session.Tutorial.TutorialDeck =
            DeckCloner.Clone(
                workingDeck);

        saveSucceeded =
            true;

        saveMessage =
            "Tutorial Deck saved.";

        showTutorialDeckComplete =
            true;
    }

    private void ProceedToTutorialBattle()
    {
        if (Session.Tutorial.TutorialDeck == null)
        {
            showTutorialDeckComplete =
                false;

            saveSucceeded =
                false;

            saveMessage =
                "The Tutorial deck could not be loaded.";

            return;
        }

        showTutorialDeckComplete =
            false;

        Session.CurrentMatch =
            GameSetupManager.StartLearnToPlayMatch(
                Session.PlayerName,
                Session.Tutorial.TutorialDeck);

        Navigation.NavigateTo(
            "/battle");
    }

