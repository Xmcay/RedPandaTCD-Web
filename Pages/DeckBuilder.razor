@page "/deck-builder"
@using RedPandaTCD_Web.Game
@inject NavigationManager Navigation
@inject GameSessionState Session
@using Microsoft.AspNetCore.Components

<PageTitle>Deck Builder - Red Panda TCD</PageTitle>

<div class="builder-page @GetPageTutorialClass("builder-page")">
    <div class="builder-shell">

        <header class="builder-header">
            <div>
                <h1>
                    @(IsLearnToPlayDeckBuilder
                        ? "Tutorial Deck Builder"
                        : "Deck Builder")
                </h1>

                <p>
                    @(IsLearnToPlayDeckBuilder
                        ? "Build the Queue deck you'll use during Learn to Play."
                        : "Build and save a custom deck.")
                </p>
            </div>

            <div class="header-actions">
                @if (IsLearnToPlayDeckBuilder)
                {
                    <button @onclick="ExitLearnToPlayBuilder">
                        Exit Tutorial
                    </button>
                }
                else
                {
                    <button @onclick="GoToDecks">
                        View Decks
                    </button>

                    <button @onclick="GoHome">
                        Main Menu
                    </button>
                }
            </div>
        </header>

        <main class="builder-content">

            <!-- AVAILABLE CARDS -->
            <section class="available-panel @GetPageTutorialClass("available-cards")">

                <div class="panel-header">
                    <div>
                        <h2>
                            @(IsLearnToPlayDeckBuilder
                                ? "Next Tutorial Card"
                                : "Available Cards")
                        </h2>

                        <span>
                            @if (IsLearnToPlayDeckBuilder)
                            {
                                @if (workingDeck.Cards.Count >=
                                     TutorialManager.LearnToPlayDeckOrder.Count)
                                {
                                    <text>ORDER COMPLETE</text>
                                }
                                else
                                {
                                    <text>
                                        POSITION @(workingDeck.Cards.Count + 1)
                                        OF @TutorialManager.LearnToPlayDeckOrder.Count
                                    </text>
                                }
                            }
                            else
                            {
                                <text>
                                    @FilteredCards.Count card(s)
                                </text>
                            }
                        </span>
                    </div>
                </div>

                @if (!IsLearnToPlayDeckBuilder)
                {
                    <div class="@GetPageTutorialClass("card-filters")">

                    <input class="search-box"
                           @bind="searchText"
                           @bind:event="oninput"
                           placeholder="Search by card name or ID..." />

                    <div class="filter-group">
                        <button class="@GetTypeButtonClass(null)"
                                @onclick="() => SetTypeFilter(null)">
                            All
                        </button>

                        <button class="@GetTypeButtonClass(CardType.Character)"
                                @onclick="() => SetTypeFilter(CardType.Character)">
                            Characters
                        </button>

                        <button class="@GetTypeButtonClass(CardType.Attack)"
                                @onclick="() => SetTypeFilter(CardType.Attack)">
                            Attacks
                        </button>

                        <button class="@GetTypeButtonClass(CardType.Utility)"
                                @onclick="() => SetTypeFilter(CardType.Utility)">
                            Utilities
                        </button>
                    </div>

                    <div class="filter-group">
                        <button class="@GetArchetypeButtonClass(null)"
                                @onclick="() => SetArchetypeFilter(null)">
                            All Archetypes
                        </button>

                        <button class="@GetArchetypeButtonClass(Archetype.Magic)"
                                @onclick="() => SetArchetypeFilter(Archetype.Magic)">
                            Magic
                        </button>

                        <button class="@GetArchetypeButtonClass(Archetype.Physical)"
                                @onclick="() => SetArchetypeFilter(Archetype.Physical)">
                            Physical
                        </button>

                        <button class="@GetArchetypeButtonClass(Archetype.Neutral)"
                                @onclick="() => SetArchetypeFilter(Archetype.Neutral)">
                            Neutral
                        </button>
                    </div>
                </div>
                }
                else
                {
                    <div class="tutorial-order-guide">
                        @GetTutorialBuilderInstruction()
                    </div>
                }

                <div class="available-list">

                    @if (IsLearnToPlayDeckBuilder &&
                         FilteredCards.Count == 0)
                    {
                        <div class="tutorial-order-complete">
                            <strong>
                                QUEUE ORDER COMPLETE
                            </strong>

                            <span>
                                All 12 required cards are in the
                                correct order. Review the deck,
                                then save it.
                            </span>
                        </div>
                    }
                    else
                    {
                        @foreach (Card card in FilteredCards)
                        {
                            <div class="available-card @GetTutorialCardClass(card)">

                                <div class="available-accent @GetTypeClass(card)">
                                </div>

                                <div class="available-card-main">

                                    <div class="available-card-title">
                                        <strong>
                                            @card.Name
                                        </strong>

                                        <small>
                                            @card.Id
                                        </small>
                                    </div>

                                    <span class="card-meta">
                                        @card.Archetype ·
                                        @card.Type ·
                                        Cost @card.Cost
                                    </span>

                                    @if (card.Type == CardType.Character)
                                    {
                                        <span class="card-extra">
                                            HP @card.HpValue ·
                                            Shield @card.ShieldValue
                                        </span>
                                    }
                                    else if (card.Type == CardType.Attack)
                                    {
                                        <span class="card-extra">
                                            @card.Damage Damage ·
                                            @card.Hits Hit(s)
                                        </span>
                                    }
                                    else if (card.Type == CardType.Utility)
                                    {
                                        <span class="card-extra">
                                            @UtilityInfo.GetDescription(card)
                                        </span>
                                    }

                                </div>

                                <button class="add-button"
                                        disabled="@(
                                            !CanAddCard(card) ||
                                            !CanAddTutorialCard(card))"
                                        @onclick="() => RequestAddCard(card)">
                                    +
                                </button>

                            </div>
                        }
                    }

                </div>

            </section>

            <!-- YOUR DECK -->
            <section class="deck-panel @GetPageTutorialClass("built-deck")">

                <div class="compact-deck-name @GetPageTutorialClass("deck-name")">
                    <label>
                        DECK NAME
                    </label>

                    <input @bind="deckName"
                           @bind:event="oninput"
                           placeholder="Enter deck name..."
                           disabled="@IsLearnToPlayDeckBuilder" />
                </div>

               <div class="deck-structure-selector @GetPageTutorialClass("structure-selector")">

                    <div class="structure-selector-header">
                        <label>
                            DATA STRUCTURE
                        </label>

                        <select @bind="selectedStructure"
                                @bind:after="StructureChanged"
                                disabled="@IsLearnToPlayDeckBuilder">

                            @foreach (DeckStructure structure
                                in Enum.GetValues<DeckStructure>())
                            {
                                <option value="@structure">
                                    @GetStructureName(structure)
                                </option>
                            }

                        </select>
                    </div>

                    <div class="selected-structure-info">
                        <strong>
                            @GetStructureName(selectedStructure)
                        </strong>

                        <span>
                            @GetStructureDescription(selectedStructure)
                        </span>
                    </div>

                </div>

                <div class="panel-header deck-panel-header">
                    <div>
                        <h2>
                            Your Deck
                        </h2>

                        <span>
                            @if (IsLearnToPlayDeckBuilder)
                            {
                                <text>
                                    @workingDeck.Cards.Count /
                                    @TutorialManager.LearnToPlayDeckOrder.Count
                                    tutorial cards
                                </text>
                            }
                            else
                            {
                                <text>
                                    @workingDeck.Cards.Count cards ·
                                    10-15 required
                                </text>
                            }
                        </span>
                    </div>
                </div>

                <div class="deck-summary">
                    <span>
                        Characters:
                        <strong>@CharacterCount</strong>
                    </span>

                    <span>
                        Attacks:
                        <strong>@AttackCount</strong>
                    </span>

                    <span>
                        Utilities:
                        <strong>@UtilityCount / 6</strong>
                    </span>
                </div>

                @if (workingDeck.Cards.Count == 0)
                {
                    <div class="empty-deck">
                        <strong>
                            Deck is empty.
                        </strong>

                        <span>
                            @if (IsLearnToPlayDeckBuilder)
                            {
                                <text>
                                    Add the displayed Tutorial card.
                                </text>
                            }
                            else
                            {
                                <text>
                                    Add cards from the library.
                                </text>
                            }
                        </span>
                    </div>
                }
                else
                {
                    <div class="deck-list">

                        @for (int i = 0;
                              i < workingDeck.Cards.Count;
                              i++)
                        {
                            int index = i;

                            Card card =
                                workingDeck.Cards[index];

                            <div class="deck-card">

                                <div class="deck-position">
                                    @(index + 1)
                                </div>

                                <div class="deck-card-info">
                                    <strong>
                                        @card.Name
                                    </strong>

                                    <span>
                                        @card.Id ·
                                        @card.Archetype ·
                                        @card.Type
                                    </span>

                                    @if (selectedStructure ==
                                         DeckStructure.PriorityQueue)
                                    {
                                        <small class="priority-label">
                                            Priority @card.Priority
                                        </small>
                                    }
                                </div>

                                <div class="deck-card-actions">

                                    @if (UsesManualOrder &&
                                         !IsLearnToPlayDeckBuilder)
                                    {
                                        <button disabled="@(index == 0)"
                                                title="Move Up"
                                                @onclick="() => MoveCardUp(index)">
                                            ↑
                                        </button>

                                        <button disabled="@(
                                                    index ==
                                                    workingDeck.Cards.Count - 1)"
                                                title="Move Down"
                                                @onclick="() => MoveCardDown(index)">
                                            ↓
                                        </button>
                                    }

                                    @if (!IsLearnToPlayDeckBuilder)
                                    {
                                        <button class="remove-button"
                                                title="Remove"
                                                @onclick="() => RemoveCard(index)">
                                            ×
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="tutorial-order-lock"
                                              title="This card is locked into the required Tutorial Queue order.">
                                            LOCKED
                                        </span>
                                    }

                                </div>

                            </div>
                        }

                    </div>
                }

                <div class="validation-box @GetDisplayedValidationClass() @GetPageTutorialClass("deck-summary")">
                    <strong>
                        DECK STATUS
                    </strong>

                    <span>
                        @(IsLearnToPlayDeckBuilder
                            ? TutorialValidationMessage
                            : ValidationMessage)
                    </span>
                </div>

                <button class="save-button @GetPageTutorialClass("save-deck")"
                        disabled="@(
                            IsLearnToPlayDeckBuilder &&
                            !IsTutorialDeckReady)"
                        @onclick="SaveDeck">

                    @(IsLearnToPlayDeckBuilder
                        ? "Save Tutorial Deck & Continue"
                        : "Save Deck")

                </button>

                @if (!string.IsNullOrWhiteSpace(saveMessage))
                {
                    <div class="save-message @(saveSucceeded ? "success" : "error")">
                        @saveMessage
                    </div>
                }

            </section>

        </main>

    </div>
</div>

<PageTutorialOverlay
Visible="@showPageTutorial"
Label="DECK BUILDER TUTORIAL"
Steps="@DeckBuilderPageTutorialSteps"
CurrentIndex="@pageTutorialStep"
CurrentIndexChanged="SetPageTutorialStep"
OnExit="ExitPageTutorial"
OnFinished="FinishPageTutorial" />

@if (showTutorialBuilderIntro &&
     IsLearnToPlayDeckBuilder)
{
    <div class="builder-overlay">
        <div class="tutorial-builder-dialog"
             @onclick:stopPropagation="true">

            <div class="tutorial-builder-dialog-icon">
                FIFO
            </div>

            <span class="tutorial-builder-dialog-kicker">
                LEARN TO PLAY · DECK BUILDING
            </span>

            <h2>
                Build the Tutorial Queue
            </h2>

            <p>
                This deck uses Queue order:
                <strong>First In, First Out</strong>.
            </p>

            <div class="tutorial-builder-dialog-steps">

                <div>
                    <strong>1</strong>

                    <span>
                        The left panel shows only the next
                        required card.
                    </span>
                </div>

                <div>
                    <strong>2</strong>

                    <span>
                        Press + to place the card into the
                        correct Queue position.
                    </span>
                </div>

                <div>
                    <strong>3</strong>

                    <span>
                        Add all 12 cards, save the deck,
                        and continue to the guided Battle.
                    </span>
                </div>

            </div>

            <p class="tutorial-builder-dialog-note">
                Manual reordering is disabled during this lesson
                because the guided Battle requires an exact card
                sequence.
            </p>

            <button @onclick="CloseTutorialBuilderIntro">
                START BUILDING
            </button>

        </div>
    </div>
}

<!-- ADDING A NEW CARD DIRECTLY TO PRIORITY QUEUE -->
@if (priorityCard != null)
{
    <div class="builder-overlay"
         @onclick="CancelPriority">

        <div class="priority-dialog"
             @onclick:stopPropagation="true">

            <h2>
                Choose Priority
            </h2>

            <p>
                <strong>
                    @priorityCard.Name
                </strong>
            </p>

            @if (priorityCard.Type ==
                 CardType.Character)
            {
                <p class="priority-hint">
                    Character cards always use Priority 5.
                </p>

                <button @onclick="() => AddPriorityCard(5)">
                    Priority 5
                </button>
            }
            else
            {
                <p class="priority-hint">
                    Choose Priority 1-4.
                    Priority 5 is reserved for Characters.
                </p>

                <div class="priority-buttons">

                    @for (int priority = 1;
                          priority <= 4;
                          priority++)
                    {
                        int selectedPriority =
                            priority;

                        <button @onclick="() => AddPriorityCard(selectedPriority)">
                            Priority @selectedPriority
                        </button>
                    }

                </div>
            }

            <button class="cancel-button"
                    @onclick="CancelPriority">
                Cancel
            </button>

        </div>
    </div>
}

<!-- CONVERTING AN EXISTING DECK TO PRIORITY QUEUE -->
@if (showPriorityConversion)
{
    <div class="builder-overlay">

        <div class="priority-conversion-dialog">

            <h2>
                Assign Priorities
            </h2>

            <p>
                Priority Queue requires every card
                to have a valid priority.
            </p>

            <p class="priority-hint">
                Characters are locked to Priority 5.
                Attacks and Utilities use Priority 1-4.
            </p>

            <div class="conversion-list">

                @for (int i = 0;
                      i < workingDeck.Cards.Count;
                      i++)
                {
                    int cardIndex =
                        i;

                    Card card =
                        workingDeck.Cards[cardIndex];

                    <div class="conversion-card">

                        <div class="conversion-card-info">
                            <strong>
                                @card.Name
                            </strong>

                            <span>
                                @card.Id ·
                                @card.Type
                            </span>
                        </div>

                        @if (card.Type ==
                             CardType.Character)
                        {
                            <div class="fixed-priority">
                                PRIORITY 5
                            </div>
                        }
                        else
                        {
                            <div class="conversion-buttons">

                                @for (int priority = 1;
                                      priority <= 4;
                                      priority++)
                                {
                                    int choice =
                                        priority;

                                    <button class="@GetConversionPriorityClass(
                                                        cardIndex,
                                                        choice)"
                                            @onclick="() => SetConversionPriority(
                                                cardIndex,
                                                choice)">
                                        @choice
                                    </button>
                                }

                            </div>
                        }

                    </div>
                }

            </div>

            <div class="conversion-actions">
                <button class="conversion-confirm"
                        @onclick="ConfirmPriorityConversion">
                    Apply Priorities
                </button>

                <button @onclick="CancelPriorityConversion">
                    Cancel
                </button>
            </div>

        </div>
    </div>
}

@if (showTutorialDeckComplete)
{
    <div class="builder-overlay">

        <div class="tutorial-complete-dialog"
             @onclick:stopPropagation="true">

            <div class="tutorial-complete-icon">
                ✓
            </div>

            <span class="tutorial-complete-kicker">
                DECK BUILDING COMPLETE
            </span>

            <h2>
                Your Tutorial Deck Is Ready
            </h2>

            <p>
                You've built the required 12-card Queue in
                the exact order used by the guided Battle.
            </p>

            <div class="tutorial-complete-details">

                <div>
                    <span>
                        DECK
                    </span>

                    <strong>
                        Tutorial Deck
                    </strong>
                </div>

                <div>
                    <span>
                        STRUCTURE
                    </span>

                    <strong>
                        Queue
                    </strong>
                </div>

                <div>
                    <span>
                        CARDS
                    </span>

                    <strong>
                        @TutorialManager.LearnToPlayDeckOrder.Count
                    </strong>
                </div>

            </div>

            <p class="tutorial-complete-note">
                Next, you'll use this deck in a guided Battle.
                Incorrect actions will be blocked so you can
                follow the lesson without restarting.
            </p>

            <button class="proceed-battle-button"
                    @onclick="ProceedToTutorialBattle">
                PROCEED TO BATTLE
                <span>→</span>
            </button>

        </div>

    </div>
}
<style>
* {
    box-sizing: border-box;
}

.builder-page {
    min-height: calc(100vh - 58px);
    padding: 30px 24px 60px;
    background:
        linear-gradient(
            160deg,
            #18212b 0%,
            #23364a 55%,
            #3a2428 100%
        );
    color: #f5f5f5;
}

.builder-shell {
    width: min(1350px, 100%);
    margin: 0 auto;
}

/* =========================
   HEADER
   ========================= */

.builder-header {
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.builder-header h1 {
    margin: 0;
    color: #f4efe3;
    font-size: clamp(32px, 4vw, 48px);
}

.builder-header p {
    margin: 6px 0 0;
    color: #c8d0d8;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}

.header-actions button {
    padding: 11px 18px;
    border: 1px solid #9b9383;
    border-radius: 6px;
    background: #f4efe3;
    color: #222;
    cursor: pointer;
    font-weight: bold;
}

.header-actions button:hover {
    background: #e5ddcc;
}

/* =========================
   MAIN BUILDER LAYOUT
   ========================= */

.builder-content {
    display: grid;
    grid-template-columns:
        minmax(0, 1.25fr)
        minmax(380px, .75fr);
    align-items: start;
    gap: 18px;
}

.available-panel,
.deck-panel {
    min-width: 0;
    padding: 17px;
    border: 1px solid #56616c;
    border-radius: 10px;
    background: rgba(19, 27, 35, .94);
}

.panel-header {
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.panel-header h2 {
    margin: 0;
    color: #f4efe3;
    font-size: 21px;
}

.panel-header span {
    display: block;
    margin-top: 3px;
    color: #9da8b2;
    font-size: 10px;
}

/* =========================
   COMPACT DECK NAME
   ========================= */

.compact-deck-name {
    margin-bottom: 12px;
    padding: 9px 11px;
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid #596674;
    border-radius: 7px;
    background: #111820;
}

.compact-deck-name label {
    flex-shrink: 0;
    color: #aeb8c1;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: .8px;
    white-space: nowrap;
}

.compact-deck-name input {
    min-width: 0;
    flex: 1;
    padding: 7px 9px;
    border: 1px solid #77818a;
    border-radius: 5px;
    background: #f4efe3;
    color: #222;
    font-size: 11px;
}

.compact-deck-name input:focus {
    border-color: #e5cc67;
    outline: none;
    box-shadow: 0 0 0 2px rgba(229, 204, 103, .16);
}

.compact-deck-name input:disabled {
    background: #d9d1c0;
    color: #665f54;
    cursor: default;
    opacity: .9;
}

/* =========================
   SEARCH AND FILTERS
   ========================= */

.search-box {
    width: 100%;
    margin-bottom: 10px;
    padding: 10px 12px;
    border: 1px solid #8b949e;
    border-radius: 6px;
    background: #f4efe3;
    color: #222;
}

.search-box:focus {
    border-color: #e5cc67;
    outline: none;
    box-shadow: 0 0 0 2px rgba(229, 204, 103, .16);
}

.filter-group {
    margin-bottom: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.filter-group button {
    padding: 7px 10px;
    border: 1px solid #8b949e;
    border-radius: 5px;
    background: #e9e4d8;
    color: #222;
    cursor: pointer;
    font-size: 10px;
    font-weight: bold;
}

.filter-group button:hover {
    background: #f4efe3;
}

.filter-group button.active {
    border-color: #e5cc67;
    background: #e5cc67;
}

/* =========================
   GUIDED TUTORIAL ORDER
   ========================= */

.tutorial-order-guide {
    padding: 11px 12px;
    border: 1px solid #b69d55;
    border-left: 4px solid #e5cc67;
    border-radius: 6px;
    background: rgba(229, 204, 103, .08);
    color: #d8d0b5;
    font-size: 10px;
    font-weight: bold;
    line-height: 1.45;
}

.tutorial-order-complete {
    min-height: 150px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border: 1px solid #4f9364;
    border-radius: 8px;
    background: rgba(81, 199, 132, .08);
    color: #c8d0d8;
    text-align: center;
}

.tutorial-order-complete strong {
    color: #81c784;
    font-size: 12px;
    letter-spacing: .8px;
}

.tutorial-order-complete span {
    max-width: 360px;
    font-size: 10px;
    line-height: 1.45;
}

.tutorial-order-lock {
    padding: 5px 7px;
    border: 1px solid #596674;
    border-radius: 4px;
    background: #111820;
    color: #8f9ba5;
    font-size: 7px;
    font-weight: 900;
    letter-spacing: .7px;
    white-space: nowrap;
}

/* Required Tutorial card. */

.available-card.tutorial-required {
    border-color: #e5cc67;
    box-shadow:
        0 0 0 1px rgba(229, 204, 103, .18),
        0 0 14px rgba(229, 204, 103, .27);
}

/* Required card already placed in the Tutorial deck. */

.available-card.tutorial-added {
    border-color: #4e8d61;
    opacity: .66;
    box-shadow: 0 0 8px rgba(79, 147, 100, .18);
}

/* Card outside the Tutorial recipe. */

.available-card.tutorial-unavailable {
    filter: grayscale(.55);
    opacity: .46;
}

/* =========================
   AVAILABLE CARDS
   ========================= */

.available-list {
    max-height: 610px;
    margin-top: 12px;
    padding-right: 4px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    overflow-y: auto;
}

.available-card {
    position: relative;
    min-height: 68px;
    display: grid;
    grid-template-columns:
        5px
        minmax(0, 1fr)
        40px;
    align-items: stretch;
    overflow: hidden;
    border: 1px solid #655d51;
    border-radius: 7px;
    background:
        linear-gradient(
            145deg,
            #fff9e9 0%,
            #eee4cd 100%
        );
    color: #25221d;
}

.available-accent {
    width: 5px;
}

.type-character {
    background: #cf5959;
}

.type-attack {
    background: #d49a3a;
}

.type-utility {
    background: #5689d6;
}

.available-card-main {
    min-width: 0;
    padding: 9px 10px;
    display: flex;
