private string GetPageTutorialClass(
    string target)
{
    if (!showPageTutorial ||
        pageTutorialStep < 0 ||
        pageTutorialStep >=
            DeckBuilderPageTutorialSteps.Count)
    {
        return "";
    }

    return string.Equals(
        DeckBuilderPageTutorialSteps[
            pageTutorialStep].Target,
        target,
        StringComparison.OrdinalIgnoreCase)
            ? "page-tutorial-target"
            : "";
}

