@page "/player-setup"

@using RedPandaTCD_Web.Game
@inject GameSessionState Session

<PageTitle>Player Setup - Red Panda TCD</PageTitle>

<div class="setup-page">

    <div class="setup-glow setup-glow-left"></div>
    <div class="setup-glow setup-glow-right"></div>

    <main class="setup-panel">

        <div class="brand-block">

            <div class="panda-mark">
                RP
            </div>

            <div class="brand-title">
                <span class="brand-red">
                    RED PANDA
                </span>

                <span class="brand-gold">
                    TCD
                </span>
            </div>

            <p class="subtitle">
                TACTICAL CARD DUELS
            </p>

        </div>


        <div class="setup-divider">
            <span></span>

            <div class="divider-diamond"></div>

            <span></span>
        </div>


        <section class="name-section">

            <span class="section-kicker">
                PLAYER SETUP
            </span>

            <h1>
                Choose Your Name
            </h1>

            <p class="name-description">
                This name identifies you during battles,
                Tournament matches, and throughout the current session.
            </p>


            <form @onsubmit="SubmitName"
                  @onsubmit:preventDefault>

                <div class="input-group">

                    <label for="player-name">
                        PLAYER NAME
                    </label>

                    <input id="player-name"
                           @bind="playerName"
                           @bind:event="oninput"
                           placeholder="Enter your name"
                           maxlength="24"
                           autocomplete="off"
                           autofocus />

                    <span class="input-hint">
                        Up to 24 characters
                    </span>

                </div>


                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="error-message">
                        <span class="error-symbol">
                            !
                        </span>

                        <span>
                            @errorMessage
                        </span>
                    </div>
                }


                <button class="continue-button"
                        type="submit">

                    <span>
                        CONTINUE
                    </span>

                    <span class="continue-arrow">
                        →
                    </span>

                </button>

            </form>

        </section>


        <footer class="setup-footer">
            Your name can be used across Training,
            Pass-and-Play, and the Grand Tournament.
        </footer>

    </main>

</div>


<style>

    /* =========================
       PAGE
       ========================= */

    .setup-page {
        position: relative;

        min-height: calc(100vh - 58px);

        box-sizing: border-box;

        padding:
            40px
            20px;

        display: flex;
        align-items: center;
        justify-content: center;

        overflow: hidden;

        background:
            radial-gradient(
                circle at 50% 0%,
                rgba(229, 204, 103, 0.08),
                transparent 36%
            ),
            linear-gradient(
                160deg,
                #18212b 0%,
                #23364a 55%,
                #3a2428 100%
            );

        color: #f5f5f5;
    }


    /* =========================
       BACKGROUND ACCENTS
       ========================= */

    .setup-glow {
        position: absolute;

        width: 420px;
        height: 420px;

        border-radius: 50%;

        filter: blur(80px);

        pointer-events: none;

        opacity: 0.17;
    }

    .setup-glow-left {
        left: -180px;
        bottom: -190px;

        background: #356fc4;
    }

    .setup-glow-right {
        top: -180px;
        right: -180px;

        background: #b84747;
    }


    /* =========================
       MAIN PANEL
       ========================= */

    .setup-panel {
        position: relative;
        z-index: 1;

        width: min(470px, 100%);

        box-sizing: border-box;

        padding:
            34px
            38px
            26px;

        display: flex;
        flex-direction: column;
        align-items: center;

        border:
            1px solid #596674;

        border-radius: 14px;

        background:
            linear-gradient(
                145deg,
                rgba(25, 35, 45, 0.98),
                rgba(15, 22, 29, 0.98)
            );

        box-shadow:
            0 20px 55px rgba(0, 0, 0, 0.36),
            0 0 0 1px rgba(255, 255, 255, 0.02) inset;

        text-align: center;
    }


    /* =========================
       BRAND
       ========================= */

    .brand-block {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .panda-mark {
        width: 54px;
        height: 54px;

        margin-bottom: 13px;

        display: flex;
        align-items: center;
        justify-content: center;

        box-sizing: border-box;

        border:
            2px solid #e5cc67;

        border-radius: 50%;

        background: #111820;

        color: #e5cc67;

        font-size: 14px;
        font-weight: 900;

        letter-spacing: 1px;

        box-shadow:
            0 0 16px rgba(229, 204, 103, 0.14);
    }

    .brand-title {
        display: flex;
        align-items: center;

        gap: 9px;

        line-height: 1;
    }

    .brand-red {
        color: #d94b4b;

        font-size:
            clamp(
                29px,
                5vw,
                38px
            );

        font-weight: 900;

        letter-spacing: -0.8px;

        text-shadow:
            0 3px 0 #090c10;
    }

    .brand-gold {
        color: #e5cc67;

        font-size:
            clamp(
                25px,
                4vw,
                33px
            );

        font-weight: 900;

        letter-spacing: 1.5px;

        text-shadow:
            0 3px 0 #090c10;
    }

    .subtitle {
        margin:
            8px
            0
            0;

        color: #8d99a5;

        font-size: 9px;
        font-weight: bold;

        letter-spacing: 2.5px;
    }


    /* =========================
       DIVIDER
       ========================= */

    .setup-divider {
        width: 100%;

        margin:
            27px
            0
            25px;

        display: flex;
        align-items: center;

        gap: 10px;
    }

    .setup-divider > span {
        height: 1px;

        flex: 1;

        background:
            linear-gradient(
                90deg,
                transparent,
                #596674
            );
    }

    .setup-divider > span:last-child {
        background:
            linear-gradient(
                90deg,
                #596674,
                transparent
            );
    }

    .divider-diamond {
        width: 6px;
        height: 6px;

        border:
            1px solid #e5cc67;

        background: #18212b;

        transform: rotate(45deg);
    }


    /* =========================
       NAME SECTION
       ========================= */

    .name-section {
        width: 100%;
    }

    .section-kicker {
        color: #e5cc67;

        font-size: 8px;
        font-weight: 900;

        letter-spacing: 1.6px;
    }

    .name-section h1 {
        margin:
            6px
            0
            8px;

        color: #f4efe3;

        font-size:
            clamp(
                24px,
                4vw,
                31px
            );

        line-height: 1.1;
    }

    .name-description {
        max-width: 350px;

        margin:
            0
            auto
            23px;

        color: #aeb8c1;

        font-size: 11px;
        line-height: 1.5;
    }


    /* =========================
       FORM
       ========================= */

    .name-section form {
        width: min(340px, 100%);

        margin: 0 auto;

        display: flex;
        flex-direction: column;

        gap: 13px;
    }

    .input-group {
        display: flex;
        flex-direction: column;

        text-align: left;
    }

    .input-group label {
        margin-bottom: 6px;

        color: #9ca7b1;

        font-size: 8px;
        font-weight: 900;

        letter-spacing: 1px;
    }

    .input-group input {
        width: 100%;

        box-sizing: border-box;

        padding:
            13px
            14px;

        border:
            2px solid #626d78;

        border-radius: 7px;

        background: #0f171f;
        color: #f4efe3;

        outline: none;

        font-size: 15px;
        font-weight: 600;

        text-align: center;

        transition:
            border-color 0.14s ease,
            box-shadow 0.14s ease,
            background 0.14s ease;
    }

    .input-group input::placeholder {
        color: #65717c;

        font-weight: normal;
    }

    .input-group input:hover {
        border-color: #7c8791;
    }

    .input-group input:focus {
        border-color: #e5cc67;

        background: #121c25;

        box-shadow:
            0 0 0 3px rgba(229, 204, 103, 0.10),
            0 0 14px rgba(229, 204, 103, 0.08);
    }

    .input-hint {
        margin-top: 5px;

        color: #697580;

        font-size: 8px;

        text-align: right;
    }


    /* =========================
       ERROR
       ========================= */

    .error-message {
        padding:
            9px
            11px;

        display: flex;
        align-items: center;

        gap: 8px;

        border:
            1px solid #914f54;

        border-radius: 6px;

        background:
            rgba(184, 71, 71, 0.11);

        color: #ffb3b3;

        font-size: 10px;
        font-weight: bold;

        text-align: left;
    }

    .error-symbol {
        width: 18px;
        height: 18px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background: #a9484d;
        color: #ffffff;

        font-size: 10px;
        font-weight: 900;
    }


    /* =========================
       CONTINUE
       ========================= */

    .continue-button {
        width: 100%;

        margin-top: 2px;

        box-sizing: border-box;

        padding:
            12px
            15px;

        display: flex;
        align-items: center;
        justify-content: center;

        gap: 9px;

        border:
            2px solid #b69d55;

        border-radius: 7px;

        background:
            linear-gradient(
                145deg,
                #f4e9c8,
                #dccc9c
            );

        color: #222222;

        cursor: pointer;

        font-size: 11px;
        font-weight: 900;

        letter-spacing: 0.8px;

        box-shadow:
            0 4px 0 #776735;

        transition:
            transform 0.12s ease,
            filter 0.12s ease,
            box-shadow 0.12s ease;
    }

    .continue-button:hover {
        transform:
            translateY(-2px);

        filter:
            brightness(1.06);

        box-shadow:
            0 6px 0 #776735,
            0 8px 18px rgba(0, 0, 0, 0.24);
    }

    .continue-button:active {
        transform:
            translateY(2px);

        box-shadow:
            0 2px 0 #776735;
    }

    .continue-arrow {
        font-size: 16px;
        line-height: 1;
    }


    /* =========================
       FOOTER
       ========================= */

    .setup-footer {
        max-width: 330px;

        margin-top: 22px;

        padding-top: 16px;

        border-top:
            1px solid rgba(255, 255, 255, 0.07);

        color: #707c87;

        font-size: 8px;
        line-height: 1.4;
    }


    /* =========================
       RESPONSIVE
       ========================= */

    @@media (max-width: 520px) {

        .setup-page {
            padding:
                20px
                12px;
        }

        .setup-panel {
            padding:
                28px
                20px
                23px;
        }

        .panda-mark {
            width: 48px;
            height: 48px;
        }

        .brand-title {
            gap: 6px;
        }

    }

</style>


@code {

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;


    private string playerName = "";

    private string errorMessage = "";


    protected override void OnInitialized()
    {
        if (Session.HasPlayerName)
        {
            Navigation.NavigateTo("/");
        }
    }


    private void SubmitName()
    {
        string name =
            playerName.Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            errorMessage =
                "Please enter a player name.";

            return;
        }

        Session.PlayerName =
            name;

        Navigation.NavigateTo("/");
    }

}