@code {
    private List<Card> allCards = new();
    private string searchText = "";
    private CardType? selectedType;
    private Archetype? selectedArchetype;
    private bool sortByCost;
    private Card? inspectedCard;

    protected override void OnInitialized()
    {
        allCards = CardLibraryManager.GetAllCards();
    }

    private List<Card> FilteredCards
    {
        get
        {
            IEnumerable<Card> cards = allCards;

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                cards = CardLibraryManager.LinearSearch(allCards, searchText);
            }

            if (selectedType != null)
            {
                cards = cards.Where(card => card.Type == selectedType.Value);
            }

            if (selectedArchetype != null)
            {
                cards = cards.Where(card => card.Archetype == selectedArchetype.Value);
            }

            List<Card> results = cards.ToList();

            if (sortByCost)
            {
                results = CardLibraryManager.InsertionSortByCost(results);
            }

            return results;
        }
    }

    private static HandSlot CreatePreviewSlot(Card card) =>
        new(1)
        {
            CardInSlot = card
        };


    private void InspectCard(Card card)
    {
        inspectedCard = card;
    }

    private void CloseInspector()
    {
        inspectedCard = null;
    }

    private void SetTypeFilter(CardType? type)
    {
        selectedType = type;
    }

    private void SetArchetypeFilter(Archetype? archetype)
    {
        selectedArchetype = archetype;
    }

    private void ToggleSort()
    {
        sortByCost = !sortByCost;
    }

    private string GetTypeButtonClass(CardType? type) =>
        selectedType == type ? "active" : "";

    private string GetArchetypeButtonClass(Archetype? archetype) =>
        selectedArchetype == archetype ? "active" : "";

    private static string GetCardClass(Card card) =>
        card.Type switch
        {
            CardType.Character => "library-character",
            CardType.Attack => "library-attack",
            CardType.Utility => "library-utility",
            _ => ""
        };

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
}
