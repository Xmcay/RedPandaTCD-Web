@page "/"
@using RedPandaTCD_Web.Game
@inject GameSessionState Session
@inject NavigationManager Navigation

<PageTitle>Red Panda TCD</PageTitle>

<div class="home-page">

    <main class="home-shell">

        <header class="home-header">

            <div class="home-logo">
                RP
            </div>

            <h1>
                RED PANDA TCD
            </h1>

            <p class="subtitle">
                TACTICAL CARD DUELS
            </p>

        </header>

        <section class="menu-category">

            <div class="category-title">
                BATTLE
            </div>

            <div class="menu-grid">

                <button class="menu-card"
                        @onclick="GoToTraining">

                    <div class="menu-icon">⚔</div>

                    <strong>Training Bot</strong>

                    <small>
                        Battle an automated opponent.
                    </small>

                </button>

                <button class="menu-card"
                        @onclick="GoToPassAndPlay">

                    <div class="menu-icon">👥</div>

                    <strong>Pass &amp; Play</strong>

                    <small>
                        Two players. One device.
                    </small>

                </button>

                <button class="menu-card tournament-card"
                        @onclick="GoToTournament">

                    <div class="menu-icon">🏆</div>

                    <strong>Grand Tournament</strong>

                    <small>
                        Face the instructors and prove your strategy.
                    </small>

                </button>

            </div>

        </section>

        <section class="menu-category">

            <div class="category-title">
                COLLECTION
            </div>

            <div class="menu-grid">

                <button class="menu-card"
                        @onclick="GoToDecks">

                    <div class="menu-icon">📚</div>

                    <strong>My Decks</strong>

                    <small>
                        View and manage saved decks.
                    </small>

                </button>

                <button class="menu-card"
                        @onclick="GoToDeckBuilder">

                    <div class="menu-icon">🛠</div>

                    <strong>Deck Builder</strong>

                    <small>
                        Create and edit custom decks.
                    </small>

                </button>

                <button class="menu-card"
                        @onclick="GoToCardLibrary">

                    <div class="menu-icon">🃏</div>

                    <strong>Card Library</strong>

                    <small>
                        Browse every available card.
                    </small>

                </button>

            </div>

        </section>

        <section class="menu-category">

            <div class="category-title">
                ACADEMY
            </div>

            <div class="academy-grid">

                <button class="menu-card"
                        @onclick="GoToTutorial">

                    <div class="menu-icon">🎓</div>

                    <strong>Tutorial</strong>

                    <small>
                        Learn the game and its structures.
                    </small>

                </button>

                <button class="menu-card"
                        @onclick="GoToSimulator">

                    <div class="menu-icon">📊</div>

                    <strong>Battle Simulator</strong>

                    <small>
                        Test strategies and compare results.
                    </small>

                </button>

            </div>

        </section>

    </main>
    @if (showTutorialPopup)
{
    <div class="tutorial-popup-overlay">

        <div class="tutorial-popup">

            <div class="tutorial-popup-icon">
                🎓
            </div>

            <span class="tutorial-popup-kicker">
                WELCOME TO RED PANDA TCD
            </span>

            <h2>
                New Player?
            </h2>

            <p>
                It looks like this is your first time playing.
                The Tutorial teaches deck building, battle flow,
                card structures, and core mechanics through a
                guided match.
            </p>

            <div class="tutorial-popup-actions">

                <button class="tutorial-start"
                        @onclick="GoToTutorial">
                    Start Tutorial
                </button>

                <button class="tutorial-skip"
                        @onclick="DismissTutorialPopup">
                    Skip For Now
                </button>

            </div>

        </div>

    </div>
}
</div>


<style>
.tutorial-popup-overlay
{
    position:fixed;
    inset:0;

    display:flex;
    align-items:center;
    justify-content:center;

    background:rgba(7,11,15,.88);

    z-index:10000;
}

.tutorial-popup
{
    width:min(520px,100%);

    padding:28px;

    display:flex;
    flex-direction:column;
    align-items:center;

    gap:12px;

    border:2px solid #b69d55;
    border-radius:12px;

    background:#18232e;

    color:#f4efe3;

    text-align:center;

    box-shadow:
        0 20px 55px rgba(0,0,0,.55);
}

.tutorial-popup-icon
{
    width:64px;
    height:64px;

    display:flex;
    align-items:center;
    justify-content:center;

    border:2px solid #e5cc67;
    border-radius:50%;

    font-size:30px;

    background:rgba(229,204,103,.10);
}

.tutorial-popup-kicker
{
    color:#e5cc67;

    font-size:8px;
    font-weight:900;

    letter-spacing:1.4px;
}

.tutorial-popup h2
{
    margin:0;

    font-size:28px;
}

.tutorial-popup p
{
    margin:0;

    color:#bac4cd;

    line-height:1.6;

    font-size:13px;
}

.tutorial-popup-actions
{
    width:100%;

    margin-top:6px;

    display:grid;

    grid-template-columns:1fr 1fr;

    gap:10px;
}

.tutorial-start
{
    padding:12px;

    border:2px solid #b69d55;

    border-radius:7px;

    background:#e5cc67;

    color:#222;

    font-weight:900;

    cursor:pointer;
}

.tutorial-skip
{
    padding:12px;

    border:1px solid #596674;

    border-radius:7px;

    background:#111820;

    color:#f4efe3;

    cursor:pointer;
}
.menu-category
{
    margin-bottom:12px;
}

.menu-category:last-child
{
    margin-bottom:0;
}
.home-page
{
    height: calc(100vh - 58px);

    padding:
        0
        28px
        0;

    box-sizing:border-box;

    background:
        radial-gradient(
            circle at 18% 18%,
            rgba(83,111,139,.20),
            transparent 34%
        ),
        radial-gradient(
            circle at 82% 80%,
            rgba(110,54,61,.20),
            transparent 34%
        ),
        linear-gradient(
            160deg,
            #18212b 0%,
            #23364a 55%,
            #3a2428 100%
        );

    color:#f5f5f5;
}

.home-shell
{
    width:min(1300px,100%);
    margin:0 auto;
}

.home-header
{
    text-align:center;

    padding-top:70px;

    margin-bottom:8px;
}


.home-logo
{
   width:42px;
    height:42px;

    margin:0 auto 4px;

    display:flex;
    align-items:center;
    justify-content:center;

    border:2px solid #e5cc67;
    border-radius:50%;

    color:#e5cc67;

    font-weight:900;

    background:#111820;

    box-shadow:
        0 0 20px rgba(229,204,103,.10);
}

.home-header h1
{
    margin:0;

    color:#d94b4b;

   font-size:clamp(42px,5vw,62px);

    line-height:.95;

    letter-spacing:-2px;

    text-shadow:
        0 3px 0 #090c10;
}

.subtitle
{
    margin-top:8px;

    color:#8d99a5;

    font-size:10px;

    font-weight:bold;

    letter-spacing:4px;
}


.category-title
{
    margin-bottom:10px;

    color:#e5cc67;

    font-size:16px;

    font-weight:900;

    letter-spacing:3px;

    text-transform:uppercase;
}


.menu-grid
{
    display:grid;

    grid-template-columns:
        repeat(3,minmax(0,1fr));

    gap:12px;
}

.academy-grid
{
    display:grid;

    grid-template-columns:
        repeat(2,minmax(0,1fr));

    gap:12px;
}

.menu-card
{
    min-height:110px;
    padding:14px;


    display:flex;
    flex-direction:column;

    text-align:left;

    border:
        1px solid #596674;

    border-radius:10px;

    background:
        linear-gradient(
            145deg,
            rgba(25,35,45,.95),
            rgba(15,22,29,.95)
        );

    color:#f5f5f5;

    cursor:pointer;

    transition:
        transform .15s ease,
        border-color .15s ease,
        box-shadow .15s ease;
}

.menu-card:hover
{
    transform:translateY(-4px);

    border-color:#d6bf74;

    box-shadow:
        0 10px 22px rgba(0,0,0,.24);
}

.menu-icon
{
    margin-bottom:auto;

    font-size:32px;
}

.menu-card strong
{
    color:#f4efe3;

    font-size:20px;
}

.menu-card small
{
    margin-top:6px;

    color:#9fabb5;

    font-size:12px;

    line-height:1.4;
}

.tournament-card
{
    border-color:#b69d55;

    background:
        linear-gradient(
            145deg,
            rgba(88,68,19,.35),
            rgba(30,26,17,.95)
        );
}

@@media (max-width:900px)
{
    .menu-grid,
    .academy-grid
    {
        grid-template-columns:1fr;
    }

    .menu-card
    {
        min-height:140px;
    }
}

@@media (max-width:600px)
{
    .home-page
    {
        padding:18px;
    }

    .home-header h1
    {
        font-size:52px;
    }
}

</style>


@code {

    protected override void OnInitialized()
{
    if (!Session.HasPlayerName)
    {
        Navigation.NavigateTo("/player-setup");
        return;
    }

    showTutorialPopup =
        Session.ShowTutorialRecommendation;

    Session.ShowTutorialRecommendation = false;
}

    private void GoToTraining()
    {
        Navigation.NavigateTo(
            "/player-deck");
    }


    private void GoToPassAndPlay()
    {
        Navigation.NavigateTo(
            "/pass-and-play");
    }


    private void GoToTournament()
    {
        Navigation.NavigateTo(
            "/tournament");
    }


    private void GoToDecks()
    {
        Navigation.NavigateTo(
            "/decks");
    }


    private void GoToDeckBuilder()
    {
        Navigation.NavigateTo(
            "/deck-builder");
    }


    private void GoToCardLibrary()
    {
        Navigation.NavigateTo(
            "/card-library");
    }


    private void GoToTutorial()
    {
        Navigation.NavigateTo(
            "/tutorial");
    }


    private void GoToSimulator()
    {
        Navigation.NavigateTo(
            "/simulator");
    }
    private bool showTutorialPopup;
    private void DismissTutorialPopup()
{
    showTutorialPopup = false;
}
}