@code {
    private bool showStartWarning;

    private bool DsaTutorialsAvailable =>
        true;

    private int CompletedDsaTutorials
    {
        get
        {
            int completed = 0;

            if (Session.Tutorial.QueueCompleted)
                completed++;

            if (Session.Tutorial.PriorityQueueCompleted)
                completed++;

            if (Session.Tutorial.StackCompleted)
                completed++;

            if (Session.Tutorial.RandomListCompleted)
                completed++;

            if (Session.Tutorial.LinkedListCompleted)
                completed++;

            return completed;
        }
    }

private int CompletedTutorials =>
    CompletedDsaTutorials +
    (Session.Tutorial.LearnToPlayCompleted
        ? 1
        : 0) +
    (Session.Tutorial.DeckBuilderCompleted
        ? 1
        : 0) +
    (Session.Tutorial.TournamentCompleted
        ? 1
        : 0) +
    (Session.Tutorial.SimulatorCompleted
        ? 1
        : 0);

private double ProgressPercent =>
    CompletedTutorials / 9.0 * 100.0;

    private void StartLearnToPlay()
    {
        showStartWarning = true;
    }

    private void ConfirmStartLearnToPlay()
    {
        showStartWarning = false;

        Session.CurrentMatch = null;

        /*
            Clear any unfinished tutorial while
            preserving completed tutorial records.
        */
        Session.Tutorial.EndTutorial();

        TutorialManager.StartLearnToPlay(
            Session.Tutorial);

        Navigation.NavigateTo(
            "/deck-builder");
    }

    private void CloseStartWarning()
    {
        showStartWarning = false;
    }

    private void StartDsaTutorial(
        TutorialType tutorial)
    {
        if (!DsaTutorialsAvailable ||
            tutorial is
                TutorialType.None or
                TutorialType.LearnToPlay)
        {
            return;
        }

        Session.CurrentMatch = null;

        /*
            End any unfinished run first. Completion
            flags remain stored in TutorialState.
        */
        Session.Tutorial.EndTutorial();

        TutorialManager.StartTutorial(
            Session.Tutorial,
            tutorial);

        string playerName =
            Session.HasPlayerName
                ? Session.PlayerName
                : "Player";

        Session.CurrentMatch =
            GameSetupManager.StartDsaTutorialMatch(
                playerName,
                tutorial);

        Navigation.NavigateTo(
            "/battle");
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
    private void StartDeckBuilderTutorial()
{
    Navigation.NavigateTo(
        "/deck-builder?tutorial=true");
}

private void StartTournamentTutorial()
{
    Navigation.NavigateTo(
        "/tournament?tutorial=true");
}

private void StartSimulatorTutorial()
{
    Navigation.NavigateTo(
        "/simulator?tutorial=true");
}
}
