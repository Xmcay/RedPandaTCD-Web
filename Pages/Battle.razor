    observingFinishedMatch = false;
    Session.CurrentMatch = null;
    allowNavigation = true;
    Navigation.NavigateTo("/");
}

private async Task CopyBattleLog()
{
    IReadOnlyList<BattleLogEntry> entries =
        BattleLog.GetPhaseActions();

    if (entries.Count == 0) return;

    string logText =
        "RED PANDA TCD - BATTLE LOG" +
        Environment.NewLine +
        Environment.NewLine +
        string.Join(
            Environment.NewLine,
            entries.Select(entry =>
                $"[{entry.Label.ToUpperInvariant()}] " +
                entry.Message));

    await JS.InvokeVoidAsync(
        "navigator.clipboard.writeText",
        logText);

    logCopied = true;
    await Task.Delay(1200);
    logCopied = false;
}

private bool IsPassAndPlay()
{
    if (Session.CurrentMatch == null)
        return false;

    return
        !Session.CurrentMatch.Player1.IsBot &&
        !Session.CurrentMatch.Player2.IsBot;
}

private Player GetPresentedPlayer()
{
    MatchState match =
        Session.CurrentMatch!;

    return IsPassAndPlay()
        ? match.GetActingPlayer()
        : match.Player1;
}

private Player GetPresentedOpponent()
{
    MatchState match =
        Session.CurrentMatch!;

    Player player =
        GetPresentedPlayer();

    return player == match.Player1
        ? match.Player2
        : match.Player1;
}

protected override async Task OnAfterRenderAsync(
    bool firstRender)
{
    int currentCount =
        BattleLog.GetPhaseActions().Count;

    if (currentCount == lastBattleLogCount)
        return;

    lastBattleLogCount = currentCount;

    if (logCollapsed) return;

    await JS.InvokeVoidAsync(
        "redPandaBattle.scrollLogToBottom",
        battleLogElement);
}

private bool IsBattleFinished
{
    get
    {
        if (surrendered) return true;
        if (Session.CurrentMatch == null) return true;

        return Session.CurrentMatch.IsCompleted ||
               MatchManager.IsMatchOver(
                   Session.CurrentMatch.Player1,
                   Session.CurrentMatch.Player2);
    }
}

