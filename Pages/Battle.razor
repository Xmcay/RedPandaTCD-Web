private bool CanInteractWithAttack(
    Player player,
    int slot)
{
    MatchState? match =
        Session.CurrentMatch;

    if (match == null ||
        IsBattleFinished ||
        botIsActing ||
        match.GetActingPlayer() != player ||
        slot is not (1 or 2))
    {
        return false;
    }

    Card? attack =
        slot == 1
            ? player.AttackSlot1
            : player.AttackSlot2;

    if (match.CurrentPhase ==
        MatchPhase.Placement)
    {
        if (IsDsaTutorialBattle)
{
    return attack == null;
}

        if (!IsGuidedTutorialBattle)
        {
            return true;
        }

        if (RequiredTutorialAction ==
            TutorialAction.ResolveWandererEntry)
        {
            return attack != null;
        }

        if (RequiredTutorialAction ==
                TutorialAction.ReplaceAttack &&
            IsLearnToPlayBattle)
        {
            return
                attack != null &&
                string.Equals(
                    attack.Id,
                    "AP4",
                    StringComparison.OrdinalIgnoreCase);
        }

        if (RequiredTutorialAction ==
                TutorialAction.RestAttack &&
            IsLearnToPlayBattle)
        {
            return
                attack != null &&
                TutorialAllowsCard(
                    attack);
        }

        if (RequiredTutorialAction ==
            TutorialAction.DeployAttack)
        {
            return attack == null;
        }

        return false;
    }

    if (match.CurrentPhase !=
            MatchPhase.Attack ||
        attack == null)
    {
        return false;
    }

    if (IsGuidedTutorialBattle &&
        RequiredTutorialAction !=
            TutorialAction.UseAttack)
    {
        return false;
    }

    if (IsLearnToPlayBattle &&
        !TutorialAllowsCard(
            attack))
    {
        return false;
    }

    bool fatigued =
        slot == 1
            ? player.IsFatiguedSlot1
            : player.IsFatiguedSlot2;

    bool resting =
        slot == 1
            ? player.IsRestingSlot1
            : player.IsRestingSlot2;

    bool used =
        slot == 1
            ? player.AttackSlot1UsedThisPhase
            : player.AttackSlot2UsedThisPhase;

    int useCost =
        slot == 1
            ? player.AttackSlot1TotalUses
            : player.AttackSlot2TotalUses;

    return
        !fatigued &&
        !resting &&
        !used &&
        player.Energy >= useCost;
}

private void HandleAttackCardClick(int slot)
{
    if (Session.CurrentMatch == null)
        return;

    MatchState match = Session.CurrentMatch;
    Player player = GetPresentedPlayer();

    if (botIsActing ||
        match.GetActingPlayer() != player)
        return;

    if (match.CurrentPhase == MatchPhase.Placement)
    {
        if (awaitingWandererEntry)
        {
            ResolveWandererEntrySelection(
                player,
