@page "/battle"
@using RedPandaTCD_Web.Game
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@inject GameSessionState Session
@inject NavigationManager Navigation
@inject IJSRuntime JS
@layout BattleLayout

<PageTitle>Battle - Red Panda TCD</PageTitle>

<NavigationLock
    OnBeforeInternalNavigation="HandleNavigationAway"
    ConfirmExternalNavigation="@ShouldConfirmExternalNavigation" />

@if (Session.CurrentMatch == null)
{
    <div class="p-3">
        <h1>Battle</h1>
        <p>No active match.</p>
    </div>
}
else
{
    var match = Session.CurrentMatch;
    var player = GetPresentedPlayer();
    var enemy = GetPresentedOpponent();

<div class="battle @(logCollapsed ? "log-collapsed" : "") @GetTutorialFocusClass("battle-board")">

        <section class="side enemy-side @GetTutorialFocusClass("enemy-field", "enemy-character")">

            <PlayerInfo
                Player="enemy"
                Title="Enemy"
                ShowHandCount="true" />

            <div class="field">
                <AttackCard Owner="enemy" Slot="1" />
                <CharacterCard Owner="enemy" />
                <AttackCard Owner="enemy" Slot="2" />
            </div>
        </section>

<section class="phase-bar @GetTutorialFocusClass("phase-bar", "phase-utility", "phase-placement", "phase-attack", "phase-end", "initiative")">
            <div class="turn-details">
                <strong>Turn @match.TurnNumber</strong>

                <span class="initiative-owner">
                    Initiative → @match.GetFirstPlayer().Name
                </span>
            </div>

            <div class="phases">
                @PhaseBox("Utility", MatchPhase.Utility, "utility")
                @PhaseBox("Placement", MatchPhase.Placement, "placement")
                @PhaseBox("Attack", MatchPhase.Attack, "attack")
                @PhaseBox("End", MatchPhase.End, "end")
            </div>

            <div class="turn-owner @GetTurnOwnerClass(player)">
                <span>@GetTurnOwnerText(player)</span>
            </div>
        </section>

       <section class="side player-side @GetTutorialFocusClass("player-field", "player-energy", "player-character", "wanderer-entry")">

            <div class="player-row">

                <PlayerInfo
                    Player="player"
                    Title="Player"
                    ShowUtilityActions="true" />

                <div class="field player-field">
                    <AttackCard
                        Owner="player"
                        Slot="1"
                        IsClickable="@CanInteractWithAttack(player, 1)"
                        HighlightAttackAction="@ShouldHighlightAttack(player, 1)"
                        PlacementHighlightClass="@GetAttackPlacementHighlight(player, 1)"
                        OnCardClicked="HandleAttackCardClick" />

                    <CharacterCard
                        Owner="player"
                        IsClickable="@CanInteractWithCharacter(player)"
                        HighlightAttackAction="@ShouldHighlightCharacterAbility(player)"
                        PlacementHighlightClass="@GetCharacterPlacementHighlight(player)"
                        OnCardClicked="HandleCharacterCardClick" />

                    <AttackCard
                        Owner="player"
                        Slot="2"
                        IsClickable="@CanInteractWithAttack(player, 2)"
                        HighlightAttackAction="@ShouldHighlightAttack(player, 2)"
                        PlacementHighlightClass="@GetAttackPlacementHighlight(player, 2)"
                        OnCardClicked="HandleAttackCardClick" />
                </div>

<div class="piles">

    <div class="@GetDeckClass(player)"
         @onclick="() => SelectDeckAction(player)">

        <strong>DECK</strong>

        <span class="pile-number">
            @(player.Deck.RuntimeStorage?.Count ?? 0)
        </span>

        <small class="deck-structure">
            @GetDeckStructureName(
                player.Deck.Structure)
        </small>
    </div>

    <div class="discard @GetTutorialFocusClass("discard-pile")">
        <strong>DISCARD</strong>

        <span class="pile-number">
            @player.DiscardPile.Count
        </span>
    </div>

</div>

            </div>
        </section>
            <aside class="log-panel @GetTutorialFocusClass("battle-log")">
            <div class="log-header">
                @if (!logCollapsed)
                {
                    <h2>Battle Log</h2>

                    <button class="copy-log-button"
                            @onclick="CopyBattleLog">
                        @(logCopied ? "Copied!" : "Copy Log")
                    </button>
                }

                <button class="log-toggle"
                        @onclick="ToggleLog">
                    @(logCollapsed ? "◀" : "▶")
                </button>
            </div>

            @if (!logCollapsed)
            {
                <div class="log" @ref="battleLogElement">
                    @if (BattleLog.GetPhaseActions().Count == 0)
                    {
                        <span class="muted">No actions yet.</span>
                    }
                    else
                    {
                        @foreach (BattleLogEntry entry in BattleLog.GetPhaseActions())
                        {
                            <div class="log-entry @GetLogPhaseClass(entry)">
                                <span class="log-phase">@entry.Label</span>
                                <span class="log-action">@entry.Message</span>
                            </div>
                        }
                    }
                </div>
            }

            <div class="match-controls">
                @if (!IsBattleFinished)
                {
                    <ContinueButton
                        Disabled="@IsContinueDisabled(player)"
                        IsBusy="@botIsActing"
                        Highlight="@ShouldHighlightContinue(player)"
                        OnClick="ContinuePhase" />

                    <button disabled="@IsSurrenderDisabled"
                            @onclick="RequestSurrender">
                        Surrender
                    </button>
                }
                else if (observingFinishedMatch)
                {
                    <div class="finished-observation-label">
                        Match Finished · Observing Board
                    </div>
                }
            </div>
        </aside>

        <section class="hand-area @GetTutorialHandFocusClass()">
            <strong class="hand-label">Your Hand</strong>

            <div class="hand">
              @foreach (HandSlot slot in player.HandSlots)
{
    <div class="@GetTutorialHandCardClass(slot)">
        <HandCard
            Slot="slot"
            IsClickable="@CanSelectHandCard(player, slot)"
            OnCardClicked="SelectHandCard" />
    </div>
}
            </div>
        </section>

        @if (selectedHandSlot?.CardInSlot != null)
        {
            Card selectedCard = selectedHandSlot.CardInSlot;

            <div class="card-action-overlay"
     @onclick="RequestCloseHandCard">
                <div class="card-action-panel"
                     @onclick:stopPropagation="true">

                    <h3>@selectedCard.Name</h3>

                    <div class="selected-card-meta">
                        <span>
                            @selectedCard.Archetype · @selectedCard.Type
                        </span>

                        <strong>COST @selectedCard.Cost</strong>
                    </div>

                    @if (selectedCard.Type == CardType.Utility)
                    {
                        <div class="utility-description">
                            <strong>EFFECT</strong>

                            <span>
                                @UtilityInfo.GetDescription(selectedCard)
                            </span>
                        </div>

                        <button disabled="@(!CanPlaySelectedUtility)"
                                @onclick="PlaySelectedUtility">
                            Play Utility
                        </button>
                    }

                    <button disabled="@(!CanDiscardSelectedCard)"
                            @onclick="DiscardSelectedCard">
                        Discard & Draw
                    </button>

                    <button disabled="@(!CanCloseSelectedHandCard)"
        @onclick="RequestCloseHandCard">
    Cancel
</button>
                </div>
            </div>
        }

        @if (showDeckAction && Session.CurrentMatch != null)
        {
            <div class="card-action-overlay"
                 @onclick="CloseDeckAction">
                <div class="card-action-panel"
                     @onclick:stopPropagation="true">

                    <h3>Deck Action</h3>
                    <p>@GetDeckActionMessage(player)</p>

                    @if (player.Deck.Structure == DeckStructure.Queue ||
                         player.Deck.Structure == DeckStructure.Stack)
                    {
                        <button disabled="@(!CanPerformDeckTutorialAction(TutorialAction.PeekDeck))"
                                @onclick="PeekSelectedDeck">
                            Peek
                        </button>

                        <button @onclick="CloseDeckAction">
                            Cancel
                        </button>
                    }
                    else if (player.Deck.Structure == DeckStructure.RandomList)
                    {
                        <button disabled="@(!CanPerformDeckTutorialAction(TutorialAction.ViewDrawPool))"
                                @onclick="ViewSelectedDrawPool">
                            View Draw Pool
                        </button>

                        <button @onclick="CloseDeckAction">
                            Cancel
                        </button>
                    }
                    else if (player.Deck.Structure == DeckStructure.LinkedList)
                    {
                        <button disabled="@(!CanPerformDeckTutorialAction(TutorialAction.StartReorderNodes))"
                                @onclick="StartReorderNodes">
                            Reorder Nodes
                        </button>

                        <button @onclick="CloseDeckAction">
                            Cancel
                        </button>
                    }
                </div>
            </div>
        }

        @if (peekedCards != null)
        {
            <CardViewer
                Title="Deck Peek"
                Cards="peekedCards"
                OnClose="ClosePeek" />
        }

        @if (drawPoolCards != null)
        {
            <CardViewer
                Title="Draw Pool"
                Cards="drawPoolCards"
                OnClose="CloseDrawPool" />
        }

        @if (reorderCards != null)
        {
            <ReorderNodes
                Cards="reorderCards"
                OnMove="MoveReorderNode"
                OnFinish="CloseReorderPreview" />
        }

        @if (showPassDeviceDialog && Session.CurrentMatch != null)
        {
            var passMatch = Session.CurrentMatch;
            var nextPlayer = passMatch.GetActingPlayer();

            <div class="pass-device-overlay">
                <div class="pass-device-dialog">
                    <div class="pass-device-icon">↔</div>
                    <h2>Pass the Device</h2>
                    <p>Hand the device to</p>

                    <strong class="pass-player-name">
                        @nextPlayer.Name
                    </strong>

                    <p class="pass-warning">
                        The next player's hand will remain hidden
                        until they are ready.
                    </p>

                    <button @onclick="AcknowledgePassDevice">
                        I'm Ready
                    </button>
                </div>
            </div>
        }

        @if (showCoinFlipDialog && Session.CurrentMatch != null)
        {
            var coinFlipMatch = Session.CurrentMatch;
            bool playerWonFlip =
                coinFlipMatch.GetActingPlayer() == coinFlipMatch.Player1;

            <div class="card-action-overlay">
                <div class="card-action-panel"
                     @onclick:stopPropagation="true">

                    <h3>Coin Flip</h3>

                    @if (IsPassAndPlay())
                    {
                        <p>
                            <strong>
                                @coinFlipMatch.GetActingPlayer().Name
                            </strong>
                            won the coin flip!<br />
                            @coinFlipMatch.GetActingPlayer().Name will act first.
                        </p>
                    }
                    else if (playerWonFlip)
                    {
                        <p>
                            You won the coin flip!<br />
                            You will act first.
                        </p>
                    }
                    else
                    {
                        <p>
                            Bot won the coin flip!<br />
                            Bot will act first.
                        </p>
                    }

                    <button @onclick="AcknowledgeCoinFlip">
                        Continue
                    </button>
                </div>
            </div>
        }

        @if (selectedPlacementAttackSlot != null &&
             !showFatiguedAttackActions)
        {
            Card? selectedFieldAttack =
                GetSelectedPlacementAttack(player);

            <div class="card-action-overlay"
                 @onclick="ClosePlacementAttack">
                <div class="card-action-panel placement-picker-panel"
                     @onclick:stopPropagation="true">

                    <h3>
                        @(selectedFieldAttack == null
                            ? "Deploy Attack"
                            : "Replace Attack")
                    </h3>

                    @if (selectedFieldAttack == null)
                    {
                        <p>
                            Choose an Attack for Slot
                            @selectedPlacementAttackSlot.
                        </p>
                    }
                    else
                    {
                        <p>
                            Choose an Attack to replace
                            <strong>@selectedFieldAttack.Name</strong>.
                        </p>
                    }

                    @{
                        var deployableAttacks =
                            player.HandSlots
                                .Where(slot =>
                                    !slot.IsEmpty &&
                                    slot.CardInSlot?.Type ==
                                        CardType.Attack)
                                .ToList();
                    }

@if (deployableAttacks.Count == 0)
{
    <p>No Attack cards in hand.</p>
}
else
{
    <div class="placement-card-choices">
        @foreach (HandSlot slot in deployableAttacks)
        {
            <div class="@GetReplacementChoiceClass(slot)">
                <HandCard
                    Slot="slot"
                    IsClickable="@CanChoosePlacementAttack(slot)"
                    OnCardClicked="DeploySelectedAttack" />
            </div>
        }
    </div>
}

                    <button @onclick="ClosePlacementAttack">
                        Cancel
                    </button>
                </div>
            </div>
        }

        @if (selectedPlacementAttackSlot != null &&
             showFatiguedAttackActions)
        {
            Card? fatiguedAttack =
                GetSelectedPlacementAttack(player);

            if (fatiguedAttack != null)
            {
                <div class="card-action-overlay"
                     @onclick="CloseFatiguedAttackActions">
                    <div class="card-action-panel"
                         @onclick:stopPropagation="true">

                        <h3>@fatiguedAttack.Name</h3>
                        <p>This Attack is Fatigued.</p>

                        @if (player.Deck.Structure ==
                             DeckStructure.PriorityQueue)
                        {
                            <button disabled="@(!CanResolveFatigueWithRest)"
                                    @onclick="EmergencyRestSelectedAttack">
                                Emergency Rest
                            </button>
                        }
                        else
                        {
                            <button disabled="@(!CanResolveFatigueWithRest)"
                                    @onclick="RestSelectedAttack">
                                Rest
                            </button>
                        }

                        <button disabled="@(!CanResolveFatigueWithReplace)"
                                @onclick="ReplaceSelectedFatiguedAttack">
                            Replace
                        </button>

                        <button @onclick="CloseFatiguedAttackActions">
                            Cancel
                        </button>
                    </div>
                </div>
            }
        }

        @if (showZeroEnergyDialog && Session.CurrentMatch != null)
        {
            MatchState finishedMatch = Session.CurrentMatch;
            Player? winner =
                surrendered
                    ? GetPresentedOpponent()
                    : MatchManager.GetWinner(
                        finishedMatch.Player1,
                        finishedMatch.Player2);

            <div class="card-action-overlay">
                <div class="card-action-panel result-panel"
                     @onclick:stopPropagation="true">

                    @if (surrendered)
                    {
                        <h3>Defeat</h3>
                        <p>You surrendered the match.</p>

                        <p>
                            <strong>
                                @GetPresentedOpponent().Name
                            </strong>
                            wins the match.
                        </p>
                    }
                    else if (finishedMatch.IsDraw)
                    {
                        <h3>Draw!</h3>
                        <p>Both players reached 0 Energy.</p>
                        <p>Neither player wins the match.</p>
                    }
                    else
                    {
                        bool playerWon =
                            winner == finishedMatch.Player1;

                        @if (IsTournamentChampion)
                        {
                            <div class="tournament-champion-result">
                                <div class="champion-kicker">
                                    GRAND TOURNAMENT
                                </div>

                                <h3 class="champion-heading">
                                    Champion!
                                </h3>

                                <div class="champion-title">
                                    MASTER STRATEGIST
                                </div>

                                <p>
                                    You defeated all three Tournament
                                    opponents.
                                </p>

                                <p>
                                    <strong>Rogue Nomad</strong>
                                    has been defeated.
                                </p>

                                @if (Session.Tournament.LockedPlayerDeck != null)
                                {
                                    <div class="champion-quote">
                                        @TournamentManager.GetVictoryQuote(
                                            Session.Tournament
                                                .LockedPlayerDeck
                                                .Structure)
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <h3>
                                @(playerWon ? "Victory!" : "Defeat")
                            </h3>

                            @if (winner != null)
                            {
                                <p>
                                    <strong>@winner.Name</strong>
                                    wins the match.
                                </p>
                            }

                            @if (finishedMatch.Player1.Energy <= 0)
                            {
                                <p>Your Energy reached 0.</p>
                            }
                            else if (finishedMatch.Player2.Energy <= 0)
                            {
                                <p>
                                    @finishedMatch.Player2.Name's
                                    Energy reached 0.
                                </p>
                            }
                        }
                    }

                    <button disabled="@IsObserveBoardDisabled"
                            @onclick="ObserveFinishedMatch">
                        Observe Board
                    </button>

                    @if (IsFinishedTournamentMatch)
                    {
                        @if (HasNextTournamentRound)
                        {
                            <button @onclick="ContinueTournament">
                                Continue Tournament
                            </button>
                        }
                        else
                        {
                            <button @onclick="ReturnToTournament">
                                Return to Tournament
                            </button>
                        }
                    }
                    else if (!IsGuidedTutorialBattle)
                    {
                        <button @onclick="ReturnToMainMenu">
                            Main Menu
                        </button>
                    }
                </div>
            </div>
        }

        @if (showZeroEnergyWarning)
        {
            <div class="card-action-overlay">
                <div class="card-action-panel"
                     @onclick:stopPropagation="true">

                    <h3>Warning</h3>

                    <p>
                        This action will reduce your Energy to 0.
                    </p>

                    <p>
                        Reaching 0 Energy immediately ends the match.
                        This action could result in a loss or a draw.
                    </p>

                    <button @onclick="ConfirmZeroEnergyAction">
                        Continue Anyway
                    </button>

                    <button @onclick="CancelZeroEnergyAction">
                        Cancel
                    </button>
                </div>
            </div>
        }

        @if (showLeaveMatchDialog)
        {
            <div class="card-action-overlay"
                 @onclick="CancelLeaveMatch">
                <div class="card-action-panel"
                     @onclick:stopPropagation="true">

                    <h3>Surrender Match?</h3>

                    <p>
                        Leaving the battle will surrender the current match.
                    </p>

                    <button @onclick="ConfirmLeaveMatch">
                        Surrender
                    </button>

                    <button @onclick="CancelLeaveMatch">
                        Stay
                    </button>
                </div>
            </div>
        }

        @if (showCharacterPicker)
        {
            <div class="card-action-overlay"
                 @onclick="CloseCharacterPicker">
                <div class="card-action-panel character-picker-panel"
                     @onclick:stopPropagation="true">

                    <h3>
                        @(player.ActiveCharacter == null
                            ? "Deploy Character"
                            : "Replace Character")
                    </h3>

                    @if (player.ActiveCharacter == null)
                    {
                        <p>Choose a Character to deploy.</p>
                    }
                    else
                    {
                        <p>
                            Choose a Character to replace
                            <strong>
                                @player.ActiveCharacter.Name
                            </strong>.
                        </p>
                    }

                    @{
                        var deployableCharacters =
                            player.HandSlots
                                .Where(slot =>
                                    !slot.IsEmpty &&
                                    slot.CardInSlot?.Type ==
                                        CardType.Character)
                                .ToList();
                    }

                    @if (deployableCharacters.Count == 0)
                    {
                        <p>No Character cards in hand.</p>
                    }
                    else
                    {
                        <div class="character-picker-choices">
                            @foreach (HandSlot slot
                                in deployableCharacters)
                            {
                                Card character =
                                    slot.CardInSlot!;

                                <div class="character-choice">
                                    <HandCard
                                        Slot="slot"
                                        IsClickable="@CanChoosePlacementCharacter(character)"
                                        OnCardClicked="DeploySelectedCharacter" />

                                    <div class="character-choice-info">
                                        <div class="character-choice-archetype">
                                            @character.Archetype ·
                                            @character.Type
                                        </div>

                                        <div class="character-choice-ability entry">
                                            <strong>
                                                ENTRY ·
                                                @CharacterInfo.GetEntryName(character)
                                            </strong>

                                            <span>
                                                @CharacterInfo.GetEntryDescription(character)
                                            </span>
                                        </div>

                                        <div class="character-choice-ability passive">
                                            <strong>
                                                PASSIVE ·
                                                @CharacterInfo.GetPassiveName(character)
                                            </strong>

                                            <span>
                                                @CharacterInfo.GetPassiveDescription(character)
                                            </span>
                                        </div>

                                        <div class="character-choice-ability active">
                                            <strong>
                                                ACTIVE ·
                                                @CharacterInfo.GetActiveName(character)
                                            </strong>

                                            <span>
                                                @CharacterInfo.GetActiveDescription(character)
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <button @onclick="CloseCharacterPicker">
                        Cancel
                    </button>
                </div>
            </div>
        }

<TutorialOverlay
    @key="Session.Tutorial.CurrentStep"
    Visible="@ShowTutorialOverlay"
    OnAdvanced="HandleTutorialOverlayAdvanced"
    OnFinish="FinishCurrentTutorial" />

    </div>
}
<style>
* { box-sizing: border-box; }

.battle {
    height: calc(100vh - 60px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    grid-template-rows: minmax(0, 1fr) 72px minmax(0, 1fr) 200px;
    background: #171d24;
    overflow: hidden;
}

.battle.log-collapsed {
    grid-template-columns: minmax(0, 1fr) 115px;
}

.side {
    min-width: 0;
    padding: 20px 25px;
}

.enemy-side {
    grid-column: 1;
    grid-row: 1;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #3a2428;
    color: #f5f5f5;
}

.enemy-side > :first-child {
    position: absolute;
    left: 25px;
}

.player-side {
    grid-column: 1;
    grid-row: 3;
    display: flex;
    align-items: center;
    background: #23364a;
    color: #f5f5f5;
}

.field {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(10px, 2vw, 30px);
}

.player-row {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.player-field {
    min-width: 0;
}

.player-info {
    position: absolute;
    left: 0;
    align-self: center;
}

.phase-bar {
    grid-column: 1;
    grid-row: 2;
    position: relative;
    padding: 8px 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-top: 3px solid #090c10;
    border-bottom: 3px solid #090c10;
    background: #151b22;
    color: #f5f5f5;
    font-size: 18px;
}

.turn-details {
    position: absolute;
    left: 25px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    white-space: nowrap;
}

.turn-details strong {
    font-size: 18px;
    line-height: 1;
}

.initiative-owner {
    color: #e5cc67;
    font-size: 9px;
    font-weight: bold;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: .6px;
}

.turn-owner {
    position: absolute;
    right: 25px;
    padding: 6px 12px;
    border: 2px solid;
    border-radius: 6px;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: .8px;
    white-space: nowrap;
}

.turn-owner.player-turn {
    color: #81c784;
    border-color: #81c784;
    background: rgba(129, 199, 132, .1);
}

.turn-owner.bot-turn {
    color: #ef9a9a;
    border-color: #ef9a9a;
    background: rgba(239, 154, 154, .1);
}

.phases {
    display: flex;
    justify-content: center;
    gap: 12px;
}

.phase {
    padding: 8px 18px;
    border: 2px solid rgba(255, 255, 255, .16);
    border-radius: 7px;
    color: #fff;
    font-weight: bold;
    white-space: nowrap;
    opacity: .48;
    transition: opacity .15s, transform .15s, border-color .15s, box-shadow .15s;
}

.phase.active {
    opacity: 1;
    border-color: #fff;
    transform: scale(1.07);
    box-shadow: 0 0 0 2px #000, 0 4px 10px rgba(0, 0, 0, .35);
}

.utility { background: #2f7d4a; }
.placement { background: #a98224; }
.attack { background: #b84747; }
.end { background: #59616a; }

.piles {
    position: absolute;
    right: 0;
    display: flex;
    align-items: flex-end;
    gap: 14px;
}

.deck,
.discard {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
}

.deck {
    width: 82px;
    height: 112px;
    border: 3px solid #333;
    background: #d9d1bc;
    color: #222;
}

.discard {
    width: 64px;
    height: 82px;
    border: 2px dashed #8b949e;
