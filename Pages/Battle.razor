            return;
        }

        SelectPlacementAttack(slot);
        return;
    }

    if (match.CurrentPhase != MatchPhase.Attack ||
        !CanInteractWithAttack(player, slot))
        return;

    bool success =
        AttackManager.UseAttack(
            player,
            GetPresentedOpponent(),
            slot);

    if (!success) return;

    NotifyTutorialAction(
        TutorialAction.UseAttack);

    CheckForZeroEnergy();
    StateHasChanged();
}

private bool CanInteractWithCharacter(Player player)
{
    MatchState? match = Session.CurrentMatch;

    if (match == null ||
        IsBattleFinished ||
        botIsActing ||
        match.GetActingPlayer() != player)
        return false;

    if (match.CurrentPhase == MatchPhase.Placement)
    {
        if (!IsGuidedTutorialBattle)
            return true;

        return RequiredTutorialAction is
            TutorialAction.DeployCharacter or
