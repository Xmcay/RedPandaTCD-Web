private void StartReorderNodes()
{
    if (Session.CurrentMatch == null) return;

    Player player = GetPresentedPlayer();

    if (!CanUseDeckAction(player) ||
        player.Deck.Structure != DeckStructure.LinkedList ||
        !UtilityManager.StartReorderNodes(player))
        return;

    reorderCards = player.Deck.RuntimeStorage!
        .GetCards()
        .Take(6)
        .ToList();

    linkedNodeMoved = false;
    NotifyTutorialAction(TutorialAction.StartReorderNodes);
    showDeckAction = false;
    StateHasChanged();
}

private void MoveReorderNode((int From, int To) move)
{
    if (Session.CurrentMatch == null) return;

    Player player = GetPresentedPlayer();

    if (player.Deck.Structure != DeckStructure.LinkedList ||
        reorderCards == null ||
        !TutorialAllows(TutorialAction.MoveReorderNode) ||
        !UtilityManager.ReorderNodes(player, move.From, move.To))
        return;

    linkedNodeMoved = true;

    reorderCards = player.Deck.RuntimeStorage!
        .GetCards()
        .Take(6)
        .ToList();

    NotifyTutorialAction(TutorialAction.MoveReorderNode);
    StateHasChanged();
}

