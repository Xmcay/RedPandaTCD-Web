private void PrepareDsaTutorialBattle()
{
    if (Session.CurrentMatch == null ||
        dsaRecyclePrepared)
    {
        return;
    }

    Player player =
        GetPresentedPlayer();

    dsaRecyclePrepared =
        true;

    dsaRecycleResolved =
        false;

    dsaRecycleCardCount =
        0;

    if (player.DiscardPile.Count == 0 &&
        player.Deck.RuntimeStorage != null)
    {
        for (int i = 0;
             i < DsaRecycleSampleSize &&
             player.Deck.RuntimeStorage.Count > 0;
             i++)
        {
            Card? card =
                player.Deck.RuntimeStorage.Draw();

            if (card != null)
            {
                player.DiscardPile.Add(
                    card);
            }
        }
    }

    dsaRecycleCardCount =
        player.DiscardPile.Count;
}

private async Task HandleDsaInformationalAdvance()
{
    if (!IsDsaTutorialBattle ||
        Session.CurrentMatch == null)
    {
        return;
    }

    TutorialAction action =
        RequiredTutorialAction;

    if (action ==
        TutorialAction.PrepareRecycle)
    {
        PrepareDsaRecycleState();

        NotifyTutorialAction(
            TutorialAction.PrepareRecycle);
    }

    await Task.CompletedTask;
}

private void PrepareDsaRecycleState()
{
    if (Session.CurrentMatch == null ||
        dsaRecycleResolved)
        return;

    Player player = GetPresentedPlayer();

    if (player.Deck.RuntimeStorage == null ||
        player.DiscardPile.Count == 0)
        return;

    /*
        Empty only runtime storage. The field and hand
        remain visible, while the saved discard cards
        demonstrate how this deck structure receives
        recycled cards.
    */
    while (player.Deck.RuntimeStorage.Count > 0)
        player.Deck.RuntimeStorage.Draw();
}

private async Task ResolveDsaRecycleDemonstration()
{
    if (Session.CurrentMatch == null ||
        dsaRecycleResolved ||
        RequiredTutorialAction !=
            TutorialAction.ObserveRecycle)
    {
        return;
    }

    Player player =
        GetPresentedPlayer();

    if (player.Deck.RuntimeStorage == null)
    {
        return;
    }

    int recycledCount =
        dsaRecycleCardCount;

    /*
        If cards remain in discard, the normal End
        draw did not need them. Recycle them now
        through the real structure's Add operation.
    */
    if (player.DiscardPile.Count > 0)
    {
        List<Card> recycled =
            player.DiscardPile.ToList();

        recycledCount =
            recycled.Count;

        player.DiscardPile.Clear();

        foreach (Card card in recycled)
        {
            player.Deck.RuntimeStorage.Add(card);
        }

        BattleLog.WriteSystem(
            GetRecycleLogMessage(
                player.Deck.Structure,
                recycledCount));
    }
    else
    {
        /*
            DrawUntilHandSize already recycled the
            discard pile during the real End Phase.
        */
        BattleLog.WriteSystem(
            GetRecycleLogMessage(
                player.Deck.Structure,
                recycledCount));
    }

    dsaRecycleResolved = true;

    NotifyTutorialAction(
        TutorialAction.ObserveRecycle);

    StateHasChanged();

    await Task.CompletedTask;
}

private string GetRecycleLogMessage(
    DeckStructure structure,
    int count)
{
    string destination = structure switch
    {
        DeckStructure.Queue =>
            "the rear of the Queue",

        DeckStructure.PriorityQueue =>
            "the Priority Queue using each card's priority",

        DeckStructure.Stack =>
            "the top of the Stack",

        DeckStructure.RandomList =>
            "the Random List draw pool",

        DeckStructure.LinkedList =>
            "the tail of the Linked List",

        _ => "the deck"
    };

    return
        $"{count} discarded card(s) recycled into {destination}.";
}

