private string GetAttackPlacementHighlight(
    Player player,
    int slot)
{
    MatchState? match =
        Session.CurrentMatch;

    if (match == null ||
        IsBattleFinished ||
        botIsActing ||
        match.GetActingPlayer() != player)
    {
        return "";
    }

    Card? attack =
        slot == 1
            ? player.AttackSlot1
            : player.AttackSlot2;

    if (awaitingWandererEntry)
    {
        return attack != null
            ? "placement-replace"
            : "";
    }

    if (match.CurrentPhase !=
        MatchPhase.Placement)
    {
        return "";
    }

    if (IsDsaTutorialBattle)
    {
        return
            attack == null &&
            HasAffordableAttackInHand(
                player)
                ? "placement-deploy"
                : "";
    }

    if (IsGuidedTutorialBattle)
    {
        if (RequiredTutorialAction ==
                TutorialAction.RestAttack &&
            attack != null &&
            TutorialAllowsCard(
                attack))
        {
            return "placement-fatigued";
        }

        if (RequiredTutorialAction ==
                TutorialAction.ReplaceAttack &&
            attack != null &&
            string.Equals(
                attack.Id,
                "AP4",
                StringComparison.OrdinalIgnoreCase))
        {
            return "placement-replace";
        }

        if (RequiredTutorialAction ==
            TutorialAction.DeployAttack)
        {
            return
                attack == null &&
                HasAffordableAttackInHand(
                    player)
                    ? "placement-deploy"
                    : "";
        }

        return "";
    }

    bool fatigued =
        slot == 1
            ? player.IsFatiguedSlot1
            : player.IsFatiguedSlot2;

    if (attack != null &&
        fatigued)
    {
        return "placement-fatigued";
    }

    if (!HasAffordableAttackInHand(
            player))
    {
        return "";
    }

    return attack == null
        ? "placement-deploy"
        : "placement-replace";
}

private bool HasAffordableAttackInHand(
    Player player)
{
    foreach (HandSlot slot in player.HandSlots)
    {
        Card? card = slot.CardInSlot;

        if (card?.Type != CardType.Attack)
            continue;

        if (IsLearnToPlayBattle &&
            !TutorialAllowsCard(card))
            continue;

        int cost = card.Cost;

        if (player.DiscountActive)
            cost = Math.Max(0, cost - 1);

        if (player.Energy >= cost)
            return true;
    }

    return false;
}

private bool ShouldHighlightCharacterAbility(
    Player player)
{
    if (Session.CurrentMatch?.CurrentPhase !=
        MatchPhase.Attack)
        return false;

    return CanInteractWithCharacter(player);
}

private string GetCharacterPlacementHighlight(
    Player player)
{
    MatchState? match = Session.CurrentMatch;

    if (match == null ||
        IsBattleFinished ||
        botIsActing ||
        match.CurrentPhase !=
            MatchPhase.Placement ||
        match.GetActingPlayer() != player)
        return "";

    if (IsGuidedTutorialBattle &&
        RequiredTutorialAction is not
            (TutorialAction.DeployCharacter or
             TutorialAction.ReplaceCharacter))
        return "";

    if (!HasAffordableCharacterInHand(player))
        return "";

    return player.ActiveCharacter == null
        ? "placement-deploy"
        : "placement-replace";
}

private bool HasAffordableCharacterInHand(
    Player player)
{
    foreach (HandSlot slot in player.HandSlots)
    {
        Card? card = slot.CardInSlot;

        if (card?.Type != CardType.Character)
            continue;

        if (IsLearnToPlayBattle &&
            !TutorialAllowsCard(card))
            continue;

        int cost =
            player.CharacterDefeatedSinceLastPlacement
                ? 0
                : player.ActiveCharacter != null
                    ? 4
                    : card.Cost;

        if (player.Energy >= cost)
            return true;
    }

    return false;
}

private bool IsFinishedTournamentMatch =>
    Session.CurrentMatch != null &&
    finishedTournamentMatch &&
    IsBattleFinished;

private bool HasNextTournamentRound =>
    IsFinishedTournamentMatch &&
    Session.Tournament.IsActive &&
    !Session.Tournament.IsCompleted;

private bool IsTournamentChampion =>
    IsFinishedTournamentMatch &&
    Session.Tournament.IsCompleted &&
    Session.Tournament.PlayerWonTournament &&
    Session.Tournament.HasMasterStrategistTitle;

private void ReturnToTournament()
{
    showZeroEnergyDialog = false;
    observingFinishedMatch = false;
    Session.CurrentMatch = null;
    finishedTournamentMatch = false;
    allowNavigation = true;

    Navigation.NavigateTo("/tournament");
}

private void ContinueTournament()
{
    showZeroEnergyDialog = false;
    observingFinishedMatch = false;
    Session.CurrentMatch = null;
    finishedTournamentMatch = false;
    allowNavigation = true;

    Navigation.NavigateTo("/tournament");
}
private string GetTutorialFocusClass(
    params string[] targets)
{
    if (!IsGuidedTutorialBattle)
    {
        return "";
    }

    return targets.Any(target =>
        string.Equals(
            TutorialTarget,
            target,
            StringComparison.OrdinalIgnoreCase))
        ? "tutorial-focus"
        : "";
}

private string GetDeckClass(
    Player player)
{
    string interactionClass =
        CanUseDeckAction(player)
            ? "deck-clickable"
            : "deck-disabled";

    string tutorialClass =
        GetTutorialFocusClass(
            "player-deck",
            "deck");

    return
        $"deck {interactionClass} {tutorialClass}";
}
private string GetTutorialHandFocusClass()
{
    if (!IsGuidedTutorialBattle)
    {
        return "";
    }

    TutorialStep? currentStep =
        TutorialManager.GetCurrentStep(
            Session.Tutorial);

    bool isHandInformationStep =
        string.Equals(
            TutorialTarget,
            "player-hand",
            StringComparison.OrdinalIgnoreCase) ||
        string.Equals(
            TutorialTarget,
            "hand-area",
            StringComparison.OrdinalIgnoreCase) ||
        string.Equals(
            currentStep?.Title,
            "Your Hand",
            StringComparison.OrdinalIgnoreCase);

    if (isHandInformationStep)
    {
        return "tutorial-focus";
    }

    return RequiredTutorialAction switch
    {
        TutorialAction.SelectUtility =>
            "tutorial-focus",

        TutorialAction.PlayUtility =>
            "tutorial-focus",

        TutorialAction.DiscardAndDraw =>
            "tutorial-focus",

        TutorialAction.DeployCharacter =>
            "tutorial-focus",

        TutorialAction.DeployAttack =>
            "tutorial-focus",

        _ =>
            ""
    };
}
private string GetReplacementChoiceClass(
    HandSlot slot)
{
    if (!IsLearnToPlayBattle ||
        RequiredTutorialAction !=
            TutorialAction.ReplaceAttack ||
        slot.CardInSlot == null)
    {
        return "";
    }

    return string.Equals(
        slot.CardInSlot.Id,
        "AM3",
        StringComparison.OrdinalIgnoreCase)
        ? "tutorial-replacement-choice"
        : "tutorial-nonreplacement-choice";
}
private string GetTutorialHandCardClass(
    HandSlot slot)
{
    if (!IsLearnToPlayBattle ||
        slot.CardInSlot == null)
    {
        return "";
    }

    if (RequiredTutorialAction ==
        TutorialAction.DiscardAndDraw)
    {
        return string.Equals(
            slot.CardInSlot.Id,
            "AN1",
            StringComparison.OrdinalIgnoreCase)
            ? "tutorial-hand-card-target"
            : "tutorial-hand-card-disabled";
    }

    if (RequiredTutorialAction ==
        TutorialAction.SelectUtility)
    {
        return string.Equals(
            slot.CardInSlot.Id,
            "UM1",
            StringComparison.OrdinalIgnoreCase)
            ? "tutorial-hand-card-target"
            : "tutorial-hand-card-disabled";
    }

    return "";
}
