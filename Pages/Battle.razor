    if (!IsLearnToPlayBattle)
    {
        return true;
    }

    Card card =
        slot.CardInSlot;

    if (RequiredTutorialAction ==
        TutorialAction.DeployAttack)
    {
        return TutorialAllowsCard(
            card);
    }

    if (RequiredTutorialAction ==
        TutorialAction.ReplaceAttack)
    {
        return string.Equals(
            card.Id,
            "AM3",
            StringComparison.OrdinalIgnoreCase);
    }

    return false;
}
private bool CanChoosePlacementCharacter(Card card)
{
    if (!IsLearnToPlayBattle) return true;

    return RequiredTutorialAction == TutorialAction.DeployCharacter &&
           TutorialAllowsCard(card);
}

private bool CanPerformDeckTutorialAction(TutorialAction action) =>
    !IsGuidedTutorialBattle || RequiredTutorialAction == action;

private bool CanContinuePhase(
    Player player)
{
    MatchState? match =
        Session.CurrentMatch;

    if (match == null ||
        IsBattleFinished ||
        botIsActing ||
        showPassDeviceDialog ||
        awaitingWandererEntry ||
        !coinFlipAcknowledged ||
        match.GetActingPlayer() != player)
    {
        return false;
    }

    if (IsGuidedTutorialBattle &&
        RequiredTutorialAction !=
            TutorialAction.ContinuePhase)
    {
        return false;
    }

    /*
        DSA tutorials require at least one deployed
        Attack before leaving the Placement Phase.

        This creates an empty hand slot so the later
        recycle and End Phase draw remain visible.
    */
    if (IsDsaTutorialBattle &&
        match.CurrentPhase ==
            MatchPhase.Placement &&
        !HasDeployedAttack(
            player))
    {
        return false;
    }

    if (match.CurrentPhase ==
            MatchPhase.Placement &&
        HasUnresolvedFatigue(
            player))
    {
        return false;
    }

    return true;
}

private bool IsContinueDisabled(
    Player player) =>
    !CanContinuePhase(player);

