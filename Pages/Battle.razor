private bool CanUseDeckAction(Player player)
{
    MatchState? match =
        Session.CurrentMatch;

    if (match == null ||
        IsBattleFinished ||
        botIsActing ||
        match.CurrentPhase != MatchPhase.Utility ||
        match.GetActingPlayer() != player ||
        player.Deck.RuntimeStorage == null ||
        player.Deck.RuntimeStorage.Count == 0 ||
        player.Deck.Structure ==
            DeckStructure.PriorityQueue)
    {
        return false;
    }

    if (IsGuidedTutorialBattle)
    {
        TutorialAction required =
            RequiredTutorialAction;

        bool correctAction =
            (
                required ==
                    TutorialAction.PeekDeck &&
                player.Deck.Structure is
                    (DeckStructure.Queue or
                     DeckStructure.Stack)
            ) ||
            (
                required ==
                    TutorialAction.ViewDrawPool &&
                player.Deck.Structure ==
                    DeckStructure.RandomList
            ) ||
            (
                required ==
                    TutorialAction.StartReorderNodes &&
                player.Deck.Structure ==
                    DeckStructure.LinkedList
            );

        if (!correctAction)
        {
            return false;
        }
    }

    bool freePeek =
        CharacterManager.HasPassive(
            player,
            "FreePeek");

    bool peekStructure =
        player.Deck.Structure is
            DeckStructure.Queue or
            DeckStructure.Stack or
            DeckStructure.RandomList;

    if (peekStructure &&
        !freePeek &&
        player.UtilityActionsRemaining <= 0)
    {
        return false;
    }

    if (player.Deck.Structure ==
            DeckStructure.LinkedList &&
        player.UtilityActionsRemaining <= 0)
    {
        return false;
    }

    return true;
}

private void SelectDeckAction(Player player)
{
    if (CanUseDeckAction(player)) showDeckAction = true;
}

private void CloseDeckAction() => showDeckAction = false;

private void PeekSelectedDeck()
{
    if (Session.CurrentMatch == null)
