private void DiscardSelectedCard()
{
    if (Session.CurrentMatch == null ||
        selectedHandSlot?.CardInSlot == null ||
        !TutorialAllows(
            TutorialAction.DiscardAndDraw))
    {
        return;
    }

    if (IsLearnToPlayBattle &&
        RequiredTutorialAction ==
            TutorialAction.DiscardAndDraw &&
        !string.Equals(
            selectedHandSlot.CardInSlot.Id,
            "AN1",
            StringComparison.OrdinalIgnoreCase))
    {
        return;
    }

    MatchState match =
        Session.CurrentMatch;

    Player player =
        GetPresentedPlayer();

    if (match.CurrentPhase !=
            MatchPhase.Utility ||
        match.GetActingPlayer() != player ||
        player.UtilityActionsRemaining <= 0)
    {
        return;
    }

    bool success =
        UtilityManager.DiscardAndDraw(
            player,
            selectedHandSlot.SlotNumber);

    if (!success)
    {
        return;
    }

    player.UtilityActionsRemaining--;

    selectedHandSlot =
        null;

    NotifyTutorialAction(
        TutorialAction.DiscardAndDraw);

    StateHasChanged();
}

private void PlaySelectedUtility()
{
    if (Session.CurrentMatch == null ||
        selectedHandSlot?.CardInSlot == null ||
        !TutorialAllows(TutorialAction.PlayUtility))
        return;

    MatchState match = Session.CurrentMatch;
    Player player = GetPresentedPlayer();
    Card card = selectedHandSlot.CardInSlot;

    if (match.CurrentPhase != MatchPhase.Utility ||
        match.GetActingPlayer() != player ||
        player.UtilityActionsRemaining <= 0 ||
        card.Type != CardType.Utility ||
        player.Energy < card.Cost)
        return;

    if (IsLearnToPlayBattle && card.Id != "UM1")
        return;

    bool success = UtilityManager.PlayUtility(
        player,
        GetPresentedOpponent(),
        selectedHandSlot.SlotNumber);

    if (!success) return;

    player.UtilityActionsRemaining--;
    selectedHandSlot = null;

    NotifyTutorialAction(TutorialAction.PlayUtility);
    StateHasChanged();
}

