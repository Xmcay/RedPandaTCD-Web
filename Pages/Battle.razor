private bool HasLegalPlayerAction(Player player)
{
    if (Session.CurrentMatch == null)
        return false;

    return Session.CurrentMatch.CurrentPhase switch
    {
        MatchPhase.Utility =>
            HasLegalUtilityAction(player),

        MatchPhase.Placement =>
            HasLegalPlacementAction(player),

        MatchPhase.Attack =>
            HasLegalAttackAction(player),

        _ => false
    };
}

private bool HasLegalUtilityAction(Player player)
{
    bool deckHasCards =
        player.Deck.RuntimeStorage != null &&
        player.Deck.RuntimeStorage.Count > 0;

    bool freePeek =
        CharacterManager.HasPassive(
            player,
            "FreePeek");

    if (freePeek &&
        deckHasCards &&
        player.Deck.Structure is
            DeckStructure.Queue or
            DeckStructure.Stack or
            DeckStructure.RandomList)
        return true;

    if (player.UtilityActionsRemaining <= 0)
        return false;

    if (player.HandSlots.Any(slot =>
            !slot.IsEmpty))
        return true;

bool supportsDeckAction =
    player.Deck.Structure is
        DeckStructure.Queue or
        DeckStructure.Stack or
        DeckStructure.RandomList or
        DeckStructure.LinkedList;

return
    deckHasCards &&
    supportsDeckAction;
}

private bool HasLegalPlacementAction(Player player)
{
    if (HasUnresolvedFatigue(player))
        return true;

    foreach (HandSlot slot in player.HandSlots)
    {
        Card? card = slot.CardInSlot;

        if (card == null) continue;

        if (card.Type == CardType.Character)
        {
            int cost =
                player.CharacterDefeatedSinceLastPlacement
                    ? 0
                    : player.ActiveCharacter != null
                        ? 4
                        : card.Cost;

            if (player.Energy >= cost)
                return true;
        }

        if (card.Type == CardType.Attack)
        {
            int cost = card.Cost;

            if (player.DiscountActive)
                cost = Math.Max(0, cost - 1);

            if (player.Energy >= cost)
                return true;
        }
    }

    return false;
}

private bool HasLegalAttackAction(Player player)
{
    bool slot1 =
        player.AttackSlot1 != null &&
        !player.IsFatiguedSlot1 &&
        !player.IsRestingSlot1 &&
        !player.AttackSlot1UsedThisPhase &&
        player.Energy >=
            player.AttackSlot1TotalUses;

    bool slot2 =
        player.AttackSlot2 != null &&
        !player.IsFatiguedSlot2 &&
        !player.IsRestingSlot2 &&
        !player.AttackSlot2UsedThisPhase &&
        player.Energy >=
            player.AttackSlot2TotalUses;

    bool ability =
        player.ActiveCharacter != null &&
        !player.CharacterNewlyDeployed &&
        !player.AbilityUsedThisPhase &&
        player.AbilityCooldownRemaining <= 0 &&
        CanAffordCharacterAbility(player);

    return slot1 || slot2 || ability;
}

private bool CanAffordCharacterAbility(Player player)
{
    if (player.ActiveCharacter == null)
        return false;

    int cost =
        player.ActiveCharacter.ActiveAbility switch
        {
            "ShieldGain" => 2,
            "MagicBoost" => 1,
            "FieldShield" => 3,
            "PowerSurge" => 3,
            "AttackBoost" => 2,
            "Heal" => 2,
            _ => int.MaxValue
        };

    return player.Energy >= cost;
}

