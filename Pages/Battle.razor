private async Task ContinuePhase()
{
    if (Session.CurrentMatch == null)
    {
        return;
    }

    MatchState match =
        Session.CurrentMatch;

    Player player =
        GetPresentedPlayer();

    /*
        Use the exact same condition as the button.

        This prevents the UI from enabling Continue
        while the handler silently rejects the click
        through a different condition.
    */
    if (!CanContinuePhase(player))
    {
        return;
    }

    MatchPhase previousPhase =
        match.CurrentPhase;

    int previousTurn =
        match.TurnNumber;

    TutorialAction actionBeforePhaseChange =
        RequiredTutorialAction;

    CloseGameplayPopups();

    PhaseManager.CompleteCurrentPlayerPhase(
        match);

    /*
        Advance the Tutorial using the action captured
        before the real phase changed.
    */
    if (IsGuidedTutorialBattle &&
        actionBeforePhaseChange ==
            TutorialAction.ContinuePhase)
    {
        NotifyTutorialAction(
            TutorialAction.ContinuePhase);
    }

    if (MatchManager.IsMatchOver(
            match.Player1,
            match.Player2))
    {
        CheckForZeroEnergy();
        return;
    }

    if (IsPassAndPlay())
    {
        showPassDeviceDialog = true;
        StateHasChanged();
        return;
    }

    /*
        If Stack Placement begins immediately after the
        human phase transition, resolve it before Bot
        processing only when the human is now acting.
    */
    await RunAutomaticHumanPlacementIfNeeded();

    await RunBotIfNeeded();

    if (MatchManager.IsMatchOver(
            match.Player1,
            match.Player2))
    {
        CheckForZeroEnergy();
        return;
    }

    /*
        The Bot may have advanced the match to a new
        human Stack Placement Phase.
    */
    await RunAutomaticHumanPlacementIfNeeded();

    await HandleTutorialPhaseTransition(
        previousPhase,
        previousTurn);

    StateHasChanged();
}
private async Task HandleTutorialPhaseTransition(
    MatchPhase previousPhase,
    int previousTurn)
{
    if (!IsGuidedTutorialBattle ||
        Session.CurrentMatch == null)
    {
        return;
    }

    MatchState match =
        Session.CurrentMatch;

    if (previousPhase == MatchPhase.End &&
        match.TurnNumber > previousTurn &&
        IsDsaTutorialBattle)
    {
        await ResolveDsaRecycleDemonstration();
    }
}
private async Task RunBotIfNeeded()
{
    if (Session.CurrentMatch == null || botIsActing)
        return;

    MatchState match = Session.CurrentMatch;
    Player actingPlayer = match.GetActingPlayer();

    if (!actingPlayer.IsBot) return;

    Player bot = actingPlayer;
    Player human = match.GetOpponent();

    botIsActing = true;
    logCollapsed = false;

    CloseGameplayPopups();
    StateHasChanged();

    try
    {
        while (Session.CurrentMatch != null &&
               !match.IsCompleted &&
               !MatchManager.IsMatchOver(
                   match.Player1,
                   match.Player2) &&
               match.GetActingPlayer() == bot)
        {
            MatchPhase phaseBefore = match.CurrentPhase;
            int turnBefore = match.TurnNumber;

            switch (match.CurrentPhase)
            {
                case MatchPhase.Utility:
                    await RunBotUtilityPhase(bot, human);
                    break;

                case MatchPhase.Placement:
                    await RunBotPlacementPhase(bot);
                    break;

                case MatchPhase.Attack:
                    await RunBotAttackPhase(bot, human);
                    break;

                case MatchPhase.End:
                    await BotThinkingDelay();
                    break;
            }

            if (MatchManager.IsMatchOver(
                    match.Player1,
                    match.Player2))
            {
                CheckForZeroEnergy();
                return;
            }

PhaseManager.CompleteCurrentPlayerPhase(
    match);

await HandleTutorialPhaseTransition(
    phaseBefore,
    turnBefore);

/*
    DSA tutorials demonstrate one complete turn.

    After the Bot finishes Turn 1 End Phase,
    Initiative swaps and Turn 2 begins. Stop the
    Bot here so it cannot perform Turn 2 Utility.
*/
if (IsDsaTutorialBattle &&
    match.TurnNumber > turnBefore)
{
    StateHasChanged();

    break;
}

StateHasChanged();
        }
    }
    finally
    {
        botIsActing = false;
        StateHasChanged();
    }
}

private async Task RunBotUtilityPhase(
    Player bot,
    Player human)
{
    await BotThinkingDelay();

    int before =
        BattleLog.GetPhaseActions().Count;

    BotManager.RunNextUtilityAction(bot, human);

    if (BattleLog.GetPhaseActions().Count == before)
        BattleLog.Write(
            $"{bot.Name} took no Utility action.");

    StateHasChanged();
}

private async Task RunBotPlacementPhase(Player bot)
{
    int before =
        BattleLog.GetPhaseActions().Count;

    for (int step = 0; step <= 4; step++)
    {
        await BotThinkingDelay();
        BotManager.RunNextPlacementAction(bot, step);
        StateHasChanged();
    }

    if (BattleLog.GetPhaseActions().Count == before)
    {
        BattleLog.Write(
            $"{bot.Name} made no Placement changes.");

        StateHasChanged();
    }
}

private async Task RunBotAttackPhase(
    Player bot,
    Player human)
{
    int before =
        BattleLog.GetPhaseActions().Count;

    for (int step = 0; step <= 2; step++)
    {
        if (MatchManager.IsMatchOver(bot, human))
            return;

        await BotThinkingDelay();

        BotManager.RunNextAttackAction(
            bot,
            human,
            step);

        if (CheckForZeroEnergy())
        {
            StateHasChanged();
            return;
        }

        StateHasChanged();
    }

    if (BattleLog.GetPhaseActions().Count == before)
    {
        BattleLog.Write(
            $"{bot.Name} made no attacks.");

        StateHasChanged();
    }
}

private async Task BotThinkingDelay()
{
    StateHasChanged();

    await Task.Delay(
        Random.Shared.Next(500, 1501));
}

