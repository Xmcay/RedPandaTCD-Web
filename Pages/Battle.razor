private async Task RunAutomaticHumanPlacementIfNeeded()
{
    if (Session.CurrentMatch == null)
        return;

    MatchState match = Session.CurrentMatch;

    if (match.CurrentPhase != MatchPhase.Placement)
        return;

    Player player = GetPresentedPlayer();

    if (player.IsBot ||
        player.Deck.Structure != DeckStructure.Stack)
        return;

    StateHasChanged();

    await Task.Delay(
        Random.Shared.Next(500, 1501));

    if (Session.CurrentMatch == null ||
        match.IsCompleted ||
        match.CurrentPhase != MatchPhase.Placement ||
        match.GetActingPlayer() != player)
        return;

    PlacementManager.AutoStackPlacement(player);

    if (IsDsaTutorialBattle &&
        Session.Tutorial.CurrentTutorial ==
            TutorialType.Stack)
    {
        NotifyTutorialAction(
            TutorialAction.ObserveAutomaticPlacement);
    }

    CheckForZeroEnergy();
    StateHasChanged();
}
private bool CanSelectPlacementAttack(
    Player player)
{
    MatchState? match =
        Session.CurrentMatch;

    if (match == null ||
        IsBattleFinished ||
        botIsActing ||
        match.CurrentPhase !=
            MatchPhase.Placement ||
        match.GetActingPlayer() != player)
    {
        return false;
    }

    if (!IsGuidedTutorialBattle ||
        IsDsaTutorialBattle)
    {
        return true;
    }

    return RequiredTutorialAction is
        TutorialAction.DeployAttack or
        TutorialAction.ReplaceAttack or
        TutorialAction.RestAttack or
        TutorialAction.ResolveWandererEntry;
}

private void SelectPlacementAttack(int slot)
{
    if (Session.CurrentMatch == null ||
        slot is not (1 or 2))
        return;

    Player player = GetPresentedPlayer();

    if (!CanSelectPlacementAttack(player))
        return;

    if (awaitingWandererEntry)
    {
        ResolveWandererEntrySelection(player, slot);
        return;
    }

    Card? deployed =
        slot == 1
            ? player.AttackSlot1
            : player.AttackSlot2;

    bool fatigued =
        slot == 1
            ? player.IsFatiguedSlot1
            : player.IsFatiguedSlot2;

if (IsLearnToPlayBattle &&
    RequiredTutorialAction ==
        TutorialAction.ReplaceAttack &&
    (deployed == null ||
     !string.Equals(
         deployed.Id,
         "AP4",
         StringComparison.OrdinalIgnoreCase)))
{
    return;
}

if (IsLearnToPlayBattle &&
    RequiredTutorialAction ==
        TutorialAction.RestAttack &&
    (deployed == null ||
     !TutorialAllowsCard(deployed)))
{
    return;
}

    if (fatigued)
    {
        selectedPlacementAttackSlot = slot;
        showFatiguedAttackActions = true;
        return;
    }

    if (RequiredTutorialAction == TutorialAction.RestAttack)
        return;

    if (deployed != null &&
        !player.HandSlots.Any(handSlot =>
            !handSlot.IsEmpty &&
            handSlot.CardInSlot?.Type ==
                CardType.Attack))
        return;

    selectedPlacementAttackSlot = slot;
}

private void ClosePlacementAttack() =>
    selectedPlacementAttackSlot = null;

private void DeployAttackFromHand(int handSlotNumber)
{
    if (Session.CurrentMatch == null ||
        selectedPlacementAttackSlot == null ||
        handSlotNumber < 1 ||
        handSlotNumber > Player.MAX_HAND_SIZE)
        return;

    Player player = GetPresentedPlayer();

    if (!CanSelectPlacementAttack(player))
        return;

    HandSlot handSlot =
        player.HandSlots[handSlotNumber - 1];

    if (!CanChoosePlacementAttack(handSlot))
        return;

    Card selectedAttack =
        handSlot.CardInSlot!;

    int fieldSlot =
        selectedPlacementAttackSlot.Value;

    Card? previous =
        fieldSlot == 1
            ? player.AttackSlot1
            : player.AttackSlot2;

    TutorialAction completedAction =
        previous == null
            ? TutorialAction.DeployAttack
            : TutorialAction.ReplaceAttack;

    if (IsLearnToPlayBattle &&
    RequiredTutorialAction != completedAction)
{
    return;
}

    int cost = selectedAttack.Cost;

    if (player.DiscountActive)
        cost = Math.Max(0, cost - 1);

    if (WouldReachZeroEnergy(player, cost))
    {
        if (IsGuidedTutorialBattle) return;

        selectedPlacementAttackSlot = null;

        WarnBeforeZeroEnergy(() =>
            PlacementManager.TryDeployAttack(
                player,
                handSlotNumber,
                fieldSlot));

        return;
    }

    bool success =
        PlacementManager.TryDeployAttack(
            player,
            handSlotNumber,
            fieldSlot);

    if (!success) return;

    selectedPlacementAttackSlot = null;

    if (IsLearnToPlayBattle)
{
    NotifyTutorialAction(
        completedAction);
}
    CheckForZeroEnergy();
    StateHasChanged();
}

private void DeploySelectedAttack(HandSlot slot) =>
    DeployAttackFromHand(slot.SlotNumber);

