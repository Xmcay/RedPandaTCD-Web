}

.result-card {
    min-width: 0;
    padding: 12px 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    border: 1px solid #52606c;
    border-radius: 7px;
    background: #1a252f;
    text-align: center;
}

.result-card span {
    color: #919ca6;
    font-size: 7px;
    font-weight: 900;
    letter-spacing: .6px;
}

.result-card strong {
