    // ==========================
    // BOT SIMULATOR
    // ==========================

   
private async Task RunSimulations(int matchCount)
{
    results = new SimulationResults
    {
        RequestedMatches = matchCount
    };

    singleMatchLog.Clear();

    if (DeckManager.Decks.Count < 2)
    {
        results.Exceptions++;

        results.Diagnostics.Add(
            "At least two decks are required.");

        return;
    }

    player1DeckIndex = Math.Clamp(
        player1DeckIndex,
        0,
        DeckManager.Decks.Count - 1);

    player2DeckIndex = Math.Clamp(
        player2DeckIndex,
        0,
        DeckManager.Decks.Count - 1);

    for (int matchNumber = 1;
         matchNumber <= matchCount;
         matchNumber++)
    {
        // Allow Blazor and the browser to process UI updates.
        await Task.Yield();

        try
        {
            RunSingleSimulation(
                matchNumber,
                matchCount);
        }
        catch (Exception exception)
        {
            results.Exceptions++;

            if (results.Diagnostics.Count < 20)
            {
                results.Diagnostics.Add(
                    $"Match {matchNumber}: " +
                    exception.Message);
            }
        }

        // Refresh the UI periodically during larger batches.
        if (matchNumber % 10 == 0 ||
            matchNumber == matchCount)
        {
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
        }
    }

    if (results.CompletedMatches > 0)
    {
        results.AverageTurns =
            (double)results.TotalTurns /
            results.CompletedMatches;
    }
}


    private void RunSingleSimulation(
        int matchNumber,
        int requestedMatches)
    {
        Deck player1Deck =
            DeckManager.Decks[
                player1DeckIndex];

        Deck player2Deck =
            DeckManager.Decks[
                player2DeckIndex];

        Player bot1 =
            new Player
            {
                Name =
                    "Bot 1",

                IsBot =
                    true,

                Deck =
                    DeckCloner.Clone(
                        player1Deck)
            };

        Player bot2 =
            new Player
            {
                Name =
                    "Bot 2",

                IsBot =
                    true,

                Deck =
                    DeckCloner.Clone(
                        player2Deck)
            };

        MatchState match =
            BattleEngine.StartMatch(
                bot1,
                bot2,
                GameMode.BotMatch);

        // Explicitly register the exact runtime decks
        // used by this simulated match for replay export.
        BattleLog.SetReplayDeck(
            1,
            bot1.Deck);

        BattleLog.SetReplayDeck(
            2,
            bot2.Deck);

        int simulationSteps =
            0;

        const int maxSimulationSteps =
            1000;

        string? stopReason =
            null;

        while (!MatchManager.IsMatchOver(
                   match.Player1,
                   match.Player2) &&
               simulationSteps <
                   maxSimulationSteps)
        {
            bool progressed =
                PhaseManager
                    .RunBotPhaseIfNeeded(
                        match);

            if (!progressed)
            {
                stopReason =
                    "RunBotPhaseIfNeeded returned false " +
                    "before the match was terminal.";

                break;
            }

            simulationSteps++;
        }

        if (!MatchManager.IsMatchOver(
                match.Player1,
                match.Player2))
        {
            results!.StalledMatches++;

            if (results.Diagnostics.Count < 20)
            {
                string reason =
                    stopReason ??
                    $"Reached the {maxSimulationSteps}-step " +
                    "Simulator safety limit.";

                Player actingPlayer =
                    match.GetActingPlayer();

                results.Diagnostics.Add(
                    $"STALL | " +
                    $"Match={matchNumber} | " +
                    $"Reason={reason} | " +
                    $"SimulationSteps={simulationSteps} | " +
                    $"EngineTurn={match.TurnNumber} | " +
                    $"Phase={match.CurrentPhase} | " +
                    $"Acting={actingPlayer.Name} | " +
                    $"Bot1Energy={match.Player1.Energy} | " +
                    $"Bot2Energy={match.Player2.Energy} | " +
                    $"Bot1Deck=" +
                    $"{match.Player1.Deck.RuntimeStorage?.Count ?? 0} | " +
                    $"Bot2Deck=" +
                    $"{match.Player2.Deck.RuntimeStorage?.Count ?? 0}");
            }

            if (requestedMatches == 1)
            {
                singleMatchLog =
                    BattleLog
                        .GetPhaseActions()
                        .ToList();
            }

            return;
        }

        bool isDraw =
            MatchManager.IsDraw(
                match.Player1,
                match.Player2);

        Player? winner =
            BattleEngine.CompleteMatch(
                match);

        if (isDraw ||
            match.IsDraw)
        {
            RecordCompletedMatch(
                match);

            if (requestedMatches == 1)
            {
                singleMatchLog =
                    BattleLog
                        .GetPhaseActions()
                        .ToList();
            }

            return;
        }

        if (winner == null)
        {
            results!.StalledMatches++;

            if (results.Diagnostics.Count < 20)
            {
                results.Diagnostics.Add(
                    $"Match {matchNumber}: " +
                    "terminal state returned no winner " +
                    "and was not a draw. " +
                    $"Turn={match.TurnNumber}, " +
                    $"Phase={match.CurrentPhase}, " +
                    $"Bot1Energy={match.Player1.Energy}, " +
                    $"Bot2Energy={match.Player2.Energy}, " +
                    $"Bot1Surrendered=" +
                    $"{match.Player1.HasSurrendered}, " +
                    $"Bot2Surrendered=" +
                    $"{match.Player2.HasSurrendered}.");
            }

            if (requestedMatches == 1)
            {
                singleMatchLog =
                    BattleLog
                        .GetPhaseActions()
                        .ToList();
            }

            return;
        }

        RecordCompletedMatch(
            match);

        if (requestedMatches == 1)
        {
            singleMatchLog =
                BattleLog
                    .GetPhaseActions()
                    .ToList();
        }
    }

    private void RecordCompletedMatch(
        MatchState match)
    {
        if (results == null)
        {
            return;
        }

        results.CompletedMatches++;

        results.TotalTurns +=
            match.TurnNumber;

        if (results.ShortestMatch == 0 ||
            match.TurnNumber <
                results.ShortestMatch)
        {
            results.ShortestMatch =
                match.TurnNumber;
        }

        if (match.TurnNumber >
            results.LongestMatch)
        {
            results.LongestMatch =
                match.TurnNumber;
        }

        if (match.IsDraw)
        {
            results.Draws++;
            return;
        }

        Player? winner =
            MatchManager.GetWinner(
                match.Player1,
                match.Player2);

        if (winner == match.Player1)
        {
            results.Player1Wins++;
        }
        else if (winner == match.Player2)
        {
            results.Player2Wins++;
        }
        else
        {
            results.Draws++;
        }
    }

