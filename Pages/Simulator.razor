@page "/simulator"
@using RedPandaTCD_Web.Game
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject GameSessionState Session
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Battle Simulator - Red Panda TCD</PageTitle>

<div class="simulator-page @GetPageTutorialClass("simulator-page")">

    <section class="simulator-panel">

        <div class="simulator-header">

            <div>
                <h1>Battle Simulator</h1>

                <p>
                    Run automated Bot-vs-Bot matches through the real game engine,
                    or load a recorded battle replay.
                </p>
            </div>

            <button class="back-button"
                    @onclick="GoHome">
                Main Menu
            </button>

        </div>

        <div class="mode-tabs">

            <button class="mode-tab @(simulatorMode == SimulatorMode.BotFighter ? "active" : "")"
                    @onclick="() => SetSimulatorMode(SimulatorMode.BotFighter)">
                Bot Fighter
            </button>

            <button class="mode-tab @(simulatorMode == SimulatorMode.Replay ? "active" : "")"
                    @onclick="() => SetSimulatorMode(SimulatorMode.Replay)">
                Battle Replay
            </button>

        </div>

        @if (simulatorMode == SimulatorMode.BotFighter)
        {
            <section class="simulator-section">

                <div class="deck-grid">

                    <div class="deck-select-group @GetPageTutorialClass("bot-one-deck")">

                        <label>
                            BOT 1 DECK
                        </label>

                        <select @bind="player1DeckIndex">

                            @for (int i = 0;
                                  i < DeckManager.Decks.Count;
                                  i++)
                            {
                                int index = i;

                                Deck deck =
                                    DeckManager.Decks[index];

                                <option value="@index">
                                    @deck.Name (@GetStructureName(deck.Structure))
                                </option>
                            }

                        </select>

                    </div>

                    <div class="deck-select-group @GetPageTutorialClass("bot-two-deck")">

                        <label>
                            BOT 2 DECK
                        </label>

                        <select @bind="player2DeckIndex">

                            @for (int i = 0;
                                  i < DeckManager.Decks.Count;
                                  i++)
                            {
                                int index = i;

                                Deck deck =
                                    DeckManager.Decks[index];

                                <option value="@index">
                                    @deck.Name (@GetStructureName(deck.Structure))
                                </option>
                            }

                        </select>

                    </div>

                </div>

                <div class="simulation-controls @GetPageTutorialClass("simulation-controls")">

                    <button @onclick="() => RunSimulations(1)">
                        Run 1 Match
                    </button>

                    <button @onclick="() => RunSimulations(10)">
                        Run 10
                    </button>

                    <button @onclick="() => RunSimulations(100)">
                        Run 100
                    </button>

                    <button @onclick="() => RunSimulations(1000)">
                        Run 1000
                    </button>

                </div>

                @if (results != null)
                {
                    <section class="results @GetPageTutorialClass("simulation-results")">

                        <h2>
                            Results
                        </h2>

                        <div class="result-grid">

                            <div class="result-card">
                                <span>MATCHES</span>
                                <strong>@results.RequestedMatches</strong>
                            </div>

                            <div class="result-card success">
                                <span>COMPLETED</span>
                                <strong>@results.CompletedMatches</strong>
                            </div>

                            <div class="result-card danger">
                                <span>STALLED</span>
                                <strong>@results.StalledMatches</strong>
                            </div>

                            <div class="result-card danger">
                                <span>EXCEPTIONS</span>
                                <strong>@results.Exceptions</strong>
                            </div>

                            <div class="result-card bot-one">
                                <span>BOT 1 WINS</span>
                                <strong>@results.Player1Wins</strong>
                            </div>

                            <div class="result-card draw">
                                <span>DRAWS</span>
                                <strong>@results.Draws</strong>
                            </div>

                            <div class="result-card bot-two">
                                <span>BOT 2 WINS</span>
                                <strong>@results.Player2Wins</strong>
                            </div>

                            <div class="result-card">
                                <span>AVERAGE TURNS</span>
                                <strong>
                                    @results.AverageTurns.ToString("0.00")
                                </strong>
                            </div>

                            <div class="result-card">
                                <span>LONGEST MATCH</span>
                                <strong>@results.LongestMatch</strong>
                            </div>

                            <div class="result-card">
                                <span>SHORTEST MATCH</span>
                                <strong>@results.ShortestMatch</strong>
                            </div>

                        </div>

                        @if (results.StalledMatches > 0 ||
                             results.Exceptions > 0)
                        {
                            <div class="warning-box">
                                Simulator detected a possible engine problem.
                                Check the diagnostics below.
                            </div>
                        }

                        @if (results.Diagnostics.Count > 0)
                        {
                            <div class="diagnostics">

                                <h3>
                                    Diagnostics
                                </h3>

                                @foreach (string message in results.Diagnostics)
                                {
                                    <div class="diagnostic-entry">
                                        @message
                                    </div>
                                }

                            </div>
                        }

                        @if (singleMatchLog.Count > 0)
                        {
                            <div class="single-log">

                                <div class="single-log-header">

                                    <h3>
                                        Last Single-Match Log
                                    </h3>

                                    <button class="copy-replay-button"
                                            @onclick="CopyLastReplay">
                                        @(replayCopied
                                            ? "Copied!"
                                            : "Copy Replay")
                                    </button>

                                </div>

                                @foreach (BattleLogEntry entry in singleMatchLog)
                                {
                                    <div class="log-line">

                                        <strong>
                                            [@entry.Label.ToUpperInvariant()]
                                        </strong>

                                        @entry.Message

                                    </div>
                                }

                            </div>
                        }

                    </section>
                }

            </section>
        }
        else
        {
            <section class="replay-section">

                <div class="replay-header">

                    <div>
                        <h2>
                            Battle Replay
                        </h2>

                        <p>
                            Paste structured Red Panda replay data to
                            validate and open the recorded match.
                        </p>
                    </div>

                </div>

                <div class="replay-deck-grid">

                    <div class="deck-select-group">

                        <label>
                            PLAYER 1 DECK
                        </label>

                        <select @bind="replayPlayer1DeckIndex">

                            @for (int i = 0;
                                  i < DeckManager.Decks.Count;
                                  i++)
                            {
                                int index = i;

                                Deck deck =
                                    DeckManager.Decks[index];

                                <option value="@index">
                                    @deck.Name (@GetStructureName(deck.Structure))
                                </option>
                            }

                        </select>

                    </div>

                    <div class="deck-select-group">

                        <label>
                            PLAYER 2 DECK
                        </label>

                        <select @bind="replayPlayer2DeckIndex">

                            @for (int i = 0;
                                  i < DeckManager.Decks.Count;
                                  i++)
                            {
                                int index = i;

                                Deck deck =
                                    DeckManager.Decks[index];

                                <option value="@index">
                                    @deck.Name (@GetStructureName(deck.Structure))
                                </option>
                            }

                        </select>

                    </div>

                </div>

                <div class="replay-input-panel">

                    <label for="replay-data">
                        REPLAY DATA
                    </label>

                    <textarea id="replay-data"
                              @bind="replayInput"
                              placeholder="Paste REDPANDA_REPLAY_V1 data here..."
                              spellcheck="false"></textarea>

                    <div class="replay-actions">

                        <button class="primary-replay-button"
                                @onclick="LoadReplay">
                            Load Replay
                        </button>

                        <button class="secondary-replay-button"
                                @onclick="ClearReplay">
                            Clear
                        </button>

                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(replayError))
                {
                    <div class="replay-error">
                        @replayError
                    </div>
                }

                @if (replayLoaded)
                {
                    <div class="replay-summary">

                        <div class="replay-summary-header">

                            <div>
                                <h3>
                                    Replay Loaded
                                </h3>

                                <p>
                                    The replay passed exact deck identity
                                    and event validation.
                                </p>
                            </div>

                            <span class="replay-valid">
                                VALID
                            </span>

                        </div>

                        <div class="replay-stat-grid">

                            <div class="replay-stat">
                                <span>EVENTS</span>
                                <strong>@replayEvents.Count</strong>
                            </div>

                            <div class="replay-stat">
                                <span>TURNS</span>
                                <strong>@GetReplayTurnCount()</strong>
                            </div>

                            <div class="replay-stat">
                                <span>DRAWS</span>
                                <strong>
                                    @GetReplayEventCount(
                                        BattleLogEventType.Draw)
                                </strong>
                            </div>

                            <div class="replay-stat">
                                <span>ACTIONS</span>
                                <strong>@GetVisibleReplayEventCount()</strong>
                            </div>

                        </div>

                        <div class="replay-deck-summary">

                            <div>
                                <span>
                                    PLAYER 1
                                </span>

                                <strong>
                                    @GetReplayDeckName(
                                        replayPlayer1DeckIndex)
                                </strong>

                                <small>
                                    @GetStructureName(
                                        DeckManager.Decks[
                                            replayPlayer1DeckIndex].Structure)
                                </small>
                            </div>

                            <div>
                                <span>
                                    PLAYER 2
                                </span>

                                <strong>
                                    @GetReplayDeckName(
                                        replayPlayer2DeckIndex)
                                </strong>

                                <small>
                                    @GetStructureName(
                                        DeckManager.Decks[
                                            replayPlayer2DeckIndex].Structure)
                                </small>
                            </div>

                        </div>

                        <div class="replay-event-preview">

                            <h3>
                                Recorded Events
                            </h3>

                            @foreach (BattleLogEntry entry
                                      in replayEvents.Take(12))
                            {
                                <div class="replay-event-line">

                                    <span class="replay-event-turn">
                                        T@entry.TurnNumber
                                    </span>

                                    <span class="replay-event-type">
                                        @entry.EventType
                                    </span>

                                    <span class="replay-event-message">
                                        @entry.Message
                                    </span>

                                </div>
                            }

                            @if (replayEvents.Count > 12)
                            {
                                <div class="replay-more">
                                    + @(replayEvents.Count - 12)
                                    more recorded events
                                </div>
                            }

                        </div>

                        <div class="replay-ready-box">

                            <strong>
                                Replay verified.
                            </strong>

                            <span>
                                The selected decks exactly match the decks
                                recorded in this replay.
                            </span>

                            <button class="open-replay-button"
                                    @onclick="OpenReplayInBattle">
                                Open Replay in Battle
                            </button>

                        </div>

                    </div>
                }

            </section>
        }

    </section>

</div>

<PageTutorialOverlay
    Visible="@showPageTutorial"
    Label="BATTLE SIMULATOR TUTORIAL"
    Steps="@SimulatorPageTutorialSteps"
    CurrentIndex="@pageTutorialStep"
    CurrentIndexChanged="SetPageTutorialStep"
    OnExit="ExitPageTutorial"
    OnFinished="FinishPageTutorial" />

<style>
* {
    box-sizing: border-box;
}

.simulator-page {
    min-height: calc(100vh - 58px);
    padding: 36px 20px;
    display: flex;
    justify-content: center;
    background:
        linear-gradient(
            160deg,
            #18212b 0%,
            #23364a 55%,
            #3a2428 100%
        );
    color: #f5f5f5;
}

.simulator-panel {
    width: min(950px, 100%);
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.simulator-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.simulator-header h1 {
    margin: 0;
    color: #f4efe3;
    font-size: clamp(30px, 4vw, 46px);
}

.simulator-header p {
    margin: 7px 0 0;
    color: #c8d0d8;
}

.back-button {
    padding: 11px 18px;
    border: 1px solid #9b9383;
    border-radius: 6px;
    background: #f4efe3;
    color: #222;
    cursor: pointer;
    font-weight: bold;
}

.back-button:hover {
    background: #e5ddcc;
}

.mode-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.mode-tab {
    padding: 13px 16px;
    border: 1px solid #596674;
    border-radius: 7px;
    background: #111820;
    color: #c8d0d8;
    cursor: pointer;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .7px;
    text-transform: uppercase;
}

.mode-tab:hover {
    border-color: #e5cc67;
    color: #f4efe3;
}

.mode-tab.active {
    border-color: #e5cc67;
    background: #2a3035;
    color: #e5cc67;
}

.simulator-section,
.replay-section {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.deck-grid,
.replay-deck-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
}

.deck-select-group {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    border: 1px solid #596674;
    border-radius: 9px;
    background: rgba(17, 24, 32, .9);
}

.deck-select-group label,
.replay-input-panel > label {
    color: #e5cc67;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .8px;
}

.deck-select-group select {
    width: 100%;
    padding: 11px 12px;
    border: 1px solid #8b949e;
    border-radius: 6px;
    background: #f4efe3;
    color: #222;
    font-size: 12px;
}

.deck-select-group select:focus {
    border-color: #e5cc67;
    outline: none;
    box-shadow:
        0 0 0 2px rgba(229, 204, 103, .18);
}

.simulation-controls {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
}

.simulation-controls button {
    padding: 13px 9px;
    border: 2px solid #9b9383;
    border-radius: 7px;
    background: #f4efe3;
    color: #222;
    cursor: pointer;
    font-size: 11px;
    font-weight: bold;
}

.simulation-controls button:hover {
    border-color: #e5cc67;
    background: #fff9e9;
    transform: translateY(-2px);
}

.results {
    padding: 20px;
    border: 1px solid #596674;
    border-radius: 10px;
    background: rgba(17, 24, 32, .93);
}

.results h2 {
    margin: 0 0 16px;
    color: #f4efe3;
}

.result-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 9px;
}

.result-card {
    min-width: 0;
    padding: 12px 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    border: 1px solid #52606c;
    border-radius: 7px;
    background: #1a252f;
    text-align: center;
}

.result-card span {
    color: #919ca6;
    font-size: 7px;
    font-weight: 900;
    letter-spacing: .6px;
}

.result-card strong {
    color: #f4efe3;
    font-size: 19px;
}

.result-card.success {
    border-color: #4e8d61;
}

.result-card.success strong {
    color: #81c784;
}

.result-card.danger {
    border-color: #985a5a;
}

.result-card.danger strong {
    color: #ef9a9a;
}

.result-card.bot-one {
    border-color: #5689d6;
}

.result-card.bot-one strong {
    color: #8faee0;
}

.result-card.bot-two {
    border-color: #cf5959;
}

.result-card.bot-two strong {
    color: #ef9a9a;
}

.result-card.draw {
    border-color: #b69d55;
}

.result-card.draw strong {
    color: #e5cc67;
}

.warning-box,
.replay-error {
    margin-top: 14px;
    padding: 11px 12px;
    border: 1px solid #985a5a;
    border-left: 4px solid #ef9a9a;
    border-radius: 6px;
    background: rgba(152, 70, 70, .12);
    color: #efb0b0;
    font-size: 11px;
}

.diagnostics,
.single-log,
.replay-header,
.replay-input-panel,
.replay-summary {
    padding: 18px;
    border: 1px solid #596674;
    border-radius: 9px;
    background: rgba(17, 24, 32, .9);
}

.diagnostics h3,
.single-log h3,
.replay-event-preview h3 {
    margin: 0 0 11px;
    color: #e5cc67;
    font-size: 14px;
}

.diagnostic-entry {
    margin-bottom: 6px;
    padding: 7px 8px;
    border-left: 3px solid #ef9a9a;
    background: rgba(255, 255, 255, .04);
    color: #c8d0d8;
    font-size: 10px;
    line-height: 1.4;
}

.single-log-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.single-log-header h3 {
    margin-bottom: 0;
}

.copy-replay-button {
    padding: 7px 11px;
    border: 1px solid #71808e;
    border-radius: 5px;
    background: #1c2731;
    color: #d8dee3;
    cursor: pointer;
    font-size: 9px;
    font-weight: bold;
}

.copy-replay-button:hover {
    border-color: #e5cc67;
    color: #e5cc67;
}

.log-line {
    margin-bottom: 5px;
    padding: 6px 7px;
    border-bottom: 1px solid #35414c;
    color: #c8d0d8;
    font-size: 10px;
    line-height: 1.4;
}

.log-line strong {
    margin-right: 5px;
    color: #e5cc67;
}

.replay-header h2 {
    margin: 0;
    color: #f4efe3;
}

.replay-header p {
    margin: 7px 0 0;
    color: #aeb8c0;
    font-size: 11px;
}

.replay-input-panel > label {
    display: block;
    margin-bottom: 9px;
}

.replay-input-panel textarea {
    width: 100%;
    min-height: 260px;
    resize: vertical;
    padding: 13px;
    border: 1px solid #596674;
    border-radius: 7px;
    outline: none;
    background: #0c1218;
    color: #d8dee3;
    font-family: Consolas, "Courier New", monospace;
    font-size: 10px;
    line-height: 1.45;
}

.replay-input-panel textarea:focus {
    border-color: #e5cc67;
    box-shadow:
        0 0 0 2px rgba(229, 204, 103, .12);
}

.replay-actions {
    margin-top: 12px;
    display: flex;
    gap: 9px;
}

.primary-replay-button,
.secondary-replay-button,
.open-replay-button {
    padding: 10px 17px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 10px;
    font-weight: 900;
}

.primary-replay-button {
    border: 2px solid #9b9383;
    background: #f4efe3;
    color: #222;
}

.primary-replay-button:hover {
    border-color: #e5cc67;
    background: #fff9e9;
}

.secondary-replay-button {
    border: 1px solid #596674;
    background: #1a252f;
    color: #c8d0d8;
}

.secondary-replay-button:hover {
    border-color: #e5cc67;
    color: #e5cc67;
}

.replay-summary-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
}

.replay-summary-header h3 {
    margin: 0;
    color: #f4efe3;
}

.replay-summary-header p {
    margin: 6px 0 0;
    color: #aeb8c0;
    font-size: 10px;
}

.replay-valid {
    padding: 6px 9px;
    border: 1px solid #4e8d61;
    border-radius: 5px;
    color: #81c784;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: .8px;
}

.replay-stat-grid {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 9px;
}

.replay-stat {
    padding: 12px 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    border: 1px solid #46515d;
    border-radius: 7px;
    background: #1a252f;
}

.replay-stat span {
    color: #919ca6;
    font-size: 7px;
    font-weight: 900;
    letter-spacing: .6px;
}

.replay-stat strong {
    color: #e5cc67;
    font-size: 18px;
}

.replay-deck-summary {
    margin-top: 18px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px;
}

.replay-deck-summary > div {
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    border: 1px solid #46515d;
    border-radius: 7px;
    background: #111820;
}

.replay-deck-summary span {
    color: #919ca6;
    font-size: 7px;
    font-weight: 900;
    letter-spacing: .6px;
}

.replay-deck-summary strong {
    color: #f4efe3;
    font-size: 13px;
}

.replay-deck-summary small {
    color: #8faee0;
    font-size: 9px;
}

.replay-event-preview {
    margin-top: 18px;
    padding: 13px;
    border: 1px solid #46515d;
    border-radius: 7px;
    background: #111820;
}


.replay-event-line {
    display: grid;
    grid-template-columns: 55px 135px minmax(0, 1fr);
    gap: 8px;
    padding: 7px 0;
    border-bottom: 1px solid #35414c;
    align-items: start;
}

.replay-event-turn,
.replay-event-type {
    min-width: 0;
    overflow-wrap: anywhere;
    line-height: 1.4;
}

.replay-event-message {
    min-width: 0;
    overflow-wrap: anywhere;
    color: #c8d0d8;
    font-size: 9px;
    line-height: 1.35;
}


.replay-event-turn {
    color: #8faee0;
    font-size: 9px;
    font-weight: bold;
}

.replay-event-type {
    color: #e5cc67;
    font-size: 8px;
    font-weight: 900;
    text-transform: uppercase;
}

.replay-event-message {
    min-width: 0;
    color: #c8d0d8;
    font-size: 9px;
    line-height: 1.35;
}

.replay-more {
    padding-top: 10px;
    color: #8d99a3;
    font-size: 9px;
    text-align: center;
}

.replay-ready-box {
    margin-top: 16px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border: 1px solid #4e8d61;
    border-left: 4px solid #81c784;
    border-radius: 6px;
