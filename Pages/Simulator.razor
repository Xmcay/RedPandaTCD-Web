    .simulation-controls {
        grid-template-columns: 1fr 1fr;
    }

    .simulator-header {
        align-items: stretch;
        flex-direction: column;
    }
}
</style>

@code {
    [Inject]
    private NavigationManager Navigation
    {
        get;
        set;
    } = default!;

    [SupplyParameterFromQuery(
        Name = "tutorial")]
    public bool PageTutorialRequested
    {
        get;
        set;
    }

    private bool showPageTutorial;

    private int pageTutorialStep;

    private int player1DeckIndex;

    private int player2DeckIndex =
        1;

    private SimulationResults? results;

    private List<BattleLogEntry> singleMatchLog =
        new();

    private static readonly IReadOnlyList<PageTutorialStep>
        SimulatorPageTutorialSteps =
        new List<PageTutorialStep>
        {
            new()
            {
                Title =
                    "Battle Simulator",

                Message =
                    "The Battle Simulator runs automated Bot-versus-Bot " +
                    "matches through the real game engine.",

                Target =
                    "simulator-page"
            },

            new()
            {
                Title =
                    "Bot 1 Deck",

                Message =
                    "Select the first deck. Its cards, order, and data " +
                    "structure affect how the first Bot plays.",

                Target =
                    "bot-one-deck"
            },

            new()
            {
                Title =
                    "Bot 2 Deck",

                Message =
                    "Select the opposing deck. Comparing different deck " +
                    "structures reveals matchup strengths and weaknesses.",

                Target =
                    "bot-two-deck"
            },

            new()
            {
                Title =
                    "Simulation Size",

                Message =
                    "Choose how many matches to run. One match provides a " +
                    "battle log, while larger batches provide more stable " +
                    "win-rate information.",

                Target =
                    "simulation-controls"
            },

            new()
            {
                Title =
                    "Simulation Results",

                Message =
                    "After a batch runs, Results reports completed matches, " +
                    "stalls, exceptions, wins, draws, and match length.",

                Target =
                    "simulator-page"
            },

            new()
            {
                Title =
                    "Win Rates and Match Length",

                Message =
                    "Use wins, draws, average turns, shortest match, and " +
                    "longest match to compare the selected decks. Larger " +
                    "batches reduce the effect of individual random outcomes.",

                Target =
                    "simulator-page"
            },

            new()
            {
                Title =
                    "Diagnostics",

                Message =
                    "Stalled matches and exceptions are recorded as " +
                    "diagnostics. A single-match run also includes its last " +
                    "battle log for closer inspection.",

                Target =
                    "simulator-page"
            },

            new()
            {
                Title =
                    "Simulator Tutorial Complete",

                Message =
                    "You now know how to select two decks, choose a batch " +
                    "size, run simulations, and interpret the results.",

                Target =
                    "simulator-page"
            }
        };

    protected override void OnInitialized()
    {
        DeckManager.InitializeDefaultDecks();

        showPageTutorial =
            PageTutorialRequested;

        pageTutorialStep =
            0;
    }

    private string GetPageTutorialClass(
        string target)
    {
        if (!showPageTutorial ||
            pageTutorialStep < 0 ||
            pageTutorialStep >=
                SimulatorPageTutorialSteps.Count)
        {
            return "";
        }

        PageTutorialStep step =
            SimulatorPageTutorialSteps[
                pageTutorialStep];

        return string.Equals(
            step.Target,
            target,
            StringComparison.OrdinalIgnoreCase)
                ? "page-tutorial-target"
                : "";
    }

    private Task SetPageTutorialStep(
        int step)
    {
        pageTutorialStep =
            step;

        return Task.CompletedTask;
    }

private void FinishPageTutorial()
{
    Session.Tutorial.SimulatorCompleted =
        true;

    showPageTutorial =
        false;

    Navigation.NavigateTo(
        "/tutorial");
}

    private void ExitPageTutorial()
    {
        showPageTutorial =
            false;

        Navigation.NavigateTo(
            "/tutorial");
    }

    private void RunSimulations(
        int matchCount)
    {
        results =
            new SimulationResults
            {
                RequestedMatches =
                    matchCount
            };

        singleMatchLog.Clear();

        if (DeckManager.Decks.Count < 2)
        {
            results.Exceptions++;

            results.Diagnostics.Add(
                "At least two decks are required.");

            return;
        }

        player1DeckIndex =
            Math.Clamp(
                player1DeckIndex,
                0,
                DeckManager.Decks.Count - 1);

        player2DeckIndex =
            Math.Clamp(
                player2DeckIndex,
                0,
                DeckManager.Decks.Count - 1);

        for (int matchNumber = 1;
             matchNumber <= matchCount;
             matchNumber++)
        {
            try
            {
                RunSingleSimulation(
                    matchNumber,
                    matchCount);
            }
            catch (Exception exception)
            {
                results.Exceptions++;

                if (results.Diagnostics.Count < 20)
                {
                    results.Diagnostics.Add(
                        $"Match {matchNumber}: " +
                        exception.Message);
                }
            }
        }

        if (results.CompletedMatches > 0)
        {
            results.AverageTurns =
                (double)results.TotalTurns /
                results.CompletedMatches;
        }
    }

private void RunSingleSimulation(
    int matchNumber,
    int requestedMatches)
{
    Deck player1Deck =
        DeckManager.Decks[
            player1DeckIndex];

    Deck player2Deck =
        DeckManager.Decks[
            player2DeckIndex];

    Player bot1 =
        new Player
        {
            Name =
                "Bot 1",

            IsBot =
                true,

            Deck =
                DeckCloner.Clone(
                    player1Deck)
        };

    Player bot2 =
        new Player
        {
            Name =
                "Bot 2",

            IsBot =
                true,

            Deck =
                DeckCloner.Clone(
                    player2Deck)
        };

    MatchState match =
        BattleEngine.StartMatch(
            bot1,
            bot2,
            GameMode.BotMatch);

    int simulationSteps =
        0;

    const int maxSimulationSteps =
        1000;

    string? stopReason =
        null;

    while (!MatchManager.IsMatchOver(
               match.Player1,
               match.Player2) &&
           simulationSteps <
               maxSimulationSteps)
    {
        bool progressed =
            PhaseManager
                .RunBotPhaseIfNeeded(
                    match);

        if (!progressed)
        {
            stopReason =
                "RunBotPhaseIfNeeded returned false " +
                "before the match was terminal.";

            break;
        }

        simulationSteps++;
    }

    /*
        The match never reached a terminal state.
        This is an actual Simulator stall candidate.
    */
    if (!MatchManager.IsMatchOver(
            match.Player1,
            match.Player2))
    {
        results!.StalledMatches++;

        if (results.Diagnostics.Count < 20)
        {
            string reason =
                stopReason ??
                $"Reached the " +
                $"{maxSimulationSteps}-step " +
                $"Simulator safety limit.";

            Player actingPlayer =
    match.GetActingPlayer();

results.Diagnostics.Add(
    $"STALL | " +
    $"Match={matchNumber} | " +
    $"Reason={reason} | " +
    $"SimulationSteps={simulationSteps} | " +
    $"EngineTurn={match.TurnNumber} | " +
    $"Phase={match.CurrentPhase} | " +
    $"Acting={actingPlayer.Name} | " +
    $"Bot1Energy={match.Player1.Energy} | " +
    $"Bot2Energy={match.Player2.Energy} | " +
    $"Bot1Deck=" +
    $"{match.Player1.Deck.RuntimeStorage?.Count ?? 0} | " +
    $"Bot2Deck=" +
    $"{match.Player2.Deck.RuntimeStorage?.Count ?? 0}");

        }

        if (requestedMatches == 1)
        {
            singleMatchLog =
                BattleLog
                    .GetPhaseActions()
                    .ToList();
        }

        return;
    }

    /*
        Determine whether the terminal state is a draw
        before interpreting a null winner as abnormal.
    */
    bool isDraw =
        MatchManager.IsDraw(
            match.Player1,
            match.Player2);

    Player? winner =
        BattleEngine.CompleteMatch(
            match);

    if (isDraw ||
        match.IsDraw)
    {
        RecordCompletedMatch(
            match);

        results!.Draws++;

        if (requestedMatches == 1)
        {
            singleMatchLog =
                BattleLog
                    .GetPhaseActions()
                    .ToList();
        }

        return;
    }

    /*
        Terminal plus not a draw plus no winner is
        genuinely unexpected and remains visible.
    */
    if (winner == null)
    {
        results!.StalledMatches++;

        if (results.Diagnostics.Count < 20)
        {
            results.Diagnostics.Add(
                $"Match {matchNumber}: " +
                $"terminal state returned no winner " +
                $"and was not a draw. " +
                $"Turn={match.TurnNumber}, " +
                $"Phase={match.CurrentPhase}, " +
                $"Bot1Energy={match.Player1.Energy}, " +
                $"Bot2Energy={match.Player2.Energy}, " +
                $"Bot1Surrendered=" +
                $"{match.Player1.HasSurrendered}, " +
                $"Bot2Surrendered=" +
                $"{match.Player2.HasSurrendered}.");
        }

        if (requestedMatches == 1)
        {
            singleMatchLog =
                BattleLog
                    .GetPhaseActions()
                    .ToList();
        }

        return;
    }

    RecordCompletedMatch(
        match);

    if (winner ==
        match.Player1)
    {
        results!.Player1Wins++;
    }
    else if (winner ==
             match.Player2)
    {
        results!.Player2Wins++;
    }

    if (requestedMatches == 1)
    {
        singleMatchLog =
            BattleLog
                .GetPhaseActions()
                .ToList();
    }
}

    private static void RunSimulatorUtilityPhase(
        Player actingPlayer,
        Player opponent)
    {
        int safety =
            0;

        while (actingPlayer.UtilityActionsRemaining > 0 &&
               safety < 10)
        {
            int before =
                actingPlayer.UtilityActionsRemaining;

            BotManager.RunNextUtilityAction(
                actingPlayer,
                opponent);

            safety++;

            if (actingPlayer.UtilityActionsRemaining >=
                before)
            {
                break;
            }
        }
    }

    private static void RunSimulatorPlacementPhase(
        Player actingPlayer)
    {
        if (actingPlayer.Deck.Structure ==
            DeckStructure.Stack)
        {
            PlacementManager.AutoStackPlacement(
                actingPlayer);

            return;
        }

        for (int step = 0;
             step <= 4;
             step++)
        {
            BotManager.RunNextPlacementAction(
                actingPlayer,
                step);
        }
    }

    private static void RunSimulatorAttackPhase(
        Player actingPlayer,
        Player opponent)
    {
        for (int step = 0;
             step <= 2;
             step++)
        {
            if (MatchManager.IsMatchOver(
                    actingPlayer,
                    opponent))
            {
                return;
            }

            BotManager.RunNextAttackAction(
                actingPlayer,
                opponent,
                step);
        }
    }

    private void RecordCompletedMatch(
        MatchState match)
    {
        if (results == null)
        {
            return;
        }

        results.CompletedMatches++;

        results.TotalTurns +=
            match.TurnNumber;

        if (results.ShortestMatch == 0 ||
            match.TurnNumber <
                results.ShortestMatch)
        {
            results.ShortestMatch =
                match.TurnNumber;
        }

        if (match.TurnNumber >
            results.LongestMatch)
        {
            results.LongestMatch =
                match.TurnNumber;
        }

        if (match.IsDraw)
        {
            results.Draws++;
            return;
        }

        Player? winner =
            MatchManager.GetWinner(
                match.Player1,
                match.Player2);

        if (winner == match.Player1)
        {
            results.Player1Wins++;
        }
        else if (winner == match.Player2)
        {
            results.Player2Wins++;
        }
        else
        {
            results.Draws++;
        }
    }

    private static string GetStructureName(
        DeckStructure structure)
    {
        return structure switch
        {
            DeckStructure.Queue =>
                "Queue",

            DeckStructure.Stack =>
                "Stack",

            DeckStructure.PriorityQueue =>
                "Priority Queue",

            DeckStructure.RandomList =>
                "Random List",

            DeckStructure.LinkedList =>
                "Linked List",

            _ =>
                structure.ToString()
        };
    }

    private void GoHome()
    {
        Navigation.NavigateTo(
            "/");
    }

    private sealed class SimulationResults
    {
        public int RequestedMatches
        {
            get;
            set;
        }

        public int CompletedMatches
        {
            get;
            set;
        }

