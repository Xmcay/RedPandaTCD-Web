@code {

    private enum SimulatorMode
    {
        BotFighter,
        Replay
    }

    private SimulatorMode activeMode =
        SimulatorMode.BotFighter;

    private bool isRunning;

    private bool copyMessageVisible;

    private string replayInput = "";

    private string replayError = "";

    private bool replayLoaded;

    private List<BattleLogEntry> replayEvents =
        new();

    [Inject]
    private NavigationManager Navigation
    {
        get;
        set;
    } = default!;

    [SupplyParameterFromQuery(
        Name = "tutorial")]
    public bool PageTutorialRequested
    {
        get;
        set;
    }

    private bool showPageTutorial;

    private int pageTutorialStep;

    private int player1DeckIndex;

    private int player2DeckIndex =
        1;

    private SimulationResults? results;

    private List<BattleLogEntry> singleMatchLog =
        new();

    private static readonly IReadOnlyList<PageTutorialStep>
        SimulatorPageTutorialSteps =
        new List<PageTutorialStep>
        {
            new()
            {
                Title =
                    "Battle Simulator",

                Message =
                    "The Battle Simulator runs automated Bot-versus-Bot " +
                    "matches through the real game engine.",

                Target =
                    "simulator-page"
            },

            new()
            {
                Title =
                    "Bot 1 Deck",

                Message =
                    "Select the first deck. Its cards, order, and data " +
                    "structure affect how the first Bot plays.",

                Target =
                    "bot-one-deck"
            },

            new()
            {
                Title =
                    "Bot 2 Deck",

                Message =
                    "Select the opposing deck. Comparing different deck " +
                    "structures reveals matchup strengths and weaknesses.",

                Target =
                    "bot-two-deck"
            },

            new()
            {
                Title =
                    "Simulation Size",

                Message =
                    "Choose how many matches to run. One match provides a " +
                    "battle log, while larger batches provide more stable " +
                    "win-rate information.",

                Target =
                    "simulation-controls"
            },

            new()
            {
                Title =
                    "Simulation Results",

                Message =
                    "Results reports completed matches, stalls, exceptions, " +
                    "wins, draws, and match length.",

                Target =
                    "simulation-results"
            },

            new()
            {
                Title =
                    "Battle Log / Replay",

                Message =
                    "The Battle Log can be copied as structured replay data. " +
                    "Switch to Battle Log / Replay to load that data later " +
                    "without relying on the visible log text.",

                Target =
                    "simulator-page"
            }
        };

    protected override void OnInitialized()
    {
        DeckManager.InitializeDefaultDecks();

        showPageTutorial =
            PageTutorialRequested;

        pageTutorialStep =
            0;
    }

    private void SetMode(
        SimulatorMode mode)
    {
        activeMode =
            mode;

        replayError =
            "";

        copyMessageVisible =
            false;
    }

    private string GetPageTutorialClass(
        string target)
    {
        if (!showPageTutorial ||
            pageTutorialStep < 0 ||
            pageTutorialStep >=
                SimulatorPageTutorialSteps.Count)
        {
            return "";
        }

        PageTutorialStep step =
            SimulatorPageTutorialSteps[
                pageTutorialStep];

        return string.Equals(
            step.Target,
            target,
            StringComparison.OrdinalIgnoreCase)
                ? "page-tutorial-target"
                : "";
    }

    private Task SetPageTutorialStep(
        int step)
    {
        pageTutorialStep =
            step;

        return Task.CompletedTask;
    }

    private void FinishPageTutorial()
    {
        Session.Tutorial.SimulatorCompleted =
            true;

        showPageTutorial =
            false;

        Navigation.NavigateTo(
            "/tutorial");
    }

    private void ExitPageTutorial()
    {
        showPageTutorial =
            false;

        Navigation.NavigateTo(
            "/tutorial");
    }

    private async Task RunSimulations(
        int matchCount)
    {
        if (isRunning)
        {
            return;
        }

        isRunning =
            true;

        results =
            new SimulationResults
            {
                RequestedMatches =
                    matchCount
            };

        singleMatchLog.Clear();

        copyMessageVisible =
            false;

        try
        {
            if (DeckManager.Decks.Count < 2)
            {
                results.Exceptions++;

                results.Diagnostics.Add(
                    "At least two decks are required.");

                return;
            }

            player1DeckIndex =
                Math.Clamp(
                    player1DeckIndex,
                    0,
                    DeckManager.Decks.Count - 1);

            player2DeckIndex =
                Math.Clamp(
                    player2DeckIndex,
                    0,
                    DeckManager.Decks.Count - 1);

            for (int matchNumber = 1;
                 matchNumber <= matchCount;
                 matchNumber++)
            {
                try
                {
                    RunSingleSimulation(
                        matchNumber,
                        matchCount);
                }
                catch (Exception exception)
                {
                    results.Exceptions++;

                    if (results.Diagnostics.Count < 20)
                    {
                        results.Diagnostics.Add(
                            $"Match {matchNumber}: " +
                            exception.Message);
                    }
                }

                await Task.Yield();
            }

            if (results.CompletedMatches > 0)
            {
                results.AverageTurns =
                    (double)results.TotalTurns /
                    results.CompletedMatches;
            }
        }
        finally
        {
            isRunning =
                false;
        }
    }

    private void RunSingleSimulation(
        int matchNumber,
        int requestedMatches)
    {
        Deck player1Deck =
            DeckManager.Decks[
                player1DeckIndex];

        Deck player2Deck =
            DeckManager.Decks[
                player2DeckIndex];

        Player bot1 =
            new Player
            {
                Name =
                    "Bot 1",

                IsBot =
                    true,

                Deck =
                    DeckCloner.Clone(
                        player1Deck)
            };

        Player bot2 =
            new Player
            {
                Name =
                    "Bot 2",

                IsBot =
                    true,

                Deck =
                    DeckCloner.Clone(
                        player2Deck)
            };

        MatchState match =
            BattleEngine.StartMatch(
                bot1,
                bot2,
                GameMode.BotMatch);

        int simulationSteps =
            0;

        const int maxSimulationSteps =
            1000;

        string? stopReason =
            null;

        while (!MatchManager.IsMatchOver(
                   match.Player1,
                   match.Player2) &&
               simulationSteps <
                   maxSimulationSteps)
        {
            bool progressed =
                PhaseManager
                    .RunBotPhaseIfNeeded(
                        match);

            if (!progressed)
            {
                stopReason =
                    "RunBotPhaseIfNeeded returned false " +
                    "before the match was terminal.";

                break;
            }

            simulationSteps++;
        }

        if (!MatchManager.IsMatchOver(
                match.Player1,
                match.Player2))
        {
            results!.StalledMatches++;

            if (results.Diagnostics.Count < 20)
            {
                string reason =
                    stopReason ??
                    $"Reached the " +
                    $"{maxSimulationSteps}-step " +
                    $"Simulator safety limit.";

                Player actingPlayer =
                    match.GetActingPlayer();

                results.Diagnostics.Add(
                    $"STALL | " +
                    $"Match={matchNumber} | " +
                    $"Reason={reason} | " +
                    $"SimulationSteps={simulationSteps} | " +
                    $"EngineTurn={match.TurnNumber} | " +
                    $"Phase={match.CurrentPhase} | " +
                    $"Acting={actingPlayer.Name} | " +
                    $"Bot1Energy={match.Player1.Energy} | " +
                    $"Bot2Energy={match.Player2.Energy} | " +
                    $"Bot1Deck=" +
                    $"{match.Player1.Deck.RuntimeStorage?.Count ?? 0} | " +
                    $"Bot2Deck=" +
                    $"{match.Player2.Deck.RuntimeStorage?.Count ?? 0}");
            }

            if (requestedMatches == 1)
            {
                singleMatchLog =
                    BattleLog
                        .GetPhaseActions()
                        .ToList();
            }

            return;
        }

        BattleEngine.CompleteMatch(
            match);

        RecordCompletedMatch(
            match);

        if (requestedMatches == 1)
        {
            singleMatchLog =
                BattleLog
                    .GetPhaseActions()
                    .ToList();
        }
    }

    private void RecordCompletedMatch(
        MatchState match)
    {
        if (results == null)
        {
            return;
        }

        results.CompletedMatches++;

        results.TotalTurns +=
            match.TurnNumber;

        if (results.ShortestMatch == 0 ||
            match.TurnNumber <
                results.ShortestMatch)
        {
            results.ShortestMatch =
                match.TurnNumber;
        }

        if (match.TurnNumber >
            results.LongestMatch)
        {
            results.LongestMatch =
                match.TurnNumber;
        }

        if (match.IsDraw ||
            MatchManager.IsDraw(
                match.Player1,
                match.Player2))
        {
            results.Draws++;
            return;
        }

        Player? winner =
            MatchManager.GetWinner(
                match.Player1,
                match.Player2);

        if (winner == match.Player1)
        {
            results.Player1Wins++;
        }
        else if (winner == match.Player2)
        {
            results.Player2Wins++;
        }
        else
        {
            results.Draws++;
        }
    }

    private async Task CopyReplay()
    {
        try
        {
            string replay =
                BattleLog.ExportReplay();

            await JS.InvokeVoidAsync(
                "navigator.clipboard.writeText",
                replay);

            copyMessageVisible =
                true;
        }
        catch
        {
            copyMessageVisible =
                false;
        }
    }

    private void LoadReplay()
    {
        replayError =
            "";

        replayEvents.Clear();

        replayLoaded =
            false;

        if (string.IsNullOrWhiteSpace(
                replayInput))
        {
            replayError =
                "Paste Battle Log replay data first.";

            return;
        }

        try
        {
            List<BattleLogEntry> imported =
                BattleLog.ImportReplay(
                    replayInput);

            replayEvents =
                imported
                    .Where(entry =>
                        entry.TurnNumber > 0 ||
                        entry.EventType ==
                            BattleLogEventType.MatchStart ||
                        entry.EventType ==
                            BattleLogEventType.MatchEnd)
                    .ToList();

            if (replayEvents.Count == 0)
            {
                replayError =
                    "The replay was imported, but " +
                    "no replay events were found.";

                return;
            }

            replayLoaded =
                true;
        }
        catch (Exception exception)
        {
            replayError =
                $"Could not load replay: " +
                exception.Message;
        }
    }

    private void ClearReplay()
    {
        replayInput =
            "";

        replayError =
            "";

        replayEvents.Clear();

        replayLoaded =
            false;
    }

    private int GetReplayTurnCount()
    {
        return replayEvents
            .Where(entry =>
                entry.TurnNumber > 0)
            .Select(entry =>
                entry.TurnNumber)
            .DefaultIfEmpty()
            .Max();
    }

    private int GetReplayEventCount(
        BattleLogEventType eventType)
    {
        return replayEvents.Count(
            entry =>
                entry.EventType ==
                eventType);
    }

    private static string GetReplayLabel(
        BattleLogEntry entry)
    {
        if (entry.TurnNumber > 0 &&
            entry.PlayerIndex > 0)
        {
            return
                $"T{entry.TurnNumber} P{entry.PlayerIndex}";
        }

        return entry.Label
            .ToUpperInvariant();
    }

    private static string GetStructureName(
        DeckStructure structure)
    {
        return structure switch
        {
            DeckStructure.Queue =>
                "Queue",

            DeckStructure.Stack =>
                "Stack",

            DeckStructure.PriorityQueue =>
                "Priority Queue",

            DeckStructure.RandomList =>
                "Random List",

            DeckStructure.LinkedList =>
                "Linked List",

            _ =>
                structure.ToString()
        };
    }

