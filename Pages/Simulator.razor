    color: #e5cc67;
    font-size: 14px;
}

.diagnostic-entry {
    margin-bottom: 6px;
    padding: 7px 8px;
    border-left: 3px solid #ef9a9a;
    background: rgba(255, 255, 255, .04);
    color: #c8d0d8;
    font-size: 10px;
    line-height: 1.4;
}

.log-line {
    margin-bottom: 5px;
    padding: 6px 7px;
    border-bottom: 1px solid #35414c;
    color: #c8d0d8;
    font-size: 10px;
    line-height: 1.4;
}

.log-line strong {
    margin-right: 5px;
    color: #e5cc67;
}

.page-tutorial-target {
    position: relative;
    z-index: 8995;
    outline: 4px solid #ffe078;
    outline-offset: 5px;
    border-radius: 8px;
    box-shadow:
        0 0 0 3px rgba(0, 0, 0, .5),
        0 0 20px rgba(255, 224, 120, .72),
        0 0 42px rgba(229, 204, 103, .4);
    animation:
        pageTutorialTargetPulse
        1s
        ease-in-out
        infinite alternate;
}

@@keyframes pageTutorialTargetPulse {
    from {
        outline-color:
            rgba(255, 224, 120, .65);

        box-shadow:
            0 0 0 3px rgba(0, 0, 0, .45),
            0 0 10px rgba(255, 224, 120, .4);
    }

    to {
        outline-color:
            #ffe078;

        box-shadow:
            0 0 0 3px rgba(0, 0, 0, .55),
            0 0 24px rgba(255, 224, 120, .85),
            0 0 48px rgba(229, 204, 103, .45);
    }
}

@@media (max-width: 700px) {
    .deck-grid,
    .result-grid {
        grid-template-columns: 1fr;
