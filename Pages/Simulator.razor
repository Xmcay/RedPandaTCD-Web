    font-size: 19px;
}

.result-card.success {
    border-color: #4e8d61;
}

.result-card.success strong {
    color: #81c784;
}

.result-card.danger {
    border-color: #985a5a;
}

.result-card.danger strong {
    color: #ef9a9a;
}

.result-card.bot-one {
    border-color: #5689d6;
}

.result-card.bot-one strong {
    color: #8faee0;
}

.result-card.bot-two {
