    border: 1px solid #596674;
    border-radius: 10px;
    background: rgba(17, 24, 32, .93);
}

.results h2 {
    margin: 0 0 16px;
    color: #f4efe3;
}

.result-grid {
    display: grid;
    grid-template-columns:
        repeat(5, minmax(0, 1fr));
