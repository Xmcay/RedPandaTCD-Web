    private void LoadReplay()
    {
        replayError =
            "";

        replayLoaded =
            false;

        replayEvents.Clear();

        if (string.IsNullOrWhiteSpace(
                replayInput))
        {
            replayError =
                "Paste a replay before loading it.";

            return;
        }

        List<BattleLogEntry> imported =
            BattleLog.ImportReplay(
                replayInput);

        if (imported.Count == 0)
        {
            replayError =
                "The replay could not be loaded. " +
                "Make sure it starts with REDPANDA_REPLAY_V1 " +
                "and contains valid replay events.";

            return;
        }

        if (DeckManager.Decks.Count < 2)
        {
            replayError =
                "At least two decks are required " +
                "to load a replay.";

            return;
        }

        replayPlayer1DeckIndex =
            Math.Clamp(
                replayPlayer1DeckIndex,
                0,
                DeckManager.Decks.Count - 1);

        replayPlayer2DeckIndex =
            Math.Clamp(
                replayPlayer2DeckIndex,
                0,
                DeckManager.Decks.Count - 1);

        Deck selectedPlayer1Deck =
            DeckManager.Decks[
                replayPlayer1DeckIndex];

        Deck selectedPlayer2Deck =
            DeckManager.Decks[
                replayPlayer2DeckIndex];

        string? recordedPlayer1Fingerprint =
            GetRecordedDeckFingerprint(
                replayInput,
                1);

        string? recordedPlayer2Fingerprint =
            GetRecordedDeckFingerprint(
                replayInput,
                2);

        if (string.IsNullOrWhiteSpace(
                recordedPlayer1Fingerprint) ||
            string.IsNullOrWhiteSpace(
                recordedPlayer2Fingerprint))
        {
            replayError =
                "This replay does not contain complete deck identity " +
                "metadata. Copy a new replay using the current " +
                "Copy Replay button.";

            return;
        }

        string selectedPlayer1Fingerprint =
            BattleLog.CreateDeckFingerprint(
                selectedPlayer1Deck);

        string selectedPlayer2Fingerprint =
            BattleLog.CreateDeckFingerprint(
                selectedPlayer2Deck);

        if (!string.Equals(
                recordedPlayer1Fingerprint,
                selectedPlayer1Fingerprint,
                StringComparison.OrdinalIgnoreCase))
        {
            replayError =
                $"Replay mismatch: Player 1 is not using the exact " +
                $"deck recorded in this replay. " +
                $"Recorded deck: {GetRecordedDeckName(replayInput, 1)}. " +
                $"Selected deck: {selectedPlayer1Deck.Name}.";

            return;
        }

        if (!string.Equals(
                recordedPlayer2Fingerprint,
                selectedPlayer2Fingerprint,
                StringComparison.OrdinalIgnoreCase))
        {
            replayError =
                $"Replay mismatch: Player 2 is not using the exact " +
                $"deck recorded in this replay. " +
                $"Recorded deck: {GetRecordedDeckName(replayInput, 2)}. " +
                $"Selected deck: {selectedPlayer2Deck.Name}.";

            return;
        }

        DeckStructure? player1Structure =
            GetRecordedDeckStructure(
                imported,
                1);

        DeckStructure? player2Structure =
            GetRecordedDeckStructure(
                imported,
                2);

        if (player1Structure.HasValue &&
            player1Structure.Value !=
                selectedPlayer1Deck.Structure)
        {
            replayError =
                $"Replay mismatch: Player 1 recorded deck structure is " +
                $"{GetStructureName(player1Structure.Value)}, but the " +
                $"selected deck uses " +
                $"{GetStructureName(selectedPlayer1Deck.Structure)}.";

            return;
        }

        if (player2Structure.HasValue &&
            player2Structure.Value !=
                selectedPlayer2Deck.Structure)
        {
            replayError =
                $"Replay mismatch: Player 2 recorded deck structure is " +
                $"{GetStructureName(player2Structure.Value)}, but the " +
                $"selected deck uses " +
                $"{GetStructureName(selectedPlayer2Deck.Structure)}.";

            return;
        }

        replayEvents =
            imported;

        replayLoaded =
            true;
    }

    private static string? GetRecordedDeckFingerprint(
        string replay,
        int playerIndex)
    {
        string prefix =
            $"DECK|{playerIndex}|";

        string? line =
            replay
                .Split(
                    new[] { '\r', '\n' },
                    StringSplitOptions.RemoveEmptyEntries)
                .FirstOrDefault(
                    value =>
                        value.StartsWith(
                            prefix,
                            StringComparison.Ordinal));

        if (line == null)
        {
            return null;
        }

        string[] parts =
            line.Split(
                '|');

        if (parts.Length < 5)
        {
            return null;
        }

        return parts[4];
    }

    private static string GetRecordedDeckName(
        string replay,
        int playerIndex)
    {
        string prefix =
            $"DECK|{playerIndex}|";

        string? line =
            replay
                .Split(
                    new[] { '\r', '\n' },
                    StringSplitOptions.RemoveEmptyEntries)
                .FirstOrDefault(
                    value =>
                        value.StartsWith(
                            prefix,
                            StringComparison.Ordinal));

        if (line == null)
        {
            return "Unknown deck";
        }

        string[] parts =
            line.Split(
                '|');

        if (parts.Length < 3)
        {
            return "Unknown deck";
        }

        return parts[2];
    }

    private static DeckStructure? GetRecordedDeckStructure(
        IEnumerable<BattleLogEntry> events,
        int playerIndex)
    {
        return events
            .Where(entry =>
                entry.PlayerIndex ==
                playerIndex &&
                entry.DeckStructure.HasValue)
            .Select(entry =>
                entry.DeckStructure)
            .FirstOrDefault();
    }

    private void OpenReplayInBattle()
    {
        if (!replayLoaded ||
            replayEvents.Count == 0)
        {
            return;
        }

        Session.PendingReplay =
            replayInput;

        Navigation.NavigateTo(
            $"/battle?replay=true" +
            $"&p1Deck={replayPlayer1DeckIndex}" +
            $"&p2Deck={replayPlayer2DeckIndex}");
    }

    private void ClearReplay()
    {
        replayInput =
            "";

        replayError =
            "";

        replayLoaded =
            false;

        replayEvents.Clear();
    }

    private int GetReplayTurnCount()
    {
        return replayEvents
            .Where(entry =>
                entry.TurnNumber > 0)
            .Select(entry =>
                entry.TurnNumber)
            .Distinct()
            .Count();
    }

    private int GetReplayEventCount(
        BattleLogEventType eventType)
    {
        return replayEvents
            .Count(entry =>
                entry.EventType ==
                eventType);
    }

    private int GetVisibleReplayEventCount()
    {
        return replayEvents
            .Count(entry =>
                entry.ShowInLog);
    }

    private string GetReplayDeckName(
        int index)
    {
        if (DeckManager.Decks.Count == 0)
        {
            return "No deck";
        }

        index =
            Math.Clamp(
                index,
                0,
                DeckManager.Decks.Count - 1);

        return DeckManager.Decks[index].Name;
    }

    private async Task CopyLastReplay()
    {
        if (singleMatchLog.Count == 0)
        {
            return;
        }

        string replay =
            BattleLog.ExportReplay();

        await JS.InvokeVoidAsync(
            "navigator.clipboard.writeText",
            replay);

        replayCopied =
            true;

        await InvokeAsync(
            StateHasChanged);

        await Task.Delay(1200);

        replayCopied =
            false;

        await InvokeAsync(
            StateHasChanged);
    }

    // ==========================
    // HELPERS
    // ==========================

    private static string GetStructureName(
        DeckStructure structure)
    {
        return structure switch
        {
            DeckStructure.Queue =>
                "Queue",

            DeckStructure.Stack =>
                "Stack",

            DeckStructure.PriorityQueue =>
                "Priority Queue",

            DeckStructure.RandomList =>
                "Random List",

            DeckStructure.LinkedList =>
                "Linked List",

            _ =>
                structure.ToString()
        };
    }

    private void GoHome()
    {
        Navigation.NavigateTo(
            "/");
    }

